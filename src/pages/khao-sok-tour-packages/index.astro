---
// Verbatim Authentic Copy, Exact Nomenclature & Embedded Media
import PageLayout from '../../layouts/PageLayout.astro';
import PackagesBentoGrid from '../../components/PackagesBentoGrid.astro';
import GoogleReviewsWidget from '../../components/GoogleReviewsWidget.astro';
---

<PageLayout
  title="Khao Sok Tour Packages"
  description="A Khao Sok tour will immerse you in the beauty of the jungle. Khao Sok national park tours and excursions create memories to last a lifetime."
  heroImage="/wp-content/uploads/2025/01/Grand-Jungle-Cover.jpg"
  heroTitle="Khao Sok Tour Packages"
  heroSubtitle="Curated Rainforest Adventures & Park Excursions"
  breadcrumbs={[{"label": "Khao Sok Tour Packages", "href": "/khao-sok-tour-packages/"}]}
>
  <article class="max-w-7xl mx-auto space-y-12">
    <!-- Top Editorial Intro Card -->
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>TOUR EXPEDITIONS</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-5 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">
        <p class="leading-relaxed">
          Our Khao Sok tour packages help you to get the most from your visit and at the guaranteed lowest price! Whether you're traveling solo, with your family, or on a romantic escape, we have the perfect Khao Sok national park excursion for you. From a quick 1 night trip to longer visits, our Khao Sok National Park tours connect you to the pristine jungle and the wonders of the lake.
        </p>

        <p class="leading-relaxed">
          Spend the day trekking in the jungle, or head out to spend the night at the floating bungalows! Our Khao Sok tours include breakfast and excellent service from our friendly, English-speaking staff. From arranging exciting activities to answering any questions you may have, we've got you covered.
        </p>
      </div>
    </div>

    <!-- 2026 Elite Bento Grid of the 5 Authentic Packages -->
    <PackagesBentoGrid showTitle={true} />

    <!-- Google Reviews Verified Widget -->
    <GoogleReviewsWidget />

    <!-- Action Footer -->
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 shadow-xl flex flex-wrap gap-4 items-center justify-between">
      <div class="text-xs text-[#2e5339] space-y-1">
        <div><strong>Need help choosing?</strong> We're here to help:</div>
        <div class="font-mono text-[11px] text-[#8a6b25]">✉️ info@khao-sok-riverside-cottages.com · 📞 +66 77 395 159</div>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/booking-khao-sok-accommodation/?tab=package" class="px-6 py-3.5 bg-[#ba9038] hover:bg-[#d8b257] text-[#12281b] font-semibold rounded-xl text-xs font-mono uppercase tracking-wider transition-all shadow-md">
          Book a Tour Package
        </a>
        <a href="/contact-khao-sok-riverside-cottages/" class="px-6 py-3.5 bg-[#12281b] hover:bg-[#1c3d24] text-white font-semibold rounded-xl text-xs font-mono uppercase tracking-wider transition-all">
          Contact Concierge
        </a>
      </div>
    </div>
  </article>
</PageLayout>
