---
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
import PageLayout from '../../layouts/PageLayout.astro';
import GoogleReviewsWidget from '../../components/GoogleReviewsWidget.astro';
---

<PageLayout
  title="Khao Sok Tour Packages"
  description="A Khao Sok tour will immerse you in the beauty of the jungle. Khao Sok national park tours and excursions create memories to last a lifetime."
  heroImage="/wp-content/uploads/2017/03/GrandAdventure_Package_Tours_Lake_MG_7674.jpg"
  heroTitle="Khao Sok Tour Packages"
  heroSubtitle="Curated Rainforest Adventures & Park Excursions"
  breadcrumbs={[{"label": "Khao Sok Tour Packages", "href": "/khao-sok-tour-packages/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <p class="mb-5 leading-relaxed text-[#223e2c]">
          <strong>Our Khao Sok tour packages</strong> help you to get the most from your visit and at the guaranteed lowest price! Whether you're traveling solo, with your family, or on a romantic escape, we have the perfect Khao Sok national park excursion for you. From a quick 1 night trip to longer visits, our Khao Sok National Park tours connect you to the pristine jungle and the wonders of the lake.
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Spend the day trekking in the jungle, or head out to spend the night at the floating bungalows! Our Khao Sok tours include breakfast and excellent service from our friendly, English-speaking staff. From arranging exciting activities to answering any questions you may have, we've got you covered.
        </p>
        <h2 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Book your Khao Sok Tours Here</span>
        </h2>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          There is a limited supply of raft houses. Book a package in advance to avoid disappointment.
        </p>
        <figure class="my-10 rounded-2xl overflow-hidden shadow-xl border border-[#12281b]/10 bg-white/50">
          <img
            src="/wp-content/uploads/2025/01/Grand-Jungle-Cover.jpg"
            alt="Khao Sok Tour"
            class="w-full h-52 sm:h-72 md:h-80 object-cover object-center"
            loading="lazy"
            decoding="async"
           width="1200" height="800" />
          <figcaption class="p-3.5 text-xs text-[#255038] font-serif italic border-t border-[#12281b]/10 bg-[#f4efeb]/60">Khao Sok Tour</figcaption>
        </figure>
        <h3 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Grand Jungle Tour Jungle Tour with Lake Overnight</span>
        </h3>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          4 Day, 3 Night Package<br /> from ฿7,100 Baht per person
        </p>
        <ul class="space-y-3 my-6 pl-2">
          <li class="flex items-start gap-3 text-[#223e2c] text-base leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813]/70 mt-2.5 flex-shrink-0"></span>
            <span>2 nights at Riverside Cottages</span>
          </li>
          <li class="flex items-start gap-3 text-[#223e2c] text-base leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813]/70 mt-2.5 flex-shrink-0"></span>
            <span>1 night at Cheow Larn Lake</span>
          </li>
          <li class="flex items-start gap-3 text-[#223e2c] text-base leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813]/70 mt-2.5 flex-shrink-0"></span>
            <span>Includes guided lake tour with wildlife safari</span>
          </li>
          <li class="flex items-start gap-3 text-[#223e2c] text-base leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813]/70 mt-2.5 flex-shrink-0"></span>
            <span>Choose from canoeing or tubing, night safari or massage, half-day hike or hot springs</span>
          </li>
        </ul>
        <figure class="my-10 rounded-2xl overflow-hidden shadow-xl border border-[#12281b]/10 bg-white/50">
          <img
            src="/wp-content/uploads/2025/01/Riverside-Rafthouse-Cover.jpg"
            alt="Khao Sok National Park Tours"
            class="w-full h-52 sm:h-72 md:h-80 object-cover object-center"
            loading="lazy"
            decoding="async"
           width="1200" height="800" />
          <figcaption class="p-3.5 text-xs text-[#255038] font-serif italic border-t border-[#12281b]/10 bg-[#f4efeb]/60">Khao Sok National Park Tours</figcaption>
        </figure>
        <h3 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Riverside & Rafthouse with Lake Overnight</span>
        </h3>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          3 Day, 2 Night Tour Khao Sok<br /> from ฿5,400 per person
        </p>
        <ul class="space-y-3 my-6 pl-2">
          <li class="flex items-start gap-3 text-[#223e2c] text-base leading-relaxed">
