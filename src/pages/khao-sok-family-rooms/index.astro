---
// Khao Sok Family Rooms & Cottages — Dedicated Showcase
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
  title="Khao Sok Family Rooms & Wooden Cottages"
  description="Spacious family accommodation in Khao Sok. Handcrafted wooden cottages sleeping up to 4 guests with private balconies, air-con, and tranquil rainforest views."
  heroImage="/wp-content/uploads/2025/07/family-cottage-1.jpg"
  heroTitle="Khao Sok Family Rooms"
  heroSubtitle="Spacious Handcrafted Wooden Cottages for Families & Groups"
  breadcrumbs={[{"label": "Accommodation", "href": "/khao-sok-accommodation/"}, {"label": "Family Rooms", "href": "/khao-sok-family-rooms/"}]}
>
  <article class="max-w-5xl mx-auto space-y-12">
    <!-- Top Editorial Card -->
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-sans text-[11px] tracking-[0.2em] font-medium uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>ACCOMMODATION</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">
        <h2 class="font-display text-2xl sm:text-3xl text-[#12281b] font-bold tracking-tight">
          Handcrafted Wooden Cottages Built for Families
        </h2>

        <p class="leading-relaxed">
          Designed specifically for parents traveling with children or small groups of friends, our Family Wooden Cottages feature extra space, multiple comfortable beds, and a large covered wooden deck overlooking our lush tropical gardens and the rainforest canopy.
        </p>

        <!-- Photo Grid (4 High-Res Authentic Photos) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8">
          <figure class="rounded-2xl overflow-hidden shadow-md border border-[#12281b]/10">
            <img
              src="/wp-content/uploads/2025/07/family-cottage-1.jpg"
              alt="Khao Sok Family Cottage Exterior"
              class="w-full h-56 sm:h-64 object-cover object-center hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="600"
              height="400"
            />
          </figure>
          <figure class="rounded-2xl overflow-hidden shadow-md border border-[#12281b]/10">
            <img
              src="/wp-content/uploads/2025/07/family-cottage-2.jpg"
              alt="Khao Sok Family Cottage Bedroom"
              class="w-full h-56 sm:h-64 object-cover object-center hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="600"
              height="400"
            />
          </figure>
          <figure class="rounded-2xl overflow-hidden shadow-md border border-[#12281b]/10">
            <img
              src="/wp-content/uploads/2025/07/family-cottage-3.jpg"
              alt="Khao Sok Family Cottage Balcony"
              class="w-full h-56 sm:h-64 object-cover object-center hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="600"
              height="400"
            />
          </figure>
          <figure class="rounded-2xl overflow-hidden shadow-md border border-[#12281b]/10">
            <img
              src="/wp-content/uploads/2025/07/family-cottage-4.jpg"
              alt="Khao Sok Family Cottage Bathroom"
              class="w-full h-56 sm:h-64 object-cover object-center hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="600"
              height="400"
            />
          </figure>
        </div>

        <!-- Specifications & Amenities -->
        <div class="bg-[#12281b]/5 border border-[#12281b]/10 rounded-2xl p-6 my-8 space-y-4">
          <h3 class="font-mono text-xs uppercase tracking-widest text-[#7a5813] font-bold">
            Cottage Specifications & Amenities
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs sm:text-sm">
            <div class="p-3 bg-white/70 rounded-xl border border-[#12281b]/10">
              <span class="text-xs text-[#255038] uppercase font-mono block">Capacity</span>
              <span class="font-bold text-[#12281b]">Up to 4 Guests</span>
            </div>
            <div class="p-3 bg-white/70 rounded-xl border border-[#12281b]/10">
              <span class="text-xs text-[#255038] uppercase font-mono block">Bedding</span>
              <span class="font-bold text-[#12281b]">1 Double + 2 Singles</span>
            </div>
            <div class="p-3 bg-white/70 rounded-xl border border-[#12281b]/10">
              <span class="text-xs text-[#255038] uppercase font-mono block">Direct Rate</span>
              <span class="font-bold text-[#ba9038]">From ฿1,800 – ฿2,000 / nt</span>
            </div>
            <div class="p-3 bg-white/70 rounded-xl border border-[#12281b]/10">
              <span class="text-xs text-[#255038] uppercase font-mono block">Climate</span>
              <span class="font-bold text-[#12281b]">Air-Con & Ceiling Fan</span>
            </div>
            <div class="p-3 bg-white/70 rounded-xl border border-[#12281b]/10">
              <span class="text-xs text-[#255038] uppercase font-mono block">Bathroom</span>
              <span class="font-bold text-[#12281b]">Private Hot Shower</span>
            </div>
            <div class="p-3 bg-white/70 rounded-xl border border-[#12281b]/10">
              <span class="text-xs text-[#255038] uppercase font-mono block">Honor System</span>
              <span class="font-bold text-[#255038]">No Advance Deposit</span>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="mt-8 pt-8 border-t border-[#12281b]/10 flex flex-wrap gap-4 items-center justify-between">
          <a
            href="/booking-khao-sok-accommodation/?tab=room"
            class="px-8 py-3.5 bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#c99f3e] hover:to-[#ebd082] text-[#12281b] font-bold rounded-xl text-xs font-mono uppercase tracking-wider transition-all shadow-md"
          >
            Reserve Family Cottage Direct →
          </a>
          <a
            href="/khao-sok-accommodation/"
            class="px-6 py-3.5 bg-[#12281b] hover:bg-[#1c3d24] text-white font-medium rounded-xl text-xs font-mono uppercase tracking-wider transition-all"
          >
            Compare All Cottages
          </a>
        </div>
      </div>
    </div>
  </article>
</PageLayout>
