---
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
import PageLayout from '../../layouts/PageLayout.astro';

---

<PageLayout
  title="Booking Khao Sok Accommodation"
  description="Your destination for booking Khao Sok accommodation! Fill out the booking form, then begin counting down the days to your trip to paradise!"
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="Booking Khao Sok Accommodation"
  heroSubtitle="Handcrafted Wooden Lodging Beside the Sok River"
  breadcrumbs={[{"label": "Booking Khao Sok Accommodation", "href": "/booking-khao-sok-accommodation/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <h2 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Book A Room</span>
        </h2>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Fill out the form and begin counting down the days to your trip to paradise!<br /><strong>Book with confidence – No advance deposits or payments – Simply pay when you arrive at the resort.</strong><br />Guaranteed lowest prices.
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          After you book a room you will have the option to choose activities<br />Or book an <a href="/khao-sok-tour-packages/" class="text-[#1b432c] underline decoration-[#ba9038]/60 underline-offset-2 hover:decoration-[#ba9038] hover:text-[#7a5813] transition-colors">EXTRA VALUE PACKAGE</a> to see it all.
        </p>
      </div>

      
    </div>
  </article>
</PageLayout>
