---
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
import PageLayout from '../../layouts/PageLayout.astro';

---

<PageLayout
  title="Reservation Received"
  description="Booking Form for Khao Sok tours and activities. You should only use this form if you have already booked a room at Riverside Cottages."
  heroImage="/wp-content/uploads/2025/09/riverside-cottages-reservations.jpg"
  heroTitle="Reservation Received"
  heroSubtitle="The Ancient Rainforest of Southern Thailand"
  breadcrumbs={[{"label": "Reservation Recieved", "href": "/reservation-recieved/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <figure class="my-10 rounded-2xl overflow-hidden shadow-xl border border-[#12281b]/10 bg-white/50">
          <img
            src="/wp-content/uploads/2025/09/riverside-cottages-reservations.jpg"
            alt="Khao Sok Riverside Cottages Reservation Staff"
            class="w-full h-52 sm:h-72 md:h-80 object-cover object-center"
            loading="lazy"
            decoding="async"
           width="1200" height="800" />
          <figcaption class="p-3.5 text-xs text-[#255038] font-serif italic border-t border-[#12281b]/10 bg-[#f4efeb]/60">Khao Sok Riverside Cottages Reservation Staff</figcaption>
        </figure>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          <strong>Dear <span id="ksr-guest-name">Guest</span></strong><br /> <strong>We have received your reservation</strong>
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Thank you for choosing Riverside Cottages.<br /> We have sent you an email with details on how to confirm.<br /> If you did not receive our email, please check your spam folder.
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Ages of Children * You can now plan your stay
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Please select the activities that you are interested in.
        </p>
        <h3 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Lake Trips</span>
        </h3>
        <h3 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Hiking & Trekking</span>
        </h3>
        <h3 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Local Adventures</span>
        </h3>
        <h3 class="font-display text-2xl sm:text-3xl text-[#163824] font-semibold tracking-tight mt-10 mb-4 pt-6 border-t border-[#12281b]/10">
          <span>Thai Culture</span>
        </h3>
        <ul class="space-y-3 my-6 pl-2">
          <li class="flex items-start gap-3 text-[#223e2c] text-base leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813]/70 mt-2.5 flex-shrink-0"></span>
            <span>Prices per person in Thai Baht.</span>
          </li>
          <li class="flex items-start gap-3 text-[#223e2c] text-base leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813]/70 mt-2.5 flex-shrink-0"></span>
            <span>For activities marked with * symbol, the listed price does not include entrance fee to National Park (currently 340 Baht).</span>
          </li>
        </ul>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Activities and tours are arranged exclusively for guests staying at Riverside Cottages. If you have not yet booked your stay, please arrange your accommodation first before completing this form.
        </p>
      </div>

      
    </div>
  </article>
</PageLayout>
