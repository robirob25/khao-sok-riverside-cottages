                {article.tag}
              </div>
            </div>
            <div class="px-1 sm:px-2 pb-1 sm:pb-2">
              <h3 class="font-display text-base sm:text-lg text-[#122319] leading-snug group-hover:text-[#ba9038] transition-colors line-clamp-3 mb-3 sm:mb-4 font-semibold">
                {article.title}
              </h3>
              <span class="text-xs font-mono uppercase tracking-widest text-[#7a5813] group-hover:text-[#122319] flex items-center gap-1 font-bold">
                <span>Read Story</span>
                <span>→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
