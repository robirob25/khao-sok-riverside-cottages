---

<PageLayout
  title="Khao Sok Blog & Field Dispatches | All 46 Travel Articles"
  description="Complete travel guide and nature journal for Khao Sok National Park. All 46 articles covering lake tours, wildlife encounters, seasons, hiking trails, and travel logistics."
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="Khao Sok Travel Journal"
  heroSubtitle="The Complete Field Guide: 46 Stories, Wildlife Dispatches & Guides"
  breadcrumbs={[{"label": "Khao Sok Blog", "href": "/khao-sok-blog/"}]}
>
  <div class="max-w-7xl mx-auto space-y-10 sm:space-y-14">

    <!-- Top Editorial Header & Category Filter Bar -->
    <div class="space-y-6 border-b border-[#12281b]/10 pb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <span class="font-sans text-xs uppercase tracking-[0.25em] text-[#7a5813] font-bold block">
            THE COMPLETE CHRONICLES OF KHAO SOK ({articles.length} ARTICLES)
          </span>
          <h2 class="font-monumental text-3xl sm:text-4xl text-[#122319] tracking-tight">
            Rainforest Life, Wildlife & Travel Wisdom
          </h2>
          <p class="text-[#264634] text-sm sm:text-base font-light leading-relaxed">
            Every dispatch, travel guide, and nature story from our riverside team. Explore our complete archive below or filter by topic.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/booking-khao-sok-accommodation/"
            class="btn-couture-gold shadow-md text-xs py-2.5 px-5 font-bold uppercase tracking-wider whitespace-nowrap"
          >
            <span>Plan Your Stay</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Live Search & Interactive Category Filter -->
      <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        
        <!-- Category Filter Pills -->
        <div class="flex flex-wrap items-center gap-2" id="category-filters">
          {categories.map((cat, i) => (
            <button
              type="button"
              data-cat-btn={cat}
              class={}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Quick Keyword Search Input -->
        <div class="relative min-w-[240px] max-w-xs">
          <input
            type="text"
            id="article-search"
            placeholder="Search all 46 articles..."
            class="w-full pl-9 pr-4 py-2 rounded-full text-xs font-sans bg-white border border-[#12281b]/15 text-[#122319] placeholder-[#122319]/40 focus:outline-none focus:border-[#ba9038] focus:ring-1 focus:ring-[#ba9038] transition-all shadow-inner"
          />
          <span class="absolute left-3 top-2.5 text-xs text-[#122319]/40 pointer-events-none">🔍</span>
        </div>

      </div>
    </div>

    <!-- ===== FEATURED LEAD ARTICLE ===== -->
    <div id="featured-container">
      <article class="teak-panel bamboo-frame rounded-3xl overflow-hidden shadow-xl border border-[#12281b]/10 group hover:border-[#ba9038]/60 transition-all duration-500 bg-white">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch">
          <!-- Lead Image -->
          <a href={featuredArticle.slug} class="lg:col-span-7 relative h-72 sm:h-96 lg:h-full min-h-[320px] overflow-hidden block">
            <img
              src={featuredArticle.image}
              alt={featuredArticle.title}
              class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
              loading="eager"
              width="1200"
              height="800"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute top-4 left-4 px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md text-[10px] uppercase tracking-widest text-[#122319] font-sans font-bold shadow-md">
              ★ Featured Story · {featuredArticle.category}
            </div>
          </a>

          <!-- Lead Content -->
          <div class="lg:col-span-5 p-6 sm:p-10 lg:p-12 flex flex-col justify-between space-y-6 bg-white">
            <div class="space-y-4">
              <div class="flex items-center gap-3 text-xs text-[#7a5813] font-sans font-semibold tracking-wider uppercase">
                <span>{featuredArticle.category}</span>
                <span>•</span>
                <span>{featuredArticle.readTime}</span>
              </div>

              <h3 class="font-monumental text-2xl sm:text-3xl text-[#122319] leading-snug group-hover:text-[#ba9038] transition-colors font-semibold">
                <a href={featuredArticle.slug}>
                  {featuredArticle.title}
                </a>
              </h3>

              <p class="text-[#264634] text-sm sm:text-base font-light leading-relaxed">
                {featuredArticle.excerpt}
              </p>
            </div>

            <div class="pt-4 border-t border-[#12281b]/10 flex items-center justify-between">
              <a
                href={featuredArticle.slug}
                class="inline-flex items-center gap-2 text-xs font-sans uppercase tracking-widest text-[#7a5813] hover:text-[#122319] font-bold group-hover:translate-x-1 transition-all"
              >
                <span>Read Full Article</span>
                <span>→</span>
              </a>
              <span class="text-xs text-[#264634]/60 font-sans">Khao Sok National Park</span>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- ===== ARTICLE MAGAZINE GRID (All 45 Articles) ===== -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      id="articles-grid"
    >
      {gridArticles.map((article, idx) => (
        <article
          class="article-card teak-panel bamboo-frame rounded-2xl overflow-hidden shadow-md hover:shadow-2xl border border-[#12281b]/10 hover:border-[#ba9038]/60 transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-between bg-white group reveal"
          data-category={article.category}
          data-title={article.title.toLowerCase()}
          data-excerpt={article.excerpt.toLowerCase()}
        >
          <div>
            <!-- Article Image -->
            <a href={article.slug} class="relative block h-52 sm:h-56 overflow-hidden bg-[#f4efeb]">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                loading="lazy"
                width="800"
                height="533"
              />
              <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-black/30 to-transparent pointer-events-none"></div>
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[9px] uppercase tracking-widest text-[#122319] font-sans font-bold shadow-sm">
                {article.category}
              </div>
            </a>

            <!-- Article Body -->
            <div class="p-5 sm:p-6 space-y-3">
              <div class="flex items-center gap-2 text-[10px] text-[#7a5813] font-sans font-semibold uppercase tracking-wider">
                <span>{article.category}</span>
                <span>•</span>
                <span>{article.readTime}</span>
              </div>

              <h3 class="font-display text-lg sm:text-xl text-[#122319] leading-snug group-hover:text-[#ba9038] transition-colors font-semibold">
                <a href={article.slug}>
                  {article.title}
                </a>
              </h3>

              <p class="text-xs sm:text-sm text-[#264634] font-light leading-relaxed line-clamp-3">
                {article.excerpt}
              </p>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-3 border-t border-[#12281b]/10 flex items-center justify-between">
            <a
              href={article.slug}
              class="inline-flex items-center gap-1.5 text-xs font-sans uppercase tracking-wider text-[#7a5813] group-hover:text-[#122319] font-bold transition-colors"
            >
              <span>Read Story</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <span class="text-[10px] font-sans uppercase tracking-wider text-[#264634]/60">Khao Sok Guide</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State if search yields no results -->
    <div id="empty-state" class="hidden py-16 text-center space-y-4 rounded-3xl bg-white border border-[#12281b]/10 p-8">
      <div class="w-12 h-12 rounded-full bg-[#ba9038]/10 text-[#7a5813] flex items-center justify-center mx-auto text-xl font-bold">
        🔍
      </div>
      <h3 class="font-monumental text-2xl text-[#122319]">No articles match your search</h3>
      <p class="text-[#264634] text-sm max-w-md mx-auto font-light">
        Try searching with different terms like "lake", "hike", "elephants", or "bus".
      </p>
      <button
        type="button"
        id="reset-search-btn"
        class="btn-couture-dark-glass text-xs py-2 px-4 shadow-sm inline-block"
      >
        Clear filters & show all 46 articles
      </button>
    </div>

    <!-- ===== INVITATION BANNER AT BOTTOM ===== -->
    <div class="rounded-3xl p-8 sm:p-12 text-center bg-[#0b1910] text-white space-y-6 relative overflow-hidden shadow-2xl border border-white/10">
      <!-- Ambient Botanical Light -->
      <div class="pointer-events-none absolute -right-10 -bottom-10 w-48 sm:w-64 opacity-20 filter brightness-150">
        <img
          src="/images/botanical-rafflesia.webp"
          alt="Botanical Rafflesia Accent"
          class="w-full h-auto"
          loading="lazy"
          width="582"
          height="516"
        />
      </div>

      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <span class="font-sans text-xs uppercase tracking-[0.25em] text-[#d8b257] font-bold block">
          READY FOR YOUR EXPEDITION?
        </span>
        <h3 class="font-monumental text-2xl sm:text-4xl text-white tracking-tight">
          Experience Khao Sok Beyond the Words
        </h3>
        <p class="text-sm sm:text-base text-[#e2eee6] font-light leading-relaxed">
          Stay right beside the Sok River in our handcrafted standalone wooden cottages. Reserve online with zero credit card deposit.
        </p>
        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a href="/booking-khao-sok-accommodation/" class="btn-couture-gold shadow-xl">
            <span>Book Your Cottage</span>
            <span>→</span>
          </a>
          <a href="/khao-sok-tour-packages/" class="btn-couture-dark-glass shadow-lg">
            <span>Explore Tour Packages</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    // Client-side interactive category filter and instant search
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('[data-cat-btn]');
      const searchInput = document.getElementById('article-search');
      const cards = document.querySelectorAll('.article-card');
      const emptyState = document.getElementById('empty-state');
      const resetBtn = document.getElementById('reset-search-btn');
      const featuredBox = document.getElementById('featured-container');

      let currentCategory = 'All';
      let currentQuery = '';

      function applyFilters() {
        let visibleCount = 0;

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          const title = card.getAttribute('data-title') || '';
          const excerpt = card.getAttribute('data-excerpt') || '';

          const matchesCat = (currentCategory === 'All') || (cardCat === currentCategory);
          const matchesQuery = !currentQuery || title.includes(currentQuery) || excerpt.includes(currentQuery);

          if (matchesCat && matchesQuery) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide featured container when filtering
        if (featuredBox) {
          if (currentCategory !== 'All' || currentQuery !== '') {
            featuredBox.classList.add('hidden');
          } else {
            featuredBox.classList.remove('hidden');
          }
        }

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          currentCategory = btn.getAttribute('data-cat-btn');

          filterBtns.forEach(b => {
            b.className = 'px-3.5 py-1.5 rounded-full text-xs font-sans font-semibold tracking-wider transition-all duration-300 min-h-[36px] bg-white hover:bg-[#faf8f5] text-[#122319] border border-[#12281b]/10 hover:border-[#ba9038]/50';
          });
          btn.className = 'px-3.5 py-1.5 rounded-full text-xs font-sans font-semibold tracking-wider transition-all duration-300 min-h-[36px] bg-[#12281b] text-[#f7e6b5] shadow-sm';

          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value.toLowerCase().trim();
          applyFilters();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentCategory = 'All';
          currentQuery = '';
          if (searchInput) searchInput.value = '';

          filterBtns.forEach((b, i) => {
            if (i === 0) {
              b.className = 'px-3.5 py-1.5 rounded-full text-xs font-sans font-semibold tracking-wider transition-all duration-300 min-h-[36px] bg-[#12281b] text-[#f7e6b5] shadow-sm';
            } else {
              b.className = 'px-3.5 py-1.5 rounded-full text-xs font-sans font-semibold tracking-wider transition-all duration-300 min-h-[36px] bg-white hover:bg-[#faf8f5] text-[#122319] border border-[#12281b]/10 hover:border-[#ba9038]/50';
            }
          });

          applyFilters();
        });
      }
    });
  </script>
</PageLayout>
