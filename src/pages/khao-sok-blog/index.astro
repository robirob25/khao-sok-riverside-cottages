---
// Khao Sok Blog Index — Luxury Editorial Magazine Layout
// 2026 High-Conversion Travel Journal & Field Dispatches
import PageLayout from '../../layouts/PageLayout.astro';

const articles = [
  {
    title: 'Cave, Raft & Hike Adventure in Khlong Phanom National Park',
    slug: '/khao-sok-cave-raft-hike-tour/',
    image: '/wp-content/uploads/2026/03/bamboo-rafting-khao-sok.jpg',
    category: 'Expedition',
    readTime: '4 min read',
    excerpt: 'A half-day adventure near Khao Sok combining peaceful bamboo rafting down clear jungle rivers, guided rainforest trekking, and exploring the limestone caverns of Tam Kaew Cave.',
    featured: true,
  },
  {
    title: 'Fungal in the Jungle – the Hidden Mushrooms of Khao Sok',
    slug: '/fungal-in-the-jungle-the-hidden-mushrooms-of-khao-sok/',
    image: '/wp-content/uploads/2025/08/mushroom-types-khao-sok-e.jpg',
    category: 'Biodiversity',
    readTime: '5 min read',
    excerpt: 'Scattered across the 160-million-year-old forest floor is a forgotten kingdom of wild mushrooms. An in-depth exploration of rare, luminous, and exotic fungi of southern Thailand.',
    featured: false,
  },
  {
    title: 'Thailand Rainy Season – Is It a Good Time to Visit Khao Sok?',
    slug: '/thailand-rainy-season-is-it-a-good-time-to-visit-khao-sok/',
    image: '/wp-content/uploads/2025/05/rain-clouds-over-cheow-lan-lake.jpg',
    category: 'Travel Advice',
    readTime: '6 min read',
    excerpt: 'Why the Green Season brings mystical morning mists, dramatic jungle waterfalls, roaring wildlife activity, and calm emerald waters on Cheow Lan Lake with far fewer visitors.',
    featured: false,
  },
  {
    title: 'How to Get from Krabi to Khao Sok',
    slug: '/krabi-to-khao-sok/',
    image: '/wp-content/uploads/2024/05/krabi-airport.jpg',
    category: 'Logistics & Arrival',
    readTime: '4 min read',
    excerpt: 'A complete practical guide on traveling from Ao Nang, Krabi Town, and Krabi Airport to Khao Sok by minivan, local bus, or direct private air-conditioned transfer.',
    featured: false,
  },
  {
    title: 'Phuket to Khao Sok – Travel Guide & Bus Schedules',
    slug: '/phuket-to-khao-sok/',
    image: '/wp-content/uploads/2024/05/phuket-airport.jpg',
    category: 'Logistics & Arrival',
    readTime: '4 min read',
    excerpt: 'Direct travel routes from Phuket International Airport, Patong, and Phuket Town to the national park gates, including hourly buses, minivans, and private cars.',
    featured: false,
  },
  {
    title: 'Rare and Endangered Species of Khao Sok National Park',
    slug: '/rare-endangered-species-khao-sok/',
    image: '/wp-content/uploads/2024/12/endangered-species-khao-sok-1.jpg',
    category: 'Wildlife Conservation',
    readTime: '7 min read',
    excerpt: 'Discover the ancient rainforest sanctuary protecting wild Asian elephants, Malayan tapirs, clouded leopards, great hornbills, and the parasitic giant Rafflesia Kerrii flower.',
    featured: false,
  },
  {
    title: 'Khao Sok Travel Guide – How Many Days to Stay?',
    slug: '/khao-sok-travel-guide-how-many-days-to-stay-in-khao-sok/',
    image: '/wp-content/uploads/2024/09/khao-sok-travel-guide-2.jpg',
    category: 'Itinerary Planning',
    readTime: '5 min read',
    excerpt: 'Whether you have 2 days or a full week, discover the optimal balance between riverside relaxation, night wildlife safaris, and overnight floating bungalows on Cheow Lan Lake.',
    featured: false,
  },
  {
    title: 'Riverside Cottages Nature Trail & Botanical Walk',
    slug: '/riverside-cottages-nature-trail/',
    image: '/wp-content/uploads/2024/07/kha-sok-nature-trail-g-standard-v2-4x.jpg',
    category: 'Lodge Experience',
    readTime: '3 min read',
    excerpt: 'Step outside your wooden chalet and wander our dedicated botanical trail along the Sok River, identifying wild ginger, ancient ficus trees, and birds of paradise.',
    featured: false,
  },
  {
    title: 'The Ultimate Guide to Finding the Closest Airport to Khao Sok',
    slug: '/guide-to-finding-the-closest-airport-to-khao-sok-national-park/',
    image: '/wp-content/uploads/2024/05/surat-thani-airport-2.jpg',
    category: 'Travel Advice',
    readTime: '5 min read',
    excerpt: 'Comparing Surat Thani (URT), Phuket (HKT), and Krabi (KBV) airports for flight prices, transfer durations, and convenience when planning your trip to Khao Sok.',
    featured: false,
  },
  {
    title: 'Dive Into Nature: Khao Sok 2-Day Jungle & Lake Tour',
    slug: '/khao-sok-2-day-tour/',
    image: '/wp-content/uploads/2024/03/kha0-sok-2-day-tour.jpg',
    category: 'Expedition Review',
    readTime: '6 min read',
    excerpt: 'An intimate guest dispatch reviewing the iconic 2-day jungle & lake overnight expedition: limestone spires, floating raft houses, and tranquil sunrise canoeing.',
    featured: false,
  },
];

const featuredArticle = articles[0];
const gridArticles = articles.slice(1);
---

<PageLayout
  title="Khao Sok Blog & Field Dispatches | Riverside Cottages"
  description="Official travel guide and nature journal for Khao Sok National Park. In-depth advice on lake tours, wildlife encounters, seasons, and logistics from our riverside team."
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="Khao Sok Travel Journal"
  heroSubtitle="Field Dispatches, Wildlife Guides & Rainforest Stories"
  breadcrumbs={[{"label": "Khao Sok Blog", "href": "/khao-sok-blog/"}]}
>
  <div class="max-w-7xl mx-auto space-y-12 sm:space-y-16">

    <!-- Top Editorial Header & Category Filter Bar -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#12281b]/10 pb-8">
      <div class="space-y-2 max-w-2xl">
        <span class="font-sans text-xs uppercase tracking-[0.25em] text-[#7a5813] font-bold block">
          DISPATCHES FROM THE SOK RIVER
        </span>
        <h2 class="font-monumental text-3xl sm:text-4xl text-[#122319] tracking-tight">
          Rainforest Chronicles & Travel Wisdom
        </h2>
        <p class="text-[#264634] text-sm sm:text-base font-light leading-relaxed">
          Curated by our resident naturalists and local guides. Everything you need to plan an authentic, unforgettable journey into southern Thailand's oldest jungle.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/booking-khao-sok-accommodation/"
          class="btn-couture-gold shadow-md text-xs py-2.5 px-5 font-bold uppercase tracking-wider"
        >
          <span>Plan Your Stay</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- ===== FEATURED LEAD ARTICLE (Singita Hero Card) ===== -->
    <article class="teak-panel bamboo-frame rounded-3xl overflow-hidden shadow-xl border border-[#12281b]/10 group hover:border-[#ba9038]/60 transition-all duration-500">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch">
        <!-- Lead Image -->
        <a href={featuredArticle.slug} class="lg:col-span-7 relative h-72 sm:h-96 lg:h-full min-h-[320px] overflow-hidden block">
          <img
            src={featuredArticle.image}
            alt={featuredArticle.title}
            class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
            loading="eager"
            width="1200"
            height="800"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute top-4 left-4 px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md text-[10px] uppercase tracking-widest text-[#122319] font-sans font-bold shadow-md">
            ★ Featured Dispatch · {featuredArticle.category}
          </div>
        </a>

        <!-- Lead Content -->
        <div class="lg:col-span-5 p-6 sm:p-10 lg:p-12 flex flex-col justify-between space-y-6 bg-white">
          <div class="space-y-4">
            <div class="flex items-center gap-3 text-xs text-[#7a5813] font-sans font-semibold tracking-wider uppercase">
              <span>{featuredArticle.category}</span>
              <span>•</span>
              <span>{featuredArticle.readTime}</span>
            </div>

            <h3 class="font-monumental text-2xl sm:text-3xl text-[#122319] leading-snug group-hover:text-[#ba9038] transition-colors font-semibold">
              <a href={featuredArticle.slug}>
                {featuredArticle.title}
              </a>
            </h3>

            <p class="text-[#264634] text-sm sm:text-base font-light leading-relaxed">
              {featuredArticle.excerpt}
            </p>
          </div>

          <div class="pt-4 border-t border-[#12281b]/10 flex items-center justify-between">
            <a
              href={featuredArticle.slug}
              class="inline-flex items-center gap-2 text-xs font-sans uppercase tracking-widest text-[#7a5813] hover:text-[#122319] font-bold group-hover:translate-x-1 transition-all"
            >
              <span>Read Full Article</span>
              <span>→</span>
            </a>
            <span class="text-xs text-[#264634]/60 font-sans">Khao Sok National Park</span>
          </div>
        </div>
      </div>
    </article>

    <!-- ===== ARTICLE MAGAZINE GRID (9 Articles) ===== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {gridArticles.map((article, idx) => (
        <article
          class={`teak-panel bamboo-frame rounded-2xl overflow-hidden shadow-md hover:shadow-2xl border border-[#12281b]/10 hover:border-[#ba9038]/60 transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-between bg-white group reveal reveal-delay-${(idx % 3) + 1}`}
        >
          <div>
            <!-- Article Image -->
            <a href={article.slug} class="relative block h-52 sm:h-56 overflow-hidden">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                loading="lazy"
                width="800"
                height="533"
              />
              <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-black/30 to-transparent pointer-events-none"></div>
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[9px] uppercase tracking-widest text-[#122319] font-sans font-bold">
                {article.category}
              </div>
            </a>

            <!-- Article Body -->
            <div class="p-5 sm:p-6 space-y-3">
              <div class="flex items-center gap-2 text-[10px] text-[#7a5813] font-sans font-semibold uppercase tracking-wider">
                <span>{article.category}</span>
                <span>•</span>
                <span>{article.readTime}</span>
              </div>

              <h3 class="font-display text-lg sm:text-xl text-[#122319] leading-snug group-hover:text-[#ba9038] transition-colors font-semibold">
                <a href={article.slug}>
                  {article.title}
                </a>
              </h3>

              <p class="text-xs sm:text-sm text-[#264634] font-light leading-relaxed line-clamp-3">
                {article.excerpt}
              </p>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-2 border-t border-[#12281b]/10 flex items-center justify-between">
            <a
              href={article.slug}
              class="inline-flex items-center gap-1.5 text-xs font-sans uppercase tracking-wider text-[#7a5813] group-hover:text-[#122319] font-bold transition-colors"
            >
              <span>Read Story</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <span class="text-[10px] font-sans uppercase tracking-wider text-[#264634]/60">Guide</span>
          </div>
        </article>
      ))}
    </div>

    <!-- ===== INVITATION BANNER AT BOTTOM ===== -->
    <div class="rounded-3xl p-8 sm:p-12 text-center bg-[#0b1910] text-white space-y-6 relative overflow-hidden shadow-2xl border border-white/10">
      <!-- Ambient Botanical Light -->
      <div class="pointer-events-none absolute -right-10 -bottom-10 w-48 sm:w-64 opacity-20 filter brightness-150">
        <img
          src="/images/botanical-rafflesia.webp"
          alt="Botanical Rafflesia Accent"
          class="w-full h-auto"
          loading="lazy"
          width="582"
          height="516"
        />
      </div>

      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <span class="font-sans text-xs uppercase tracking-[0.25em] text-[#d8b257] font-bold block">
          READY FOR YOUR EXPEDITION?
        </span>
        <h3 class="font-monumental text-2xl sm:text-4xl text-white tracking-tight">
          Experience Khao Sok Beyond the Words
        </h3>
        <p class="text-sm sm:text-base text-[#e2eee6] font-light leading-relaxed">
          Stay right beside the Sok River in our handcrafted standalone wooden cottages. Reserve online with zero credit card deposit.
        </p>
        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a href="/booking-khao-sok-accommodation/" class="btn-couture-gold shadow-xl">
            <span>Book Your Cottage</span>
            <span>→</span>
          </a>
          <a href="/khao-sok-tour-packages/" class="btn-couture-dark-glass shadow-lg">
            <span>Explore Tour Packages</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</PageLayout>
