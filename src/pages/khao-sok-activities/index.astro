---
// Canonical alias redirect
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/khao-sok-tours/" />
    <link rel="canonical" href="https://robirob25.github.io/khao-sok-riverside-cottages/khao-sok-tours/" />
    <title>Redirecting to Khao Sok Tours & Activities...</title>
    <script>
      const rawBase = import.meta.env.BASE_URL;
      const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
      window.location.replace(`${base}/khao-sok-tours/`);
    </script>
  </head>
  <body class="bg-[#faf8f5] text-[#12281b] flex items-center justify-center min-h-screen">
    <p>Redirecting to <a href="/khao-sok-tours/" class="underline">Khao Sok Tours & Activities</a>...</p>
  </body>
</html>
