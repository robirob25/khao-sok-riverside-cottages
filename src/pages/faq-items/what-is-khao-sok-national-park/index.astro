  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="What is Khao Sok National Park?"
  heroSubtitle="Khao Sok National Park · Field Answer"
  breadcrumbs={[{"label": "Faq Items", "href": "/faq-items/"}, {"label": "What Is Khao Sok National Park", "href": "/faq-items/what-is-khao-sok-national-park/"}]}
