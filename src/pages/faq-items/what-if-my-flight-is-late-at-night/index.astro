---
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
import PageLayout from '../../../layouts/PageLayout.astro';

---

<PageLayout
  title="What if my flight is late at night?"
  description="What if my flight is late at night? - Find out more in our FAQs"
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="What if my flight is late at night?"
  heroSubtitle="Khao Sok National Park · Field Answer"
  breadcrumbs={[{"label": "Faq Items", "href": "/faq-items/"}, {"label": "What If My Flight Is Late At...", "href": "/faq-items/what-if-my-flight-is-late-at-night/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-sans text-[11px] tracking-[0.2em] font-medium uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Shared vans from Surat Thani only run during the day up to around 16:00. For late flights, book a taxi (Surat Thani to Khao Sok only) or private transfer.
        </p>
      </div>

      
    </div>
  </article>
</PageLayout>
