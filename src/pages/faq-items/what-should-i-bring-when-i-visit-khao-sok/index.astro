import PageLayout from '../../../layouts/PageLayout.astro';

---

<PageLayout
  title="What should I bring when I visit Khao Sok?"
  description="What should I bring when I visit Khao Sok? - Find out more in our FAQs"
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="What should I bring when I visit Khao Sok?"
  heroSubtitle="Khao Sok National Park · Field Answer"
  breadcrumbs={[{"label": "Faq Items", "href": "/faq-items/"}, {"label": "What Should I Bring When I V...", "href": "/faq-items/what-should-i-bring-when-i-visit-khao-sok/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Bring cool and quick-drying clothing, a bathing suit, hat, good walking shoes that you don’t mind getting wet (water shoes are never a bad idea!), a flashlight, sun protection, personal medicines, and toiletries. Shirts or pants with button pockets best for jungle hikes so you don’t lose things. Wine, beer, raincoats, mosquito repellent, and other necessities are available here.
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Planning on visiting Cheow Larn Lake? Take a minute to read through our <a href="/khao-sok-lake-cheow-lan-tours/" class="text-[#1b432c] underline decoration-[#ba9038]/60 underline-offset-2 hover:decoration-[#ba9038] hover:text-[#7a5813] transition-colors">Top Tips for your Lake trip</a>, and come prepared!
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          If you have any questions, just let us know!
        </p>
      </div>

      
    </div>
  </article>
</PageLayout>
