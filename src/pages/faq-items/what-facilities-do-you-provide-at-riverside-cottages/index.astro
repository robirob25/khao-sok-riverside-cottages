---
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
import PageLayout from '../../../layouts/PageLayout.astro';

---

<PageLayout
  title="What facilities do you provide at Riverside Cottages?"
  description="What facilities do you provide at Riverside Cottages? - Find out more in our FAQs"
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="What facilities do you provide at Riverside Cottages?"
  heroSubtitle="Khao Sok National Park · Field Answer"
  breadcrumbs={[{"label": "Faq Items", "href": "/faq-items/"}, {"label": "What Facilities Do You Provi...", "href": "/faq-items/what-facilities-do-you-provide-at-riverside-cottages/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <p class="mb-5 leading-relaxed text-[#223e2c]">
          Laundry, international phone, and internet are available. Mobile phones may be used but signal might be weak. All houses have 24-hour electricity, but brown-out or black-outs may occur, usually lasting only a few minutes or at most a few hours.
        </p>
        <p class="mb-5 leading-relaxed text-[#223e2c]">
          <a href="/khao-sok-riverside-resort-facilities/" class="text-[#1b432c] underline decoration-[#ba9038]/60 underline-offset-2 hover:decoration-[#ba9038] hover:text-[#7a5813] transition-colors">Find details of our facilities here</a>.
        </p>
      </div>

      
    </div>
  </article>
</PageLayout>
