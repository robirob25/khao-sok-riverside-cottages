---
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
import PageLayout from '../../../layouts/PageLayout.astro';

---

<PageLayout
  title="How can I book Khao Sok tours?"
  description="How can I book Khao Sok tours? - Find out more in our FAQs"
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="How can I book Khao Sok tours?"
  heroSubtitle="Khao Sok National Park · Field Answer"
  breadcrumbs={[{"label": "Faq Items", "href": "/faq-items/"}, {"label": "How Can I Book Khao Sok Tours", "href": "/faq-items/how-can-i-book-khao-sok-tours/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <p class="mb-5 leading-relaxed text-[#223e2c]">
          For the best availability, you can book tours as part of a <a href="/khao-sok-tour-packages/" class="text-[#1b432c] underline decoration-[#ba9038]/60 underline-offset-2 hover:decoration-[#ba9038] hover:text-[#7a5813] transition-colors">package deal</a> when you book your accommodation. You can also talk with the front desk staff when you arrive and they can book all your tours. Khao Sok Riverside Cottages have a wealth of information including less well known, off the beaten track Khao Sok tours. <a href="/off-the-beaten-path-in-south-thailand/" class="text-[#1b432c] underline decoration-[#ba9038]/60 underline-offset-2 hover:decoration-[#ba9038] hover:text-[#7a5813] transition-colors">Find out more ...</a>
        </p>
      </div>

      
    </div>
  </article>
</PageLayout>
