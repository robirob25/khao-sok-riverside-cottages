---
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
import PageLayout from '../../../layouts/PageLayout.astro';

---

<PageLayout
  title="How do you get to Khao Sok National Park?"
  description="How do you get to Khao Sok National Park? - Find out more in our FAQs"
  heroImage="/images/khao-sok-hero-cottages.jpg"
  heroTitle="How do you get to Khao Sok National Park?"
  heroSubtitle="Khao Sok National Park · Field Answer"
  breadcrumbs={[{"label": "Faq Items", "href": "/faq-items/"}, {"label": "How Do You Get To Khao Sok N...", "href": "/faq-items/how-do-you-get-to-khao-sok-national-park/"}]}
>
  <article class="max-w-4xl mx-auto space-y-10">
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-sans text-[11px] tracking-[0.2em] font-medium uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="space-y-6 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">

        <p class="mb-5 leading-relaxed text-[#223e2c]">
          To get to Khao Sok national park you can take public transportation or hire a private transfer to get to Khao Sok. Transfers can be arranged from anywhere in southern Thailand. We have a detailed price list for transfers. <a href="/khao-sok-map-directions/" class="text-[#1b432c] underline decoration-[#ba9038]/60 underline-offset-2 hover:decoration-[#ba9038] hover:text-[#7a5813] transition-colors">Find transfers price list here</a>.
        </p>
      </div>

      
    </div>
  </article>
</PageLayout>
