            </figure>
            <figure class="rounded-2xl overflow-hidden shadow-lg border border-[#12281b]/10 bg-white/50 group">
              <img
                src="/wp-content/uploads/2022/05/tubing-on-river-sok.jpg"
                alt=""
                class="w-full h-48 sm:h-64 object-cover object-center group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
               width="1200" height="800" />
              
            </figure>
            <figure class="rounded-2xl overflow-hidden shadow-lg border border-[#12281b]/10 bg-white/50 group">
              <img
                src="/wp-content/uploads/2016/07/three-day-khao-sok-package-6.jpg"
                alt=""
                class="w-full h-48 sm:h-64 object-cover object-center group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
               width="1200" height="800" />
              
            </figure>
            <figure class="rounded-2xl overflow-hidden shadow-lg border border-[#12281b]/10 bg-white/50 group">
              <img
                src="/wp-content/uploads/2016/07/three-day-khao-sok-package-7.jpg"
                alt=""
                class="w-full h-48 sm:h-64 object-cover object-center group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
               width="1200" height="800" />
              
            </figure>
            <figure class="rounded-2xl overflow-hidden shadow-lg border border-[#12281b]/10 bg-white/50 group">
              <img
                src="/wp-content/uploads/2016/07/three-day-khao-sok-package-8.jpg"
                alt=""
