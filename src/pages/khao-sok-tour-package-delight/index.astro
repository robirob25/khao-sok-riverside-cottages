            </figure>
          </div>
        </div>
        <!-- Luxury Booking CTA Card -->
        <div class="my-12 p-8 sm:p-10 rounded-3xl bg-[#12281b] text-white shadow-2xl border border-white/10 relative overflow-hidden">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div>
              <span class="text-xs uppercase tracking-widest text-[#ba9038] font-semibold">Reserve Your Experience</span>
              <h3 class="font-display text-2xl sm:text-3xl text-white font-semibold mt-1">Ready to Book this Experience?</h3>
              <p class="text-[#abd0bb] text-sm sm:text-base mt-2 max-w-xl">
                No deposit required — book directly with our honor system guarantee. Free private shuttle pickup from the Khao Sok bus stop included.
              </p>
            </div>
            <a
              href="/booking-khao-sok-accommodation/?tab=package"
              class="px-8 py-4 rounded-full bg-[#ba9038] hover:bg-[#d8b257] text-[#12281b] font-medium text-sm sm:text-base tracking-wide transition-all duration-200 shadow-lg hover:shadow-xl flex-shrink-0"
            >
              Book Package Now →
            </a>
          </div>
        </div>
      </div>

      
    </div>
  </article>
</PageLayout>
