          <table width="100%"><thead><tr><th align="left"><strong>Essentials</strong></th><th align="left"><strong>Notes</strong></th></tr></thead><tbody><tr><td align="left">National Park Fee</td><td align="left">340 THB per adult / 170 THB per child; extra 200 THB for Coral Cave</td></tr><tr><td align="left">Mosquito repellent</td><td align="left">Floating bungalows are mostly free of mosquitos. Needed for land based excursions.</td></tr><tr><td align="left">Shoes & Sandals</td><td align="left">Trekking shoes that can get wet; flip-flops for bungalows</td></tr><tr><td align="left">Swimwear & Towel</td><td align="left">You’ll want to swim!</td></tr><tr><td align="left">Extra clothes</td><td align="left">For wet/muddy treks + dry change</td></tr><tr><td align="left">Jacket or Sweater</td><td align="left">Vans can be chilly with A/C</td></tr><tr><td align="left">Torch / Headlamp</td><td align="left">For night time and early-morning starts</td></tr><tr><td align="left">Cash</td><td align="left">For snacks and park fees (*note: no ATMs at the pier)</td></tr><tr><td align="left">Sun protection</td><td align="left">Hat, sunscreen, sunglasses</td></tr></tbody></table>
