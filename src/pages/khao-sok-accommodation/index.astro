---
// src/pages/khao-sok-accommodation/index.astro — Handcrafted Wooden Cottages on the Sok River
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
// Elite 2026 Silent Luxury Architecture (Aman / Six Senses Inspired)
import PageLayout from '../../layouts/PageLayout.astro';
import GoogleReviewsWidget from '../../components/GoogleReviewsWidget.astro';

const cottages = [
  {
    id: "garden-view",
    name: "Garden View Cottage",
    tagline: "Comfortable Standalone Wooden Cottages in Botanical Gardens",
    price: "฿1,100",
    priceNote: "per night · 1-2 guests",
    badge: "Most Popular",
    photos: [
      { src: "/wp-content/uploads/2025/07/cottage-1.jpg", label: "Master Bedroom" },
      { src: "/wp-content/uploads/2025/07/cottage-2.jpg", label: "Garden Exterior" },
      { src: "/wp-content/uploads/2025/07/cottage-3-scaled.jpg", label: "Stone Bathroom" },
      { src: "/wp-content/uploads/2025/07/cottage-4.jpg", label: "Balcony & Hammock" },
      { src: "/wp-content/uploads/2025/07/cottage-5.jpg", label: "Covered Veranda" },
    ],
    description: "Comfortable standalone wooden cottages ideal for couples or solo travellers wanting a peaceful stay surrounded by nature. Designed with natural cross-ventilation, shaded verandas, and authentic tropical materials.",
    specs: {
      capacity: "Ideal for 2 guests",
      bed: "1 King bed or 2 Twin beds",
      climate: "Ceiling fan or Air Conditioning options",
      outdoor: "Private balcony with hammock overlooking lush jungle gardens",
      bath: "Private en-suite bathroom with hot water shower",
    },
    features: ["Private Balcony & Hammock", "En-suite Bathroom & Hot Shower", "Ceiling Fan / AC", "Garden View", "Free Wi-Fi", "Mosquito Netting"],
    bookUrl: "/booking-khao-sok-accommodation/?tab=room",
  },
  {
    id: "riverside",
    name: "Riverside Cottage",
    tagline: "Direct Riverfront Views & Sounds of Flowing Water",
    price: "฿1,400",
    priceNote: "per night · 1-2 guests",
    badge: "Prime Riverfront",
    photos: [
      { src: "/wp-content/uploads/2025/07/deluxe-cottage-1.jpg", label: "Riverfront Balcony View" },
      { src: "/wp-content/uploads/2025/07/deluxe-cottage-2.jpg", label: "Handcrafted Bedroom" },
      { src: "/wp-content/uploads/2025/07/deluxe-cottage-3.jpg", label: "Hammock Over River" },
      { src: "/wp-content/uploads/2025/07/deluxe-cottage-4.jpg", label: "En-suite Bathroom" },
      { src: "/wp-content/uploads/2025/07/deluxe-cottage-5.jpg", label: "Riverbank Exterior" },
    ],
    description: "Our most sought-after room category. Perched directly beside the Sok River with dramatic views of limestone karst cliffs. Relax in your private hammock listening to the gentle flow of the river.",
    specs: {
      capacity: "Ideal for 2 guests",
      bed: "1 King bed",
      climate: "Natural river breeze, ceiling fan and Air Conditioning",
      outdoor: "Private waterfront balcony with hammock directly above riverbank",
      bath: "En-suite bathroom with hot water shower",
    },
    features: ["Direct River & Karst Views", "Private Riverfront Balcony", "Air Conditioning", "En-suite Hot Shower", "Hammock Over River", "Free Wi-Fi"],
    bookUrl: "/booking-khao-sok-accommodation/?tab=room",
  },
  {
    id: "family",
    name: "Family Wooden Cottage",
    tagline: "Spacious Multi-Bed Lodging for Families & Small Groups",
    price: "฿2,000",
    priceNote: "per night · Up to 4 guests",
    badge: "Family & Groups",
    photos: [
      { src: "/wp-content/uploads/2025/07/family-cottage-1.jpg", label: "Family Bedroom" },
      { src: "/wp-content/uploads/2025/07/family-cottage-2.jpg", label: "Multi-Bed Setup" },
      { src: "/wp-content/uploads/2025/07/family-cottage-3.jpg", label: "Covered Family Deck" },
      { src: "/wp-content/uploads/2025/07/family-cottage-4.jpg", label: "Spacious Bathroom" },
      { src: "/wp-content/uploads/2025/07/family-cottage-6.jpg", label: "Jungle Garden Setting" },
    ],
    description: "Extra-spacious wooden chalets designed for families with children or friends travelling together. Large en-suite bathroom, expansive balcony, and plenty of room to unwind together after a day exploring the national park.",
    specs: {
      capacity: "Up to 4 guests",
      bed: "2 Queen beds or 1 King + 2 Bunk beds",
      climate: "Ceiling fans & Air Conditioning",
      outdoor: "Large covered family deck with seating & forest outlook",
      bath: "Spacious private bathroom with hot shower",
    },
    features: ["Sleeps up to 4 Guests", "Spacious Family Balcony", "Air Conditioning & Hot Shower", "Secluded Jungle Setting", "Child Friendly", "Free Wi-Fi"],
    bookUrl: "/booking-khao-sok-accommodation/?tab=room",
  },
];
---

<PageLayout
  title="Khao Sok Accommodation — Handcrafted Cottages on the Sok River"
  description="Explore Khao Sok accommodation options that offer comfort, nature, and convenience near the National Park. Traditional Thai wooden cottages beside the Sok River."
  heroImage="/wp-content/uploads/2025/07/cottage-1.jpg"
  heroTitle="Khao Sok Accommodation"
  heroSubtitle="Handcrafted Wooden Lodging Beside the Sok River"
  breadcrumbs={[{"label": "Khao Sok Accommodation", "href": "/khao-sok-accommodation/"}]}
>
  <article class="max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Top Editorial Card -->
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-sans text-[11px] tracking-[0.2em] uppercase text-[#163824] font-medium">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>ACCOMMODATION GUIDE</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="max-w-3xl space-y-5 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">
        <h2 class="font-display text-2xl sm:text-4xl text-[#163824] font-semibold tracking-tight">
          Riverside Cottages Accommodation
        </h2>
        <p class="leading-relaxed">
          Set beside the Sok River and surrounded by tropical forest, the wooden cottages at Riverside Cottages offer a more relaxed and nature-connected style of accommodation in Khao Sok. Designed around natural airflow, shaded gardens, and open-air tropical living, the cottages allow guests to experience the sounds, atmosphere, and slower pace of the rainforest while still enjoying comfort, privacy, and thoughtful hospitality.
        </p>
        <p class="leading-relaxed">
          Whether travelling as a couple, family, or small group, our cottages provide a peaceful base for exploring Khao Sok National Park, Cheow Lan Lake, jungle hikes, canoe trips, and local experiences.
        </p>
      </div>

      <!-- Key Inclusions Bento Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8 pt-8 border-t border-[#12281b]/10">
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#12281b]/10 shadow-sm">
          <span class="w-8 h-8 rounded-full bg-[#ba9038]/20 flex items-center justify-center text-[#7a5813] font-bold text-sm shrink-0">🚐</span>
          <div>
            <span class="block font-semibold text-sm text-[#12281b]">Free Shuttle Service</span>
            <span class="text-xs text-[#2e5339]">Complimentary transfers to Khao Sok village and bus stop</span>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#12281b]/10 shadow-sm">
          <span class="w-8 h-8 rounded-full bg-[#ba9038]/20 flex items-center justify-center text-[#7a5813] font-bold text-sm shrink-0">🧭</span>
          <div>
            <span class="block font-semibold text-sm text-[#12281b]">Tour Desk & Concierge</span>
            <span class="text-xs text-[#2e5339]">Full assistance booking park guides, lake trips & safaris</span>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#12281b]/10 shadow-sm">
          <span class="w-8 h-8 rounded-full bg-[#ba9038]/20 flex items-center justify-center text-[#7a5813] font-bold text-sm shrink-0">🌿</span>
          <div>
            <span class="block font-semibold text-sm text-[#12281b]">Riverside Restaurant</span>
            <span class="text-xs text-[#2e5339]">Rafflesia Cafe with Thai and Western dishes beside the river</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         THE 3 COTTAGES SHOWCASES (LUXURY CARDS WITH DIAPORAMA)
    ============================================================ -->
    <div class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="font-sans text-xs uppercase tracking-[0.22em] text-[#7a5813] font-bold">LODGING SELECTION</span>
        <h2 class="font-monumental text-3xl sm:text-4xl text-[#12281b] tracking-tight">
          Handcrafted Wooden Cottages
        </h2>
        <p class="text-sm sm:text-base text-[#2e5339]">
          Select your preferred cottage style. Pay upon arrival with zero advance deposit required.
        </p>
      </div>

      <div class="space-y-10">
        {cottages.map((cottage, idx) => (
          <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-2xl backdrop-blur-md overflow-hidden relative">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              
              <!-- Left: Interactive Diaporama (Span 7) -->
              <div class="lg:col-span-7 space-y-3.5" data-cottage-gallery id={`gallery-${cottage.id}`}>
                
                <!-- Main Featured Display with Controls -->
                <div class="relative rounded-2xl overflow-hidden shadow-xl border border-[#12281b]/10 aspect-[16/10] bg-[#12281b]/5 group select-none">
                  
                  <!-- Main Clickable Image -->
                  <div class="w-full h-full cursor-zoom-in relative" data-main-click title="Click to view full screen">
                    <img
                      data-main-img
                      src={cottage.photos[0].src}
                      alt={`${cottage.name} — ${cottage.photos[0].label}`}
                      class="w-full h-full object-cover transition-opacity duration-300 filter brightness-[1.02]"
                      loading="lazy"
                      decoding="async"
                      width="1200"
                      height="750"
                    />
                    
                    <!-- Zoom Hint Pill on Hover -->
                    <div class="absolute bottom-4 left-4 hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/50 text-white text-[11px] font-sans tracking-wide backdrop-blur-md border border-white/15 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                      <span>Click to zoom</span>
                    </div>
                  </div>

                  <!-- Prev Arrow Button -->
                  <button
                    type="button"
                    data-prev-btn
                    aria-label="Previous photo"
                    class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/85 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                  </button>

                  <!-- Next Arrow Button -->
                  <button
                    type="button"
                    data-next-btn
                    aria-label="Next photo"
                    class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/85 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>

                  <!-- Badge (Top Left) -->
                  <div class="absolute top-4 left-4 flex gap-2 pointer-events-none z-10">
                    <span class="px-3 py-1 rounded-full bg-[#12281b]/90 text-white font-sans text-[10px] uppercase tracking-wider font-semibold backdrop-blur-md border border-white/20 shadow-sm">
                      {cottage.badge}
                    </span>
                  </div>

                  <!-- Counter Indicator (Top Right) -->
                  <div class="absolute top-4 right-4 pointer-events-none z-10">
                    <span
                      data-counter
                      class="px-2.5 py-1 rounded-full bg-black/60 text-white font-sans text-[11px] font-medium backdrop-blur-md border border-white/20 shadow-sm"
                    >
                      1 / {cottage.photos.length}
                    </span>
                  </div>

                  <!-- Price Tag (Bottom Right) -->
                  <div class="absolute bottom-4 right-4 px-3.5 py-1.5 rounded-xl bg-white/95 text-[#12281b] font-sans text-xs font-bold shadow-lg backdrop-blur-md border border-[#12281b]/10 z-10 pointer-events-none">
                    {cottage.price} <span class="font-normal text-[10px] text-[#2e5339]">/ night</span>
                  </div>
                </div>

                <!-- 5 Clickable Thumbnails Row -->
                <div class="grid grid-cols-5 gap-2 sm:gap-2.5">
                  {cottage.photos.map((photo, tIdx) => (
                    <button
                      type="button"
                      data-thumb-btn
                      data-index={tIdx}
                      data-src={photo.src}
                      data-alt={`${cottage.name} — ${photo.label}`}
                      aria-label={`View ${photo.label}`}
                      aria-selected={tIdx === 0 ? "true" : "false"}
                      class={`relative rounded-xl overflow-hidden aspect-[4/3] transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7a5813] group ${
                        tIdx === 0
                          ? "ring-2 ring-[#7a5813] ring-offset-2 ring-offset-[#faf8f5] opacity-100 scale-[1.02] shadow-sm"
                          : "opacity-60 hover:opacity-100 border border-[#12281b]/15"
                      }`}
                    >
                      <img
                        src={photo.src}
                        alt={`${cottage.name} — ${photo.label}`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                        decoding="async"
                        width="200"
                        height="150"
                      />
                    </button>
                  ))}
                </div>
              </div>

              <!-- Right: Specs, Pricing & Actions (Span 5) -->
              <div class="lg:col-span-5 space-y-5">
                <div>
                  <span class="text-xs font-sans text-[#7a5813] tracking-widest uppercase font-bold">RIVERSIDE RETREAT</span>
                  <h3 class="font-display text-2xl sm:text-3xl text-[#12281b] font-bold tracking-tight mt-1">
                    {cottage.name}
                  </h3>
                  <p class="font-serif italic text-sm text-[#7a5813] mt-1">
                    {cottage.tagline}
                  </p>
                </div>

                <p class="text-sm text-[#223e2c] leading-relaxed">
                  {cottage.description}
                </p>

                <!-- Detailed Specs List -->
                <div class="space-y-2 py-3 border-y border-[#12281b]/10 text-xs text-[#223e2c]">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Capacity:</span>
                    <span>{cottage.specs.capacity}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Bedding:</span>
                    <span>{cottage.specs.bed}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Balcony:</span>
                    <span>{cottage.specs.outdoor}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Bathroom:</span>
                    <span>{cottage.specs.bath}</span>
                  </div>
                </div>

                <!-- Features Tags -->
                <div class="flex flex-wrap gap-1.5">
                  {cottage.features.map((feat) => (
                    <span class="px-2.5 py-1 rounded-lg bg-white border border-[#12281b]/10 text-[11px] font-sans font-medium text-[#2e5339]">
                      ✓ {feat}
                    </span>
                  ))}
                </div>

                <!-- Booking Action -->
                <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                  <a
                    href={cottage.bookUrl}
                    class="px-6 py-3.5 bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#c99f3e] hover:to-[#ebd082] text-[#12281b] font-bold rounded-xl text-xs font-sans uppercase tracking-wider transition-all shadow-md text-center min-h-[44px] flex items-center justify-center"
                  >
                    Reserve This Cottage →
                  </a>
                  <a
                    href="/contact-khao-sok-riverside-cottages/"
                    class="px-4 py-3.5 border border-[#12281b]/20 hover:border-[#12281b] text-[#12281b] font-medium rounded-xl text-xs font-sans uppercase tracking-wider transition-all text-center min-h-[44px] flex items-center justify-center"
                  >
                    Inquire
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ============================================================
         THE NATURE-CONNECTED STAY & LOCATION ESSENTIALS
    ============================================================ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 shadow-xl space-y-4">
        <span class="text-xs font-sans text-[#7a5813] tracking-widest uppercase font-bold">ECO SANCTUARY</span>
        <h3 class="font-display text-2xl text-[#12281b] font-bold">
          A Nature-Connected Stay
        </h3>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          The cottages at Riverside Cottages are designed with high ceilings, natural ventilation, screened windows, ceiling fans, and mosquito nets. For many guests, the sounds of the river, birds, frogs, and surrounding rainforest become an important part of the overall Khao Sok experience.
        </p>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          This more open and nature-connected style of accommodation allows guests to experience Khao Sok at a slower pace while still enjoying comfort, cleanliness, privacy, and thoughtful hospitality.
        </p>
      </div>

      <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 shadow-xl space-y-4">
        <span class="text-xs font-sans text-[#7a5813] tracking-widest uppercase font-bold">PRIME POSITION</span>
        <h3 class="font-display text-2xl text-[#12281b] font-bold">
          The Perfect Location
        </h3>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          Riverside Cottages is located a few minutes drive from Khao Sok National Park headquarters and approximately one hour from Rajjaprabha Pier, making it easy to explore both the rainforest and nearby lake experiences.
        </p>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          We provide free shuttles to and from Khao Sok village and the public bus stop, so you enjoy total serenity without being stranded.
        </p>
        <div class="pt-2">
          <a href="/khao-sok-map-directions/" class="inline-flex items-center gap-2 text-[#7a5813] font-sans text-xs uppercase tracking-wider font-bold hover:underline min-h-[44px]">
            <span>View Map & Travel Directions</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Google Reviews Verified Widget -->
    <GoogleReviewsWidget />

    <!-- Action Footer Banner -->
    <div class="bg-gradient-to-br from-[#12281b] to-[#1c3d24] text-white rounded-3xl p-8 sm:p-12 text-center space-y-6 shadow-2xl">
      <span class="font-handwriting text-[#f7e6b5] text-2xl sm:text-3xl block">The Wild Spirit of Khao Sok</span>
      <h2 class="font-monumental text-3xl sm:text-4xl text-white tracking-tight">
        Ready to Book Your Riverside Retreat?
      </h2>
      <p class="text-sm sm:text-base text-[#e5f0ea] max-w-xl mx-auto font-light leading-relaxed">
        Reserve directly with no credit card deposit required. Pay only when you arrive at Khao Sok Riverside Cottages.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/booking-khao-sok-accommodation/?tab=room"
          class="px-8 py-4 bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#c99f3e] hover:to-[#ebd082] text-[#12281b] font-bold rounded-xl text-xs font-sans uppercase tracking-wider transition-all shadow-lg min-h-[44px] flex items-center justify-center"
        >
          Book Your Cottage Direct →
        </a>
        <a
          href="/khao-sok-tour-packages/"
          class="px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium rounded-xl text-xs font-sans uppercase tracking-wider transition-all min-h-[44px] flex items-center justify-center"
        >
          Browse All-Inclusive Packages
        </a>
      </div>
    </div>

  </article>

  <!-- Fullscreen Luxury Lightbox Modal -->
  <div
    id="cottage-lightbox"
    class="fixed inset-0 z-[999] hidden bg-black/95 backdrop-blur-md flex items-center justify-center p-4 sm:p-8 select-none"
    role="dialog"
    aria-modal="true"
    aria-label="Image gallery fullscreen preview"
  >
    <!-- Close Button -->
    <button
      id="lightbox-close"
      type="button"
      aria-label="Close fullscreen gallery"
      class="absolute top-5 right-5 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer z-30 backdrop-blur-sm border border-white/20"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Counter & Title -->
    <div class="absolute top-5 left-5 flex items-center gap-3 z-30">
      <span id="lightbox-counter" class="font-sans text-xs text-white/90 bg-black/50 px-3 py-1.5 rounded-full border border-white/15 backdrop-blur-sm font-medium">
        1 / 5
      </span>
      <span id="lightbox-caption" class="hidden sm:inline-block font-display text-sm text-white/80 drop-shadow">
        Cottage Photo
      </span>
    </div>

    <!-- Prev Button -->
    <button
      id="lightbox-prev"
      type="button"
      aria-label="Previous photo"
      class="absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer z-30 backdrop-blur-sm border border-white/20 hover:scale-105"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Next Button -->
    <button
      id="lightbox-next"
      type="button"
      aria-label="Next photo"
      class="absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer z-30 backdrop-blur-sm border border-white/20 hover:scale-105"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Main Lightbox Image Viewport -->
    <div class="relative max-w-6xl max-h-[88vh] flex items-center justify-center overflow-hidden">
      <img
        id="lightbox-img"
        src=""
        alt="Full screen photo"
        class="max-w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl transition-opacity duration-200"
      />
    </div>
  </div>

  <script is:inline>
    (function () {
      function setupGalleries() {
        const galleries = document.querySelectorAll('[data-cottage-gallery]');
        const lightbox = document.getElementById('cottage-lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCounter = document.getElementById('lightbox-counter');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const lightboxClose = document.getElementById('lightbox-close');
        const lightboxPrev = document.getElementById('lightbox-prev');
        const lightboxNext = document.getElementById('lightbox-next');

        let activeLightboxImages = [];
        let activeLightboxIndex = 0;

        function updateLightbox() {
          if (!lightbox || !lightboxImg || !activeLightboxImages.length) return;
          const current = activeLightboxImages[activeLightboxIndex];
          lightboxImg.style.opacity = '0.4';
          lightboxImg.src = current.src;
          lightboxImg.alt = current.alt || 'Cottage view';
          lightboxImg.onload = () => { lightboxImg.style.opacity = '1'; };
          setTimeout(() => { lightboxImg.style.opacity = '1'; }, 100);

          if (lightboxCounter) {
            lightboxCounter.textContent = (activeLightboxIndex + 1) + ' / ' + activeLightboxImages.length;
          }
          if (lightboxCaption) {
            lightboxCaption.textContent = current.alt || '';
          }
        }

        function openLightbox(images, index) {
          if (!lightbox) return;
          activeLightboxImages = images;
          activeLightboxIndex = index;
          updateLightbox();
          lightbox.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          if (!lightbox) return;
          lightbox.classList.add('hidden');
          document.body.style.overflow = '';
        }

        if (lightboxClose) lightboxClose.onclick = closeLightbox;
        if (lightbox) {
          lightbox.onclick = (e) => {
            if (e.target === lightbox || e.target.parentElement === lightbox) {
              closeLightbox();
            }
          };
        }
        if (lightboxPrev) {
          lightboxPrev.onclick = (e) => {
            e.stopPropagation();
            activeLightboxIndex = (activeLightboxIndex - 1 + activeLightboxImages.length) % activeLightboxImages.length;
            updateLightbox();
          };
        }
        if (lightboxNext) {
          lightboxNext.onclick = (e) => {
            e.stopPropagation();
            activeLightboxIndex = (activeLightboxIndex + 1) % activeLightboxImages.length;
            updateLightbox();
          };
        }

        document.addEventListener('keydown', (e) => {
          if (!lightbox || lightbox.classList.contains('hidden')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft') {
            activeLightboxIndex = (activeLightboxIndex - 1 + activeLightboxImages.length) % activeLightboxImages.length;
            updateLightbox();
          }
          if (e.key === 'ArrowRight') {
            activeLightboxIndex = (activeLightboxIndex + 1) % activeLightboxImages.length;
            updateLightbox();
          }
        });

        galleries.forEach((gallery) => {
          if (gallery.dataset.ready === 'true') return;
          gallery.dataset.ready = 'true';

          const mainImg = gallery.querySelector('[data-main-img]');
          const counter = gallery.querySelector('[data-counter]');
          const prevBtn = gallery.querySelector('[data-prev-btn]');
          const nextBtn = gallery.querySelector('[data-next-btn]');
          const mainClick = gallery.querySelector('[data-main-click]');
          const thumbs = Array.from(gallery.querySelectorAll('[data-thumb-btn]'));

          const images = thumbs.map((btn) => ({
            src: btn.getAttribute('data-src') || '',
            alt: btn.getAttribute('data-alt') || '',
          }));

          let currentIndex = 0;

          function setPhoto(idx) {
            if (idx < 0) idx = images.length - 1;
            if (idx >= images.length) idx = 0;
            currentIndex = idx;

            const activeData = images[currentIndex];
            if (!activeData) return;

            if (mainImg) {
              mainImg.style.opacity = '0.4';
              mainImg.src = activeData.src;
              mainImg.alt = activeData.alt;
              mainImg.onload = () => { mainImg.style.opacity = '1'; };
              setTimeout(() => { mainImg.style.opacity = '1'; }, 100);
            }

            if (counter) {
              counter.textContent = (currentIndex + 1) + ' / ' + images.length;
            }

            thumbs.forEach((btn, i) => {
              if (i === currentIndex) {
                btn.classList.remove('opacity-60', 'border', 'border-[#12281b]/15');
                btn.classList.add('ring-2', 'ring-[#ba9038]', 'ring-offset-2', 'ring-offset-[#faf8f5]', 'opacity-100', 'scale-[1.02]', 'shadow-sm');
                btn.setAttribute('aria-selected', 'true');
              } else {
                btn.classList.add('opacity-60', 'border', 'border-[#12281b]/15');
                btn.classList.remove('ring-2', 'ring-[#ba9038]', 'ring-offset-2', 'ring-offset-[#faf8f5]', 'opacity-100', 'scale-[1.02]', 'shadow-sm');
                btn.setAttribute('aria-selected', 'false');
              }
            });
          }

          // Thumbnails click: puts small photo in large!
          thumbs.forEach((btn, i) => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              setPhoto(i);
            });
          });

          // Prev & Next arrows
          if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              setPhoto(currentIndex - 1);
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              setPhoto(currentIndex + 1);
            });
          }

          // Click main image to open lightbox
          if (mainClick) {
            mainClick.addEventListener('click', () => {
              openLightbox(images, currentIndex);
            });
          }

          // Touch swiping on mobile
          let touchStartX = 0;
          let touchEndX = 0;
          gallery.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });
          gallery.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            if (touchStartX - touchEndX > 45) {
              setPhoto(currentIndex + 1); // swipe left -> next
            } else if (touchEndX - touchStartX > 45) {
              setPhoto(currentIndex - 1); // swipe right -> prev
            }
          }, { passive: true });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupGalleries);
      } else {
        setupGalleries();
      }
      document.addEventListener('astro:page-load', setupGalleries);
    })();
  </script>
</PageLayout>
