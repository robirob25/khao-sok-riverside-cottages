---
// src/pages/khao-sok-accommodation/index.astro — Handcrafted Wooden Cottages on the Sok River
// Verbatim Authentic Content & Media from Khao Sok Riverside Cottages
// Elite 2026 Silent Luxury Architecture (Aman / Six Senses Inspired)
import PageLayout from '../../layouts/PageLayout.astro';
import GoogleReviewsWidget from '../../components/GoogleReviewsWidget.astro';

const cottages = [
  {
    id: "garden-view",
    name: "Garden View Cottage",
    tagline: "Comfortable Standalone Wooden Cottages in Botanical Gardens",
    price: "฿1,100",
    priceNote: "per night · 1-2 guests",
    badge: "Most Popular",
    heroImg: "/wp-content/uploads/2025/07/cottage-1.jpg",
    gallery: [
      "/wp-content/uploads/2025/07/cottage-2.jpg",
      "/wp-content/uploads/2025/07/cottage-3-scaled.jpg",
      "/wp-content/uploads/2025/07/cottage-4.jpg",
      "/wp-content/uploads/2025/07/cottage-5.jpg",
    ],
    description: "Comfortable standalone wooden cottages ideal for couples or solo travellers wanting a peaceful stay surrounded by nature. Designed with natural cross-ventilation, shaded verandas, and authentic tropical materials.",
    specs: {
      capacity: "Ideal for 2 guests",
      bed: "1 King bed or 2 Twin beds",
      climate: "Ceiling fan or Air Conditioning options",
      outdoor: "Private balcony with hammock overlooking lush jungle gardens",
      bath: "Private en-suite bathroom with hot water shower",
    },
    features: ["Private Balcony & Hammock", "En-suite Bathroom & Hot Shower", "Ceiling Fan / AC", "Garden View", "Free Wi-Fi", "Mosquito Netting"],
    bookUrl: "/booking-khao-sok-accommodation/?tab=room",
  },
  {
    id: "riverside",
    name: "Riverside Cottage",
    tagline: "Direct Riverfront Views & Sounds of Flowing Water",
    price: "฿1,400",
    priceNote: "per night · 1-2 guests",
    badge: "Prime Riverfront",
    heroImg: "/wp-content/uploads/2025/07/deluxe-cottage-1.jpg",
    gallery: [
      "/wp-content/uploads/2025/07/deluxe-cottage-2.jpg",
      "/wp-content/uploads/2025/07/deluxe-cottage-3.jpg",
      "/wp-content/uploads/2025/07/deluxe-cottage-4.jpg",
      "/wp-content/uploads/2025/07/deluxe-cottage-5.jpg",
    ],
    description: "Our most sought-after room category. Perched directly beside the Sok River with dramatic views of limestone karst cliffs. Relax in your private hammock listening to the gentle flow of the river.",
    specs: {
      capacity: "Ideal for 2 guests",
      bed: "1 King bed",
      climate: "Natural river breeze, ceiling fan and Air Conditioning",
      outdoor: "Private waterfront balcony with hammock directly above riverbank",
      bath: "En-suite bathroom with hot water shower",
    },
    features: ["Direct River & Karst Views", "Private Riverfront Balcony", "Air Conditioning", "En-suite Hot Shower", "Hammock Over River", "Free Wi-Fi"],
    bookUrl: "/booking-khao-sok-accommodation/?tab=room",
  },
  {
    id: "family",
    name: "Family Wooden Cottage",
    tagline: "Spacious Multi-Bed Lodging for Families & Small Groups",
    price: "฿2,000",
    priceNote: "per night · Up to 4 guests",
    badge: "Family & Groups",
    heroImg: "/wp-content/uploads/2025/07/family-cottage-1.jpg",
    gallery: [
      "/wp-content/uploads/2025/07/family-cottage-2.jpg",
      "/wp-content/uploads/2025/07/family-cottage-3.jpg",
      "/wp-content/uploads/2025/07/family-cottage-4.jpg",
      "/wp-content/uploads/2025/07/family-cottage-6.jpg",
    ],
    description: "Extra-spacious wooden chalets designed for families with children or friends travelling together. Large en-suite bathroom, expansive balcony, and plenty of room to unwind together after a day exploring the national park.",
    specs: {
      capacity: "Up to 4 guests",
      bed: "2 Queen beds or 1 King + 2 Bunk beds",
      climate: "Ceiling fans & Air Conditioning",
      outdoor: "Large covered family deck with seating & forest outlook",
      bath: "Spacious private bathroom with hot shower",
    },
    features: ["Sleeps up to 4 Guests", "Spacious Family Balcony", "Air Conditioning & Hot Shower", "Secluded Jungle Setting", "Child Friendly", "Free Wi-Fi"],
    bookUrl: "/booking-khao-sok-accommodation/?tab=room",
  },
];
---

<PageLayout
  title="Khao Sok Accommodation — Handcrafted Cottages on the Sok River"
  description="Explore Khao Sok accommodation options that offer comfort, nature, and convenience near the National Park. Traditional Thai wooden cottages beside the Sok River."
  heroImage="/wp-content/uploads/2025/07/cottage-1.jpg"
  heroTitle="Khao Sok Accommodation"
  heroSubtitle="Handcrafted Wooden Lodging Beside the Sok River"
  breadcrumbs={[{"label": "Khao Sok Accommodation", "href": "/khao-sok-accommodation/"}]}
>
  <article class="max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Top Editorial Dispatch Card -->
    <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 md:p-12 shadow-2xl backdrop-blur-md">
      
      <div class="flex items-center justify-between border-b border-[#12281b]/10 pb-4 mb-8 font-mono text-[11px] tracking-[0.22em] uppercase text-[#163824]">
        <div class="flex items-center gap-2 font-semibold">
          <span class="text-[#7a5813]">KSR</span>
          <span class="text-[#12281b]/20">/</span>
          <span>FIELD DISPATCH</span>
        </div>
        <span class="text-[#7a5813] font-bold">KHAO SOK · THAILAND</span>
      </div>

      <div class="max-w-3xl space-y-5 text-[#223e2c] text-base sm:text-lg leading-relaxed font-normal">
        <h2 class="font-display text-2xl sm:text-4xl text-[#163824] font-semibold tracking-tight">
          Riverside Cottages Accommodation
        </h2>
        <p class="leading-relaxed">
          Set beside the Sok River and surrounded by tropical forest, the wooden cottages at Riverside Cottages offer a more relaxed and nature-connected style of accommodation in Khao Sok. Designed around natural airflow, shaded gardens, and open-air tropical living, the cottages allow guests to experience the sounds, atmosphere, and slower pace of the rainforest while still enjoying comfort, privacy, and thoughtful hospitality.
        </p>
        <p class="leading-relaxed">
          Whether travelling as a couple, family, or small group, our cottages provide a peaceful base for exploring Khao Sok National Park, Cheow Lan Lake, jungle hikes, canoe trips, and local experiences.
        </p>
      </div>

      <!-- Key Inclusions Bento Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8 pt-8 border-t border-[#12281b]/10">
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#12281b]/10 shadow-sm">
          <span class="w-8 h-8 rounded-full bg-[#ba9038]/20 flex items-center justify-center text-[#7a5813] font-bold text-sm shrink-0">🚐</span>
          <div>
            <span class="block font-semibold text-sm text-[#12281b]">Free Shuttle Service</span>
            <span class="text-xs text-[#2e5339]">Complimentary transfers to Khao Sok village and bus stop</span>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#12281b]/10 shadow-sm">
          <span class="w-8 h-8 rounded-full bg-[#ba9038]/20 flex items-center justify-center text-[#7a5813] font-bold text-sm shrink-0">🧭</span>
          <div>
            <span class="block font-semibold text-sm text-[#12281b]">Tour Desk & Concierge</span>
            <span class="text-xs text-[#2e5339]">Full assistance booking park guides, lake trips & safaris</span>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-white border border-[#12281b]/10 shadow-sm">
          <span class="w-8 h-8 rounded-full bg-[#ba9038]/20 flex items-center justify-center text-[#7a5813] font-bold text-sm shrink-0">🌿</span>
          <div>
            <span class="block font-semibold text-sm text-[#12281b]">Riverside Restaurant</span>
            <span class="text-xs text-[#2e5339]">Rafflesia Cafe with Thai and Western dishes beside the river</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         THE 3 COTTAGES SHOWCASES (LUXURY CARDS WITH PHOTO GALLERIES)
    ============================================================ -->
    <div class="space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#ba9038] font-bold">LODGING SELECTION</span>
        <h2 class="font-monumental text-3xl sm:text-4xl text-[#12281b] tracking-tight">
          Handcrafted Wooden Cottages
        </h2>
        <p class="text-sm sm:text-base text-[#2e5339]">
          Select your preferred cottage style. Pay upon arrival with zero advance deposit required.
        </p>
      </div>

      <div class="space-y-10">
        {cottages.map((cottage, idx) => (
          <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-2xl backdrop-blur-md overflow-hidden relative">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              
              <!-- Left: Image Gallery & Badges (Span 7) -->
              <div class="lg:col-span-7 space-y-4">
                <div class="relative rounded-2xl overflow-hidden shadow-xl border border-[#12281b]/10 aspect-[16/10] group">
                  <img
                    src={cottage.heroImg}
                    alt={cottage.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter brightness-[1.02]"
                    loading="lazy"
                    decoding="async"
                    width="1200"
                    height="750"
                  />
                  <div class="absolute top-4 left-4 flex gap-2">
                    <span class="px-3 py-1 rounded-full bg-[#12281b]/90 text-white font-mono text-[10px] uppercase tracking-wider font-semibold backdrop-blur-md border border-white/20">
                      {cottage.badge}
                    </span>
                  </div>
                  <div class="absolute bottom-4 right-4 px-3.5 py-1.5 rounded-xl bg-white/95 text-[#12281b] font-mono text-xs font-bold shadow-lg backdrop-blur-md border border-[#12281b]/10">
                    {cottage.price} <span class="font-normal text-[10px] text-[#2e5339]">/ night</span>
                  </div>
                </div>

                <!-- 4 Thumbnails Gallery -->
                <div class="grid grid-cols-4 gap-2 sm:gap-3">
                  {cottage.gallery.map((thumbImg, tIdx) => (
                    <div class="relative rounded-xl overflow-hidden aspect-video border border-[#12281b]/10 shadow-sm group cursor-pointer bg-black">
                      <img
                        src={thumbImg}
                        alt={`${cottage.name} photo ${tIdx + 1}`}
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 filter brightness-[0.98]"
                        loading="lazy"
                        decoding="async"
                        width="400"
                        height="260"
                      />
                    </div>
                  ))}
                </div>
              </div>

              <!-- Right: Specs, Pricing & Actions (Span 5) -->
              <div class="lg:col-span-5 space-y-5">
                <div>
                  <span class="text-xs font-mono text-[#ba9038] tracking-widest uppercase font-semibold">0{idx + 1} · ACCOMMODATION</span>
                  <h3 class="font-display text-2xl sm:text-3xl text-[#12281b] font-bold tracking-tight mt-1">
                    {cottage.name}
                  </h3>
                  <p class="font-serif italic text-sm text-[#7a5813] mt-1">
                    {cottage.tagline}
                  </p>
                </div>

                <p class="text-sm text-[#223e2c] leading-relaxed">
                  {cottage.description}
                </p>

                <!-- Detailed Specs List -->
                <div class="space-y-2 py-3 border-y border-[#12281b]/10 text-xs text-[#223e2c]">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Capacity:</span>
                    <span>{cottage.specs.capacity}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Bedding:</span>
                    <span>{cottage.specs.bed}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Balcony:</span>
                    <span>{cottage.specs.outdoor}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-[#12281b] w-20 shrink-0">Bathroom:</span>
                    <span>{cottage.specs.bath}</span>
                  </div>
                </div>

                <!-- Features Tags -->
                <div class="flex flex-wrap gap-1.5">
                  {cottage.features.map((feat) => (
                    <span class="px-2.5 py-1 rounded-lg bg-white border border-[#12281b]/10 text-[11px] font-mono text-[#2e5339]">
                      ✓ {feat}
                    </span>
                  ))}
                </div>

                <!-- Booking Action -->
                <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                  <a
                    href={cottage.bookUrl}
                    class="px-6 py-3.5 bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#c99f3e] hover:to-[#ebd082] text-[#12281b] font-bold rounded-xl text-xs font-mono uppercase tracking-wider transition-all shadow-md text-center"
                  >
                    Reserve This Cottage →
                  </a>
                  <a
                    href="/contact-khao-sok-riverside-cottages/"
                    class="px-4 py-3.5 border border-[#12281b]/20 hover:border-[#12281b] text-[#12281b] font-medium rounded-xl text-xs font-mono uppercase tracking-wider transition-all text-center"
                  >
                    Inquire
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ============================================================
         THE NATURE-CONNECTED STAY & LOCATION ESSENTIALS
    ============================================================ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 shadow-xl space-y-4">
        <span class="text-xs font-mono text-[#ba9038] tracking-widest uppercase font-semibold">ECO SANCTUARY</span>
        <h3 class="font-display text-2xl text-[#12281b] font-bold">
          A Nature-Connected Stay
        </h3>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          The cottages at Riverside Cottages are designed with high ceilings, natural ventilation, screened windows, ceiling fans, and mosquito nets. For many guests, the sounds of the river, birds, frogs, and surrounding rainforest become an important part of the overall Khao Sok experience.
        </p>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          This more open and nature-connected style of accommodation allows guests to experience Khao Sok at a slower pace while still enjoying comfort, cleanliness, privacy, and thoughtful hospitality.
        </p>
      </div>

      <div class="bg-[#faf8f5]/95 border border-[#12281b]/10 rounded-3xl p-6 sm:p-10 shadow-xl space-y-4">
        <span class="text-xs font-mono text-[#ba9038] tracking-widest uppercase font-semibold">PRIME POSITION</span>
        <h3 class="font-display text-2xl text-[#12281b] font-bold">
          The Perfect Location
        </h3>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          Riverside Cottages is located a few minutes drive from Khao Sok National Park headquarters and approximately one hour from Rajjaprabha Pier, making it easy to explore both the rainforest and nearby lake experiences.
        </p>
        <p class="text-sm sm:text-base text-[#223e2c] leading-relaxed">
          We provide free shuttles to and from Khao Sok village and the public bus stop, so you enjoy total serenity without being stranded.
        </p>
        <div class="pt-2">
          <a href="/khao-sok-map-directions/" class="inline-flex items-center gap-2 text-[#7a5813] font-mono text-xs uppercase tracking-wider font-bold hover:underline">
            <span>View Map & Travel Directions</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Google Reviews Verified Widget -->
    <GoogleReviewsWidget />

    <!-- Action Footer Banner -->
    <div class="bg-gradient-to-br from-[#12281b] to-[#1c3d24] text-white rounded-3xl p-8 sm:p-12 text-center space-y-6 shadow-2xl">
      <span class="font-handwriting text-[#f7e6b5] text-2xl sm:text-3xl block">The Wild Spirit of Khao Sok</span>
      <h2 class="font-monumental text-3xl sm:text-4xl text-white tracking-tight">
        Ready to Book Your Riverside Retreat?
      </h2>
      <p class="text-sm sm:text-base text-[#e5f0ea] max-w-xl mx-auto font-light leading-relaxed">
        Reserve directly with no credit card deposit required. Pay only when you arrive at Khao Sok Riverside Cottages.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/booking-khao-sok-accommodation/?tab=room"
          class="px-8 py-4 bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#c99f3e] hover:to-[#ebd082] text-[#12281b] font-bold rounded-xl text-xs font-mono uppercase tracking-wider transition-all shadow-lg"
        >
          Book Your Cottage Direct →
        </a>
        <a
          href="/khao-sok-tour-packages/"
          class="px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium rounded-xl text-xs font-mono uppercase tracking-wider transition-all"
        >
          Browse All-Inclusive Packages
        </a>
      </div>
    </div>

  </article>
</PageLayout>
