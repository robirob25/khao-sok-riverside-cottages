---
// BookingSplitExperience.astro — 2026 Elite Dual Booking Architecture
// Splits reservations into 2 clear pillars:
// 1. BOOK A PACKAGE (Highlighted / Recommended · All-Inclusive: Resort + Lake + Safaris)
// 2. BOOK A ROOM ONLY (Flexible Stay · Handcrafted Wooden Cottages)
// Faithful to Khao Sok Riverside Cottages' Honor System (No deposit, pay on arrival)
import GoogleReviewsWidget from './GoogleReviewsWidget.astro';

interface Props {
  defaultTab?: 'package' | 'room';
}

const { defaultTab = 'package' } = Astro.props;

const tourPackages = [
  {
    id: "grand-jungle",
    title: "4D / 3N Grand Jungle & Lake Overnight",
    tagline: "The Ultimate Rainforest & Cheow Lan Lake Expedition",
    price: "฿7,100",
    priceNote: "per person · All-Inclusive",
    duration: "4 Days / 3 Nights",
    stay: "2 Nights Riverside Cottages + 1 Night Floating Lake House",
    badge: "Signature Expedition",
    popular: true,
    img: "/wp-content/uploads/2025/01/Grand-Jungle-Cover.jpg",
    highlights: [
      "2 Nights Wooden Cottages + 1 Night Lake Floating Bungalow",
      "Elephant Bathing & Mud Spa Sanctuary Experience",
      "Cheow Lan Lake Scenic Longtail Boat Tour & Wildlife Safari",
      "Pakarang (Coral) Cave Hike & Bamboo Raft Journey",
      "Night Safari in Khlong Phanom & Sok River Tubing",
      "All meals included from Day 1 dinner to Day 4 lunch",
    ],
    beds24Url: "https://beds24.com/booking2.php?propid=42681",
  },
  {
    id: "lake-rafthouse",
    title: "3D / 2N Riverside & Lake Rafthouse",
    tagline: "The Perfect Balance of Riverfront & Lake Wilderness",
    price: "฿5,400",
    priceNote: "per person · All-Inclusive",
    duration: "3 Days / 2 Nights",
    stay: "1 Night Riverside Cottages + 1 Night Floating Lake House",
    badge: "Lake Overnight",
    popular: false,
    img: "/wp-content/uploads/2025/01/Riverside-Rafthouse-Cover.jpg",
    highlights: [
      "1 Night Riverside Cottages + 1 Night Floating Bungalow",
      "Scenic Lake Longtail Boat Tour past Karst Limestone Peaks",
      "Guided Rainforest Trekking & Cave Exploration",
      "Early Morning Wildlife Mist Safari by Boat",
      "Free Swimming & Kayaking directly from your Raft Porch",
      "5 freshly prepared Thai meals included",
    ],
    beds24Url: "https://beds24.com/booking2.php?propid=42681",
  },
  {
    id: "rainforest-adventure",
    title: "3D / 2N Rainforest Adventure",
    tagline: "Ethical Elephant Encounters & Deep Jungle Immersion",
    price: "฿5,200",
