    stay: "2 Nights Riverside Cottages",
    badge: "Family & Wildlife",
    popular: false,
    img: "/wp-content/uploads/2025/09/rainforest-adventure-package-cover.jpg",
    highlights: [
      "2 Nights Handcrafted Wooden Cottages beside the river",
      "Ethical Elephant Bathing, Feeding & Mud Treatment",
      "Guided Sok River Canoe Trip with local paddler",
      "Rainforest Night Safari spotting nocturnal wildlife",
      "Traditional Thai Cooking Class & Organic Farm Visit",
      "Fresh daily breakfast & dinners included",
    ],
    beds24Url: "https://beds24.com/booking2.php?propid=42681",
  },
  {
    id: "delight",
    title: "3D / 2N Khao Sok Delight",
    tagline: "Full-Day Lake Tour & Sok River Exploration",
    price: "฿4,500",
    priceNote: "per person · All-Inclusive",
    duration: "3 Days / 2 Nights",
    stay: "2 Nights Riverside Cottages",
    badge: "Top Highlights",
    popular: false,
    img: "/wp-content/uploads/2025/01/delight-cover.jpg",
    highlights: [
      "2 Nights Handcrafted Wooden Cottages beside the river",
      "Full-Day Cheow Lan Lake Excursion with floating lunch",
      "Relaxing Sok River Tubing or Guided Canoe Safari",
      "Night Safari in search of civets, frogs and owls",
      "Ideal for travelers who prefer sleeping in the resort each night",
      "Breakfasts & authentic Thai dinners included",
    ],
