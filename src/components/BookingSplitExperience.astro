</div>

<!-- Client-side vanilla JS for dual switching, URL parameter support & instant form handling -->
<script is:inline>
  (function initBookingTabs() {
    const btnPackage = document.getElementById('btn-tab-package');
    const btnRoom = document.getElementById('btn-tab-room');
    const panelPackage = document.getElementById('panel-package');
    const panelRoom = document.getElementById('panel-room');
    const pkgSelect = document.getElementById('pkg-select');
    const roomSelect = document.getElementById('room-select');
    const modal = document.getElementById('booking-success-modal');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const modalSummary = document.getElementById('modal-summary-text');

    function setActiveTab(tab) {
      if (!btnPackage || !btnRoom || !panelPackage || !panelRoom) return;

      if (tab === 'room') {
        btnRoom.setAttribute('data-active', 'true');
        btnPackage.setAttribute('data-active', 'false');
        panelPackage.classList.add('hidden');
        panelRoom.classList.remove('hidden');
      } else {
        btnPackage.setAttribute('data-active', 'true');
        btnRoom.setAttribute('data-active', 'false');
        panelRoom.classList.add('hidden');
        panelPackage.classList.remove('hidden');
      }
    }

    if (btnPackage) {
      btnPackage.addEventListener('click', () => {
        setActiveTab('package');
        history.replaceState(null, '', '?tab=package');
      });
    }

    if (btnRoom) {
      btnRoom.addEventListener('click', () => {
        setActiveTab('room');
        history.replaceState(null, '', '?tab=room');
      });
    }

    // Check URL search parameters on load (?tab=room or ?tab=package)
    const urlParams = new URLSearchParams(window.location.search);
    const initialTab = urlParams.get('tab');
    if (initialTab === 'room') {
      setActiveTab('room');
    } else {
      setActiveTab('package');
    }

    // Package selection cards click handler
    document.querySelectorAll('.package-select-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        const pkgId = card.getAttribute('data-package-id');
        if (pkgSelect && pkgId) {
          pkgSelect.value = pkgId;
        }
        // Smooth scroll to form
        const formElem = document.getElementById('package-reservation-form-container');
        if (formElem) {
          formElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Room selection cards click handler
    document.querySelectorAll('.room-select-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        const roomId = card.getAttribute('data-room-id');
        if (roomSelect && roomId) {
          roomSelect.value = roomId;
        }
        // Smooth scroll to form
        const formElem = document.getElementById('room-reservation-form-container');
        if (formElem) {
          formElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    function validateInputs(fieldIds, errorElId) {
      const errorEl = document.getElementById(errorElId);
      let isValid = true;
      let firstInvalid = null;

      fieldIds.forEach((id) => {
        const input = document.getElementById(id);
        if (!input) return;
        const val = (input.value || '').trim();
        if (!val) {
          isValid = false;
          input.classList.add('border-red-500', 'ring-2', 'ring-red-400/20', 'bg-red-50/20');
          if (!firstInvalid) firstInvalid = input;

          const clearFn = () => {
            input.classList.remove('border-red-500', 'ring-2', 'ring-red-400/20', 'bg-red-50/20');
            if (errorEl) errorEl.classList.add('hidden');
          };
          input.addEventListener('input', clearFn, { once: true });
          input.addEventListener('change', clearFn, { once: true });
        } else {
          input.classList.remove('border-red-500', 'ring-2', 'ring-red-400/20', 'bg-red-50/20');
        }
      });

      if (!isValid) {
        if (errorEl) errorEl.classList.remove('hidden');
        if (firstInvalid) {
          firstInvalid.focus();
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } else {
        if (errorEl) errorEl.classList.add('hidden');
      }

      return isValid;
    }

    // Handle Form Submissions (Package)
    const formPackage = document.getElementById('form-book-package');
    if (formPackage) {
      formPackage.addEventListener('submit', (e) => {
        e.preventDefault();
        const requiredIds = ['pkg-date', 'pkg-name', 'pkg-email', 'pkg-phone'];
        if (!validateInputs(requiredIds, 'pkg-form-error')) {
          return;
        }

        const guestName = (document.getElementById('pkg-name')?.value || 'Guest').trim();
        const pkgTitle = pkgSelect ? pkgSelect.options[pkgSelect.selectedIndex].text.split('—')[0].trim() : 'Tour Package';
        if (modalSummary) {
          modalSummary.textContent = `Thank you ${guestName}! We have received your request for the "${pkgTitle}". Bodhi, Tu & the Riverside team will confirm availability and send transfer instructions within 12 hours.`;
        }
        openModal();
      });
    }

    // Handle Form Submissions (Room)
    const formRoom = document.getElementById('form-book-room');
    if (formRoom) {
      formRoom.addEventListener('submit', (e) => {
        e.preventDefault();
        const requiredIds = ['room-checkin', 'room-checkout', 'room-name', 'room-email', 'room-phone'];
        if (!validateInputs(requiredIds, 'room-form-error')) {
          return;
        }

        const guestName = (document.getElementById('room-name')?.value || 'Guest').trim();
        const roomName = roomSelect ? roomSelect.options[roomSelect.selectedIndex].text.split('—')[0].trim() : 'Cottage';
        if (modalSummary) {
          modalSummary.textContent = `Thank you ${guestName}! We have received your stay request for the "${roomName}". We will confirm your dates and bus stop pickup within 12 hours.`;
        }
        openModal();
      });
    }

    function openModal() {
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      const inner = modal.querySelector('div');
      if (inner) inner.classList.remove('scale-95');
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      const inner = modal.querySelector('div');
      if (inner) inner.classList.add('scale-95');
    }

    if (btnCloseModal) {
      btnCloseModal.addEventListener('click', closeModal);
    }
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
  })();
</script>

