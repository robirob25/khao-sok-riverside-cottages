    priceNote: "per person · All-Inclusive",
    duration: "2 Days / 1 Night",
    stay: "1 Night Riverside Cottages",
    badge: "Essential 2-Day",
    popular: false,
    img: "/wp-content/uploads/2025/01/spirit-cover.jpg",
    highlights: [
      "1 Night Handcrafted Wooden Cottage",
      "Exciting Sok River Tubing Adventure",
      "Guided Jungle Night Safari",
      "Free time to swim and relax by the Sok River",
      "Delicious Thai Dinner & Fresh Breakfast",
    ],
    beds24Url: "https://beds24.com/booking2.php?propid=279807",
  },
];

const roomTypes = [
  {
    id: "garden-view",
    name: "Garden View Cottage",
    price: "฿1,100",
    priceNote: "per night · 1-2 guests",
    bed: "1 King Bed or 2 Twin Beds",
    img: "/wp-content/uploads/2025/07/cottage-1.jpg",
    desc: "Spacious freestanding wooden cottage nestled in tropical botanical gardens. Features a private covered balcony with hammock, hot water shower, mosquito netting, and gentle ceiling fans or AC.",
    features: ["Private Balcony & Hammock", "En-suite Bathroom & Hot Shower", "Air Conditioning or Fan", "Garden View", "Free Wi-Fi"],
  },
  {
    id: "riverside",
    name: "Riverside Cottage",
    price: "฿1,400",
    priceNote: "per night · 1-2 guests",
    bed: "1 King Bed",
    img: "/wp-content/uploads/2025/07/deluxe-cottage-1.jpg",
    desc: "Our most sought-after room category. Perched directly above the clear waters of the Sok River, with panoramic views of ancient limestone karst cliffs and the sounds of the flowing river.",
    features: ["Direct River & Karst Views", "Private Riverfront Balcony", "Air Conditioning", "En-suite Hot Shower", "Hammock Over River"],
  },
  {
    id: "family",
    name: "Family Wooden Cottage",
    price: "฿2,000",
    priceNote: "per night · Up to 4 guests",
    bed: "2 Queen Beds or 1 King + 2 Bunks",
    img: "/wp-content/uploads/2025/07/family-cottage-1.jpg",
    desc: "Extra-spacious wooden chalets designed for families with children or friends travelling together. Large en-suite bathroom, expansive balcony, and plenty of space to relax together.",
    features: ["Sleeps up to 4 Guests", "Spacious Family Balcony", "Air Conditioning & Hot Shower", "Secluded Jungle Setting", "Child Friendly"],
  },
];
---

<div class="space-y-12" id="booking-experience-root">
  
  <!-- ============================================================
       TOP VALUE PROPOSITION & HONOR SYSTEM BADGE
  ============================================================ -->
  <div class="bg-gradient-to-br from-[#12281b] to-[#1e442c] rounded-3xl p-6 sm:p-8 md:p-10 text-white shadow-xl relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-[#ba9038]/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ba9038]/20 border border-[#ba9038]/40 text-[#d8b257] text-xs font-mono uppercase tracking-[0.2em] font-semibold">
          <span>The Khao Sok Honor System</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-[#faf8f5]">
          Book With Complete Confidence
        </h2>
        <p class="text-sm sm:text-base text-[#e5f0ea] leading-relaxed font-light">
          <strong>No advance deposits or credit card pre-payments required.</strong> We rely on mutual trust — simply pay upon arrival at Khao Sok Riverside Cottages. Guaranteed lowest direct prices.
        </p>
      </div>

      <!-- Quick Stats Capsule -->
      <div class="grid grid-cols-2 gap-3 sm:gap-4 shrink-0 bg-white/10 p-4 sm:p-5 rounded-2xl border border-white/15 backdrop-blur-md">
        <div class="text-center sm:text-left">
          <div class="text-xl sm:text-2xl font-monumental font-bold text-[#d8b257]">4.4 / 5</div>
          <div class="text-[11px] font-mono uppercase tracking-wider text-[#abd0bb]">564+ Google Reviews</div>
        </div>
        <div class="text-center sm:text-left border-l border-white/10 pl-3 sm:pl-4">
          <div class="text-xl sm:text-2xl font-monumental font-bold text-[#d8b257]">8.9 / 10</div>
          <div class="text-[11px] font-mono uppercase tracking-wider text-[#abd0bb]">Booking.com Fabulous</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       SCISSION EN 2 : DUAL PILLAR SELECTOR TABS
       1. BOOK A PACKAGE (Highlight / Recommended)
       2. BOOK A ROOM (Flexible Stay)
  ============================================================ -->
  <div class="space-y-6">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="text-xs font-mono text-[#ba9038] uppercase tracking-[0.25em] font-bold">Select Your Booking Experience</span>
      <h3 class="font-display text-2xl sm:text-3xl text-[#12281b] font-semibold tracking-tight">
        Choose How You Wish to Stay
      </h3>
      <p class="text-sm text-[#2e5339]">
        90% of our guests choose an all-inclusive package to include Cheow Lan Lake floating bungalows, wildlife safaris, and meals with zero hassle.
      </p>
    </div>

    <!-- Dual Tab Switcher Buttons (2026 Tactile Luxury Switch) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl mx-auto p-2 rounded-3xl bg-[#f4efeb] border border-[#12281b]/10 shadow-inner">
      
      <!-- Tab 1: BOOK A PACKAGE (Highlighted & Recommended) -->
      <button
        type="button"
        id="btn-tab-package"
        class="tab-switch-btn group relative p-5 sm:p-6 rounded-2xl text-left transition-all duration-300 flex items-start justify-between gap-3 shadow-sm cursor-pointer"
        data-target="package"
        data-active="true"
      >
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="tab-badge px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider font-bold transition-colors">
              Most Popular · Best Value
            </span>
          </div>
          <h4 class="tab-title font-display text-lg sm:text-xl font-bold tracking-tight transition-colors">
            Book a Tour Package
          </h4>
          <p class="tab-desc text-xs leading-relaxed transition-colors">
            Resort cottages + Cheow Lan Lake floating house + safaris + all meals.
          </p>
          <div class="tab-price pt-1 text-xs font-mono font-semibold transition-colors">
            From ฿2,300 to ฿7,100 / person
          </div>
        </div>
        <span class="tab-indicator w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs shrink-0 mt-1 shadow-sm transition-all">
          ✓
        </span>
      </button>

      <!-- Tab 2: BOOK A ROOM ONLY -->
      <button
        type="button"
        id="btn-tab-room"
        class="tab-switch-btn group relative p-5 sm:p-6 rounded-2xl text-left transition-all duration-300 flex items-start justify-between gap-3 cursor-pointer"
        data-target="room"
        data-active="false"
      >
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="tab-badge px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider font-bold transition-colors">
              Flexible Stay
            </span>
          </div>
          <h4 class="tab-title font-display text-lg sm:text-xl font-semibold tracking-tight transition-colors">
            Book a Room Only
          </h4>
          <p class="tab-desc text-xs leading-relaxed transition-colors">
            Handcrafted wooden cottages nestled on the Sok River. Tours booked on-site.
          </p>
          <div class="tab-price pt-1 text-xs font-mono font-semibold transition-colors">
            From ฿1,100 to ฿2,000 / night
          </div>
        </div>
        <span class="tab-indicator w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs shrink-0 mt-1 transition-all">
          ✓
        </span>
      </button>

    </div>
  </div>

  <!-- ============================================================
       PILLAR 1 : BOOK A TOUR PACKAGE (Recommended View)
  ============================================================ -->
  <div id="panel-package" class="booking-panel space-y-10 transition-all duration-300">
    
    <!-- Intro Banner -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white border border-[#12281b]/10 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-[#ba9038] text-xs font-mono uppercase tracking-widest font-semibold">
          <span>01 / ALL-INCLUSIVE EXPEDITIONS</span>
        </div>
        <h3 class="font-display text-2xl sm:text-3xl text-[#12281b] font-semibold tracking-tight">
          Select Your Tour & Safari Package
        </h3>
        <p class="text-sm text-[#223e2c] max-w-2xl leading-relaxed">
          Click a package below to inspect the itinerary and pre-fill your reservation request. All packages include riverside accommodation, national park excursions, professional local guides, and authentic freshly-cooked meals.
        </p>
      </div>

      <a
        href="/khao-sok-tour-packages/"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[#ba9038] hover:text-[#12281b] font-bold shrink-0 self-start md:self-center"
      >
        <span>Compare Full Package Itineraries</span>
        <span>→</span>
      </a>
    </div>

    <!-- Interactive Package Selection Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tourPackages.map((pkg, idx) => (
        <div
          class={`package-select-card group relative rounded-3xl bg-white border cursor-pointer transition-all duration-300 overflow-hidden flex flex-col justify-between shadow-sm hover:shadow-xl ${
            pkg.popular ? "border-[#ba9038] ring-2 ring-[#ba9038]/30" : "border-[#12281b]/10 hover:border-[#ba9038]"
          }`}
          data-package-id={pkg.id}
          data-package-title={pkg.title}
        >
          <!-- Card Image & Badges -->
          <div class="relative h-52 overflow-hidden bg-slate-900">
            <img
              src={pkg.img}
              alt={pkg.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>
            
            <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
              <span class="px-2.5 py-1 rounded-full bg-[#12281b]/90 backdrop-blur-md text-[#d8b257] text-[10px] font-mono uppercase tracking-wider font-bold border border-[#ba9038]/40">
                {pkg.badge}
              </span>
              {pkg.popular && (
                <span class="px-2.5 py-1 rounded-full bg-[#ba9038] text-[#12281b] text-[10px] font-mono uppercase tracking-wider font-bold shadow-sm">
                  Most Popular
                </span>
              )}
            </div>

            <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between text-white">
              <div>
                <span class="text-xs font-mono uppercase tracking-widest text-[#abd0bb]">{pkg.duration}</span>
                <div class="text-xl font-monumental font-bold text-[#faf8f5]">{pkg.price}</div>
              </div>
              <span class="text-[11px] font-mono text-[#e5f0ea]/80">{pkg.priceNote}</span>
            </div>
          </div>

          <!-- Card Content & Highlights -->
          <div class="p-6 space-y-4 flex-1 flex flex-col justify-between">
            <div class="space-y-2">
              <h4 class="font-display text-lg font-bold text-[#163824] group-hover:text-[#ba9038] transition-colors leading-snug">
                {pkg.title}
              </h4>
              <p class="text-xs text-[#2e5339] font-medium italic">
                {pkg.stay}
              </p>
              
              <!-- Highlights list -->
              <ul class="space-y-1.5 pt-2 border-t border-[#12281b]/5 text-xs text-[#223e2c]">
                {pkg.highlights.slice(0, 3).map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#2e6b45] font-bold mt-0.5">✓</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action Button -->
            <div class="pt-4 border-t border-[#12281b]/10 flex items-center justify-between gap-3">
              <button
                type="button"
                class="btn-select-package w-full py-2.5 px-4 rounded-xl bg-[#faf8f5] hover:bg-[#12281b] border border-[#12281b]/15 text-[#12281b] hover:text-white font-mono text-xs uppercase tracking-wider font-bold transition-all text-center"
              >
                Select This Package
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Package Reservation Form Box -->
    <div id="package-reservation-form-container" class="rounded-3xl bg-white border border-[#12281b]/15 p-6 sm:p-10 md:p-12 shadow-xl space-y-8 scroll-mt-24">
      <div class="border-b border-[#12281b]/10 pb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#2e6b45]/10 text-[#2e6b45] text-xs font-mono uppercase tracking-wider font-semibold mb-2">
            <span>Direct Inquiry Form</span>
          </div>
          <h3 class="font-display text-2xl sm:text-3xl text-[#12281b] font-semibold tracking-tight">
            Reserve Your Tour Package
          </h3>
          <p class="text-sm text-[#2e5339] mt-1">
            Fill out your details below. Our reservation desk will confirm availability and send your itinerary within 12 hours.
          </p>
        </div>

        <div class="text-xs font-mono text-[#8a6b25] bg-[#ba9038]/10 px-3.5 py-2 rounded-xl border border-[#ba9038]/20 shrink-0">
          ✓ Honor System: Pay on Arrival
        </div>
      </div>

      <form id="form-book-package" novalidate class="space-y-6">
        <!-- Row 1: Selected Package -->
        <div class="space-y-2">
          <label for="pkg-select" class="block text-xs font-mono uppercase tracking-wider text-[#12281b] font-bold">
            Select Your Desired Package *
          </label>
          <select
            id="pkg-select"
            name="package"
            required
            class="w-full px-4 py-3.5 rounded-xl bg-[#faf8f5] border border-[#12281b]/15 focus:border-[#ba9038] focus:bg-white text-[#12281b] font-medium text-sm transition-all focus:outline-none focus:ring-2 focus:ring-[#ba9038]/20"
          >
            {tourPackages.map((pkg) => (
              <option value={pkg.id} selected={pkg.popular}>
                {pkg.title} — {pkg.price} / person ({pkg.duration})
              </option>
            ))}
          </select>
        </div>

        <!-- Row 2: Dates & Guests -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="space-y-2">
            <label for="pkg-date" class="block text-xs font-mono uppercase tracking-wider text-[#12281b] font-bold">
              Preferred Start Date *
            </label>
            <div class="relative">
              <input
                type="text"
                id="pkg-date"
                name="start_date"
                placeholder="YYYY-MM-DD"
                onfocus="this.type='date'; try{this.showPicker()}catch(e){}"
                onblur="if(!this.value){this.type='text'}"
                lang="en-US"
                required
                class="w-full pl-4 pr-10 py-3 rounded-xl bg-[#faf8f5] border border-[#12281b]/15 focus:border-[#ba9038] focus:bg-white text-[#12281b] text-sm focus:outline-none focus:ring-2 focus:ring-[#ba9038]/20"
              />
              <div class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-[#7a5813]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label for="pkg-adults" class="block text-xs font-mono uppercase tracking-wider text-[#12281b] font-bold">
              Number of Adults *
            </label>
            <select
              id="pkg-adults"
              name="adults"
              required
              class="w-full px-4 py-3 rounded-xl bg-[#faf8f5] border border-[#12281b]/15 focus:border-[#ba9038] focus:bg-white text-[#12281b] text-sm focus:outline-none"
            >
              <option value="1">1 Adult</option>
              <option value="2" selected>2 Adults</option>
              <option value="3">3 Adults</option>
              <option value="4">4 Adults</option>
              <option value="5">5 Adults</option>
              <option value="6+">6+ Adults (Group)</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="pkg-children" class="block text-xs font-mono uppercase tracking-wider text-[#12281b] font-bold">
              Children (under 12)
            </label>
            <select
              id="pkg-children"
              name="children"
              class="w-full px-4 py-3 rounded-xl bg-[#faf8f5] border border-[#12281b]/15 focus:border-[#ba9038] focus:bg-white text-[#12281b] text-sm focus:outline-none"
            >
              <option value="0" selected>0 Children</option>
              <option value="1">1 Child</option>
              <option value="2">2 Children</option>
              <option value="3+">3+ Children</option>
            </select>
          </div>
        </div>

        <!-- Row 3: Guest Name, Email, WhatsApp -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="space-y-2">
            <label for="pkg-name" class="block text-xs font-mono uppercase tracking-wider text-[#12281b] font-bold">
              Lead Guest Full Name *
            </label>
            <input
              type="text"
              id="pkg-name"
              name="full_name"
              placeholder="e.g. Sarah Jenkins"
              required
              class="w-full px-4 py-3 rounded-xl bg-[#faf8f5] border border-[#12281b]/15 focus:border-[#ba9038] focus:bg-white text-[#12281b] text-sm focus:outline-none focus:ring-2 focus:ring-[#ba9038]/20"
            />
          </div>

          <div class="space-y-2">
            <label for="pkg-email" class="block text-xs font-mono uppercase tracking-wider text-[#12281b] font-bold">
              Email Address *
            </label>
            <input
              type="email"
              id="pkg-email"
              name="email"
              placeholder="sarah@example.com"
              required
              class="w-full px-4 py-3 rounded-xl bg-[#faf8f5] border border-[#12281b]/15 focus:border-[#ba9038] focus:bg-white text-[#12281b] text-sm focus:outline-none focus:ring-2 focus:ring-[#ba9038]/20"
            />
          </div>

          <div class="space-y-2">
            <label for="pkg-phone" class="block text-xs font-mono uppercase tracking-wider text-[#12281b] font-bold">
              WhatsApp / Phone *
            </label>
            <input
              type="tel"
              id="pkg-phone"
              name="phone"
              placeholder="+44 7123 456789"
              required
              class="w-full px-4 py-3 rounded-xl bg-[#faf8f5] border border-[#12281b]/15 focus:border-[#ba9038] focus:bg-white text-[#12281b] text-sm focus:outline-none focus:ring-2 focus:ring-[#ba9038]/20"
            />
          </div>
        </div>

        <!-- Row 4: Pick-up Location -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
