      <button
        type="button"
        id="btn-close-modal"
        class="w-full py-3.5 rounded-xl bg-[#12281b] hover:bg-[#1f402c] text-white font-bold text-sm uppercase tracking-wider transition-colors shadow-md"
      >
        Understood & Close
      </button>
