// Order: 1. Experience & Bento Selection -> 2. Dates & Guests -> 3. Guest Details & Confirmation
interface Props {
  defaultType?: 'package' | 'room';
}

const { defaultType = 'package' } = Astro.props;

const tourPackages = [
  {
