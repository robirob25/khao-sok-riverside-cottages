<!-- ============================================================
     VANILLA JS STEPPER CONTROLLER (ZERO EXTERNAL DEPENDENCY)
============================================================ -->
<script is:inline>
  (function initBookingStepper() {
    const root = document.getElementById('booking-stepper-root');
    if (!root) return;

    let currentStep = 1;
    let selectedType = root.getAttribute('data-default-type') || 'package';

    // Tabs & Progress
    const tab1 = document.getElementById('stepper-tab-1');
    const tab2 = document.getElementById('stepper-tab-2');
    const tab3 = document.getElementById('stepper-tab-3');
    const progressFill = document.getElementById('stepper-progress-fill');

    // Panels
    const panel1 = document.getElementById('step-panel-1');
    const panel2 = document.getElementById('step-panel-2');
    const panel3 = document.getElementById('step-panel-3');

    // Step 1 Elements
    const inputCheckin = document.getElementById('step-date-checkin');
    const inputCheckout = document.getElementById('step-date-checkout');
    const displayAdults = document.getElementById('display-adults');
    const inputAdults = document.getElementById('step-adults-input');
    const btnAdultsMinus = document.getElementById('btn-adults-minus');
    const btnAdultsPlus = document.getElementById('btn-adults-plus');
    const displayChildren = document.getElementById('display-children');
    const inputChildren = document.getElementById('step-children-input');
    const btnChildrenMinus = document.getElementById('btn-children-minus');
    const btnChildrenPlus = document.getElementById('btn-children-plus');
    const error1 = document.getElementById('step-1-error');
    const error1Text = document.getElementById('step-1-error-text');
    const btnStep1Next = document.getElementById('btn-step-1-next');

    // Step 2 Elements
    const cardPackage = document.getElementById('card-option-package');
    const cardRoom = document.getElementById('card-option-room');
    const hiddenType = document.getElementById('selected-experience-type');
    const selectPackage = document.getElementById('select-sub-package');
    const selectRoom = document.getElementById('select-sub-room');
    const btnStep2Back = document.getElementById('btn-step-2-back');
    const btnStep2Next = document.getElementById('btn-step-2-next');

    // Step 3 Elements
    const form = document.getElementById('unified-stepper-form');
    const summaryDates = document.getElementById('summary-dates-guests');
    const summarySelection = document.getElementById('summary-selection-name');
    const btnEditSummary = document.getElementById('btn-edit-summary');
    const btnStep3Back = document.getElementById('btn-step-3-back');
    const beds24Link = document.getElementById('stepper-beds24-link');
    const error3 = document.getElementById('step-3-error');

    // Modal
    const modal = document.getElementById('stepper-success-modal');
    const btnCloseModal = document.getElementById('btn-stepper-close-modal');
    const modalSummary = document.getElementById('stepper-modal-summary-text');
    const whatsappBtn = document.getElementById('btn-whatsapp-instant');

    // Init Dates with Min Dates
    const today = new Date();
    const todayStr = today.toISOString().split('T')[0];
    if (inputCheckin) {
      inputCheckin.min = todayStr;
      inputCheckin.addEventListener('change', () => {
        if (inputCheckin.value) {
          const nextDay = new Date(inputCheckin.value);
          nextDay.setDate(nextDay.getDate() + 1);
          const nextDayStr = nextDay.toISOString().split('T')[0];
          inputCheckout.min = nextDayStr;
          if (!inputCheckout.value || inputCheckout.value <= inputCheckin.value) {
            inputCheckout.value = nextDayStr;
          }
        }
        if (error1) error1.classList.add('hidden');
      });
    }

    if (inputCheckout) {
      inputCheckout.addEventListener('change', () => {
        if (error1) error1.classList.add('hidden');
      });
    }

    // Adults Stepper
    let adultsCount = 2;
    if (btnAdultsMinus && btnAdultsPlus && displayAdults && inputAdults) {
      btnAdultsMinus.addEventListener('click', () => {
        if (adultsCount > 1) {
          adultsCount--;
          displayAdults.textContent = adultsCount;
          inputAdults.value = adultsCount;
        }
      });
      btnAdultsPlus.addEventListener('click', () => {
        if (adultsCount < 12) {
          adultsCount++;
          displayAdults.textContent = adultsCount;
          inputAdults.value = adultsCount;
        }
      });
    }

    // Children Stepper
    let childrenCount = 0;
    if (btnChildrenMinus && btnChildrenPlus && displayChildren && inputChildren) {
      btnChildrenMinus.addEventListener('click', () => {
        if (childrenCount > 0) {
          childrenCount--;
          displayChildren.textContent = childrenCount;
          inputChildren.value = childrenCount;
        }
      });
      btnChildrenPlus.addEventListener('click', () => {
        if (childrenCount < 8) {
          childrenCount++;
          displayChildren.textContent = childrenCount;
          inputChildren.value = childrenCount;
        }
      });
    }

    // URL Query Parameter Reading (?type=package or ?type=room or ?tab=package or ?tab=room)
    const urlParams = new URLSearchParams(window.location.search);
    const paramType = urlParams.get('type') || urlParams.get('tab');
    if (paramType === 'room') {
      selectedType = 'room';
    } else if (paramType === 'package') {
      selectedType = 'package';
    }

    // Set Experience Type Visuals
    function updateExperienceSelection(type) {
      selectedType = type;
      if (hiddenType) hiddenType.value = type;

      if (!cardPackage || !cardRoom) return;

      if (type === 'package') {
        cardPackage.classList.remove('bg-white', 'text-[#12281b]', 'border-neutral-200');
        cardPackage.classList.add('bg-gradient-to-br', 'from-[#12281b]', 'via-[#173323]', 'to-[#0c1c13]', 'text-white', 'border-[#ba9038]', 'ring-2', 'ring-[#ba9038]/30', 'shadow-md');
        const iconA = cardPackage.querySelector('.card-radio-icon');
        if (iconA) {
          iconA.className = 'card-radio-icon w-6 h-6 rounded-full bg-[#ba9038] text-[#12281b] flex items-center justify-center font-bold text-xs';
          iconA.textContent = '✓';
        }

        cardRoom.classList.remove('bg-gradient-to-br', 'from-[#12281b]', 'via-[#173323]', 'to-[#0c1c13]', 'text-white', 'border-[#ba9038]', 'ring-2', 'ring-[#ba9038]/30', 'shadow-md');
        cardRoom.classList.add('bg-white', 'text-[#12281b]', 'border-neutral-200');
        const iconB = cardRoom.querySelector('.card-radio-icon');
        if (iconB) {
          iconB.className = 'card-radio-icon w-6 h-6 rounded-full bg-[#f4efeb] text-transparent border border-[#12281b]/20 flex items-center justify-center font-bold text-xs';
          iconB.textContent = '';
        }

        if (beds24Link) {
          beds24Link.href = 'https://beds24.com/booking2.php?propid=42681';
        }
      } else {
        cardRoom.classList.remove('bg-white', 'text-[#12281b]', 'border-neutral-200');
        cardRoom.classList.add('bg-gradient-to-br', 'from-[#12281b]', 'via-[#173323]', 'to-[#0c1c13]', 'text-white', 'border-[#ba9038]', 'ring-2', 'ring-[#ba9038]/30', 'shadow-md');
        const iconB = cardRoom.querySelector('.card-radio-icon');
        if (iconB) {
          iconB.className = 'card-radio-icon w-6 h-6 rounded-full bg-[#ba9038] text-[#12281b] flex items-center justify-center font-bold text-xs';
          iconB.textContent = '✓';
        }

        cardPackage.classList.remove('bg-gradient-to-br', 'from-[#12281b]', 'via-[#173323]', 'to-[#0c1c13]', 'text-white', 'border-[#ba9038]', 'ring-2', 'ring-[#ba9038]/30', 'shadow-md');
        cardPackage.classList.add('bg-white', 'text-[#12281b]', 'border-neutral-200');
        const iconA = cardPackage.querySelector('.card-radio-icon');
        if (iconA) {
          iconA.className = 'card-radio-icon w-6 h-6 rounded-full bg-[#f4efeb] text-transparent border border-[#12281b]/20 flex items-center justify-center font-bold text-xs';
          iconA.textContent = '';
        }

        if (beds24Link) {
          beds24Link.href = 'https://beds24.com/booking2.php?propid=8735&numadult=2&referer=iframe';
        }
      }
    }

    if (cardPackage) {
      cardPackage.addEventListener('click', () => updateExperienceSelection('package'));
    }
    if (cardRoom) {
      cardRoom.addEventListener('click', () => updateExperienceSelection('room'));
    }

    // Initial update based on URL parameter
    updateExperienceSelection(selectedType);

    // Switch Stepper Step
    function goToStep(step) {
      currentStep = step;

      // Update Panels
      if (panel1) panel1.classList.toggle('hidden', step !== 1);
      if (panel2) panel2.classList.toggle('hidden', step !== 2);
      if (panel3) panel3.classList.toggle('hidden', step !== 3);

      // Update Navigation Tabs
      [tab1, tab2, tab3].forEach((tab, idx) => {
        if (!tab) return;
        const num = idx + 1;
        const numBadge = tab.querySelector('.step-num');

        if (num === step) {
          tab.classList.remove('opacity-60');
          tab.classList.add('opacity-100');
          if (numBadge) {
            numBadge.className = 'step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#12281b] text-white shadow-sm ring-2 ring-[#ba9038]/50';
          }
        } else if (num < step) {
          tab.classList.remove('opacity-60');
          tab.classList.add('opacity-100');
          if (numBadge) {
            numBadge.className = 'step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#2e6b45] text-white shadow-xs';
            numBadge.textContent = '✓';
          }
        } else {
          tab.classList.add('opacity-60');
          tab.classList.remove('opacity-100');
          if (numBadge) {
            numBadge.className = 'step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#f4efeb] text-[#12281b] border border-[#12281b]/15';
            numBadge.textContent = num.toString();
          }
        }
      });

      // Update Progress Track
      if (progressFill) {
        if (step === 1) progressFill.style.width = '33%';
        else if (step === 2) progressFill.style.width = '66%';
        else progressFill.style.width = '100%';
      }

      // If entering Step 3, refresh summary
      if (step === 3) {
        updateStep3Summary();
      }

      // Smooth scroll to top of stepper
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Validate Step 1
    function validateStep1() {
      const inVal = inputCheckin ? inputCheckin.value : '';
      const outVal = inputCheckout ? inputCheckout.value : '';

      if (!inVal || !outVal) {
        if (error1 && error1Text) {
          error1Text.textContent = 'Please select both Check-In and Check-Out dates.';
          error1.classList.remove('hidden');
        }
        return false;
      }

      if (outVal <= inVal) {
        if (error1 && error1Text) {
          error1Text.textContent = 'Check-Out date must be after Check-In date.';
          error1.classList.remove('hidden');
        }
        return false;
      }

      if (error1) error1.classList.add('hidden');
      return true;
    }

    // Step 1 Next
    if (btnStep1Next) {
      btnStep1Next.addEventListener('click', () => {
        if (validateStep1()) {
          goToStep(2);
        }
      });
    }

    // Step 2 Next & Back
    if (btnStep2Back) {
      btnStep2Back.addEventListener('click', () => goToStep(1));
    }
    if (btnStep2Next) {
      btnStep2Next.addEventListener('click', () => goToStep(3));
    }

    // Step 3 Back & Edit
    if (btnStep3Back) {
      btnStep3Back.addEventListener('click', () => goToStep(2));
    }
    if (btnEditSummary) {
      btnEditSummary.addEventListener('click', () => goToStep(1));
    }

    // Step Tabs Direct Click (Allowed for steps already visited)
    if (tab1) tab1.addEventListener('click', () => goToStep(1));
    if (tab2) tab2.addEventListener('click', () => {
      if (validateStep1()) goToStep(2);
    });
    if (tab3) tab3.addEventListener('click', () => {
      if (validateStep1()) goToStep(3);
    });

    // Calculate Nights & Format Summary
    function updateStep3Summary() {
      const inVal = inputCheckin ? inputCheckin.value : '';
      const outVal = inputCheckout ? inputCheckout.value : '';
      let nights = 0;
      if (inVal && outVal) {
        const d1 = new Date(inVal);
        const d2 = new Date(outVal);
        nights = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)));
      }

      if (summaryDates) {
        const guestsStr = `${adultsCount} Adult${adultsCount > 1 ? 's' : ''}${childrenCount > 0 ? `, ${childrenCount} Child${childrenCount > 1 ? 'ren' : ''}` : ''}`;
        summaryDates.textContent = `${inVal || 'TBD'} → ${outVal || 'TBD'} (${nights} night${nights > 1 ? 's' : ''}) · ${guestsStr}`;
      }

      if (summarySelection) {
        if (selectedType === 'package') {
          const pkgTitle = selectPackage ? selectPackage.options[selectPackage.selectedIndex].text.split('—')[0].trim() : 'All-Inclusive Package';
          summarySelection.textContent = `Experience: Tour Package (${pkgTitle})`;
        } else {
          const roomTitle = selectRoom ? selectRoom.options[selectRoom.selectedIndex].text.split('—')[0].trim() : 'Cottage Only';
          summarySelection.textContent = `Experience: Room Only (${roomTitle})`;
        }
      }
    }

    // Handle Form Submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameInput = document.getElementById('step-guest-name');
        const emailInput = document.getElementById('step-guest-email');
        const phoneInput = document.getElementById('step-guest-phone');

        const name = (nameInput?.value || '').trim();
        const email = (emailInput?.value || '').trim();
        const phone = (phoneInput?.value || '').trim();

        if (!name || !email || !phone) {
          if (error3) error3.classList.remove('hidden');
          return;
        }

        if (error3) error3.classList.add('hidden');

        // Prepare Summary for modal and WhatsApp link
        const inVal = inputCheckin ? inputCheckin.value : 'Flexible';
        const outVal = inputCheckout ? inputCheckout.value : 'Flexible';
        const chosenExp = selectedType === 'package'
          ? (selectPackage ? selectPackage.options[selectPackage.selectedIndex].text.split('—')[0].trim() : 'Tour Package')
          : (selectRoom ? selectRoom.options[selectRoom.selectedIndex].text.split('—')[0].trim() : 'Cottage Only');

        if (modalSummary) {
          modalSummary.textContent = `Thank you ${name}! We have received your reservation request for "${chosenExp}" (${inVal} to ${outVal}, ${adultsCount} Adults). Our reservation desk will confirm availability and send your itinerary within 12 hours.`;
        }

        // WhatsApp direct link generator
        if (whatsappBtn) {
          const waMsg = encodeURIComponent(
            `Hello Khao Sok Riverside Cottages! I just sent a reservation request: Name: ${name}, Dates: ${inVal} to ${outVal}, Guests: ${adultsCount} Adults, Experience: ${chosenExp}. Could you please confirm availability? Thank you!`
          );
          whatsappBtn.href = `https://wa.me/6677395159?text=${waMsg}`;
        }

        openModal();
      });
    }

    function openModal() {
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      const inner = modal.querySelector('div');
      if (inner) inner.classList.remove('scale-95');
      if (btnCloseModal) btnCloseModal.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      const inner = modal.querySelector('div');
      if (inner) inner.classList.add('scale-95');
    }

    if (btnCloseModal) {
      btnCloseModal.addEventListener('click', closeModal);
    }
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('pointer-events-none')) return;
      if (e.key === 'Escape') closeModal();
    });

  })();
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fadeIn {
    animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
