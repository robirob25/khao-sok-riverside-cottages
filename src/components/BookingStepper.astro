    const btnStep3Back = document.getElementById('btn-step-3-back');
    const form = document.getElementById('unified-stepper-form');
    const error3 = document.getElementById('step-3-error');
    const beds24Link = document.getElementById('stepper-beds24-link');

    // Modal
    const modal = document.getElementById('stepper-success-modal');
    const btnCloseModal = document.getElementById('btn-stepper-close-modal');
    const modalSummary = document.getElementById('stepper-modal-summary-text');
    const whatsappBtn = document.getElementById('btn-whatsapp-instant');

    // Init URL query parameter (?type=package or ?type=room or ?tab=...)
    const urlParams = new URLSearchParams(window.location.search);
    const paramType = urlParams.get('type') || urlParams.get('tab');
    if (paramType === 'room') {
      currentCategory = 'room';
      selectedItem = {
        id: 'riverside',
        title: 'Riverside Cottage',
        price: '฿1,400',
        type: 'room',
        nights: 1,
        img: '/wp-content/uploads/2025/07/deluxe-cottage-1.jpg'
      };
    }

    // Switch Category (Package vs Room)
    function setCategory(cat) {
      currentCategory = cat;
      if (cat === 'package') {
        if (pillPackage) {
          pillPackage.className = 'exp-switch-pill py-3 px-4 rounded-xl text-xs sm:text-sm font-sans font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer bg-[#12281b] text-white shadow-sm';
        }
        if (pillRoom) {
          pillRoom.className = 'exp-switch-pill py-3 px-4 rounded-xl text-xs sm:text-sm font-sans font-semibold uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer text-[#183424] hover:text-[#12281b]';
        }
        if (containerPackages) containerPackages.classList.remove('hidden');
        if (containerRooms) containerRooms.classList.add('hidden');

        // If currently selected is room, switch to default package
        if (selectedItem.type !== 'package') {
          selectCardById('grand-jungle', 'package');
        }
      } else {
        if (pillRoom) {
          pillRoom.className = 'exp-switch-pill py-3 px-4 rounded-xl text-xs sm:text-sm font-sans font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer bg-[#12281b] text-white shadow-sm';
        }
        if (pillPackage) {
          pillPackage.className = 'exp-switch-pill py-3 px-4 rounded-xl text-xs sm:text-sm font-sans font-semibold uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer text-[#183424] hover:text-[#12281b]';
        }
        if (containerRooms) containerRooms.classList.remove('hidden');
        if (containerPackages) containerPackages.classList.add('hidden');

        // If currently selected is package, switch to default room
        if (selectedItem.type !== 'room') {
          selectCardById('riverside', 'room');
        }
      }
    }

    if (pillPackage) pillPackage.addEventListener('click', () => setCategory('package'));
    if (pillRoom) pillRoom.addEventListener('click', () => setCategory('room'));

    // Handle Bento Card Click Selection
    function selectCard(card) {
      const id = card.getAttribute('data-item-id');
      const title = card.getAttribute('data-item-title');
      const price = card.getAttribute('data-item-price');
      const type = card.getAttribute('data-item-type');
      const nights = parseInt(card.getAttribute('data-item-nights') || '1', 10);
      const img = card.getAttribute('data-item-img');

      selectedItem = { id, title, price, type, nights, img };

      // Update active styles across all cards
      document.querySelectorAll('.bento-card-item').forEach((c) => {
        const check = c.querySelector('.select-check-badge');
        const btn = c.querySelector('.btn-card-select');

        if (c.getAttribute('data-item-id') === id) {
          c.classList.add('border-[#ba9038]', 'ring-2', 'ring-[#ba9038]/40', 'bg-[#faf8f5]');
          c.classList.remove('border-[#12281b]/10');
          if (check) {
            check.className = 'select-check-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs transition-all shadow-md bg-[#ba9038] text-[#12281b]';
            check.textContent = '✓';
          }
          if (btn) {
            btn.className = 'btn-card-select w-full py-2.5 px-4 rounded-xl text-center font-sans text-xs uppercase tracking-wider font-bold transition-all bg-[#12281b] text-white';
            btn.textContent = 'Selected ✓';
          }
        } else {
          c.classList.remove('border-[#ba9038]', 'ring-2', 'ring-[#ba9038]/40', 'bg-[#faf8f5]');
          c.classList.add('border-[#12281b]/10');
          if (check) {
            check.className = 'select-check-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs transition-all shadow-md bg-white/80 text-transparent';
            check.textContent = '';
          }
          if (btn) {
            btn.className = 'btn-card-select w-full py-2.5 px-4 rounded-xl text-center font-sans text-xs uppercase tracking-wider font-bold transition-all bg-[#faf8f5] border border-[#12281b]/15 text-[#12281b] hover:bg-[#12281b] hover:text-white';
            btn.textContent = type === 'package' ? 'Select This Package' : 'Select This Cottage';
          }
        }
      });

      // Update Step 1 bottom recap
      if (step1Thumb) step1Thumb.src = img;
      if (step1Title) step1Title.textContent = title;
      if (step1Rate) {
        step1Rate.textContent = type === 'package' ? `${price} / person · All-Inclusive` : `${price} / night`;
      }

      // Automatically recalculate checkout date if checkin already filled
      if (inputCheckin && inputCheckin.value && inputCheckout) {
        const d = new Date(inputCheckin.value);
        d.setDate(d.getDate() + (selectedItem.nights || 1));
        inputCheckout.value = d.toISOString().split('T')[0];
      }

      // Update Beds24 URL accordingly
      if (beds24Link) {
        beds24Link.href = type === 'package'
          ? 'https://beds24.com/booking2.php?propid=42681'
          : 'https://beds24.com/booking2.php?propid=8735&numadult=2&referer=iframe';
      }
    }

    function selectCardById(id, type) {
      const card = document.querySelector(`.bento-card-item[data-item-id="${id}"]`);
      if (card) {
        selectCard(card);
      }
    }

    document.querySelectorAll('.bento-card-item').forEach((card) => {
      card.addEventListener('click', () => selectCard(card));
    });

    // Init category from URL
    setCategory(currentCategory);
    selectCardById(selectedItem.id, selectedItem.type);

    // ==========================================
    // STEP NAVIGATION CONTROLLER
    // ==========================================
    function goToStep(step) {
      currentStep = step;

      // Panels Toggle
      if (panel1) panel1.classList.toggle('hidden', step !== 1);
      if (panel2) panel2.classList.toggle('hidden', step !== 2);
      if (panel3) panel3.classList.toggle('hidden', step !== 3);

      // Tabs Header Update
      [tab1, tab2, tab3].forEach((tab, idx) => {
        if (!tab) return;
        const num = idx + 1;
        const numBadge = tab.querySelector('.step-num');

        if (num === step) {
          tab.classList.remove('opacity-60');
          tab.classList.add('opacity-100');
          if (numBadge) {
            numBadge.className = 'step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#12281b] text-white shadow-sm ring-2 ring-[#ba9038]/50';
          }
        } else if (num < step) {
          tab.classList.remove('opacity-60');
          tab.classList.add('opacity-100');
          if (numBadge) {
            numBadge.className = 'step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#2e6b45] text-white shadow-xs';
            numBadge.textContent = '✓';
          }
        } else {
          tab.classList.add('opacity-60');
          tab.classList.remove('opacity-100');
          if (numBadge) {
            numBadge.className = 'step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#f4efeb] text-[#12281b] border border-[#12281b]/15';
            numBadge.textContent = num.toString();
          }
        }
      });

      // Progress bar fill
      if (progressFill) {
        if (step === 1) progressFill.style.width = '33%';
        else if (step === 2) progressFill.style.width = '66%';
        else progressFill.style.width = '100%';
      }

      // Step Recaps Refresh
      if (step === 2) {
        if (step2RecapThumb) step2RecapThumb.src = selectedItem.img;
        if (step2RecapTitle) step2RecapTitle.textContent = `${selectedItem.title} (${selectedItem.price})`;
      } else if (step === 3) {
        updateStep3Summary();
      }

      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Dates Setup
    const today = new Date();
    const todayStr = today.toISOString().split('T')[0];
    if (inputCheckin) {
      inputCheckin.min = todayStr;
      inputCheckin.addEventListener('change', () => {
        if (inputCheckin.value) {
          const inDate = new Date(inputCheckin.value);
          const nightsToAdd = selectedItem.nights || 1;
          const outDate = new Date(inDate);
          outDate.setDate(outDate.getDate() + nightsToAdd);
          const outDateStr = outDate.toISOString().split('T')[0];
          if (inputCheckout) {
            inputCheckout.min = outDateStr;
            inputCheckout.value = outDateStr;
          }
        }
        if (error2) error2.classList.add('hidden');
      });
    }

    if (inputCheckout) {
      inputCheckout.addEventListener('change', () => {
        if (error2) error2.classList.add('hidden');
      });
    }

    // Adults / Children Numeric Steppers
    let adultsCount = 2;
    if (btnAdultsMinus && btnAdultsPlus && displayAdults && inputAdults) {
      btnAdultsMinus.addEventListener('click', () => {
        if (adultsCount > 1) {
          adultsCount--;
          displayAdults.textContent = adultsCount;
          inputAdults.value = adultsCount;
        }
      });
      btnAdultsPlus.addEventListener('click', () => {
        if (adultsCount < 12) {
          adultsCount++;
          displayAdults.textContent = adultsCount;
          inputAdults.value = adultsCount;
        }
      });
    }

    let childrenCount = 0;
    if (btnChildrenMinus && btnChildrenPlus && displayChildren && inputChildren) {
      btnChildrenMinus.addEventListener('click', () => {
        if (childrenCount > 0) {
          childrenCount--;
          displayChildren.textContent = childrenCount;
          inputChildren.value = childrenCount;
        }
      });
      btnChildrenPlus.addEventListener('click', () => {
        if (childrenCount < 8) {
          childrenCount++;
          displayChildren.textContent = childrenCount;
          inputChildren.value = childrenCount;
        }
      });
    }

    // Step 1 Next
    if (btnStep1Next) {
      btnStep1Next.addEventListener('click', () => {
        goToStep(2);
      });
    }

    // Step 2 Validation & Navigation
    function validateStep2() {
      const inVal = inputCheckin ? inputCheckin.value : '';
      const outVal = inputCheckout ? inputCheckout.value : '';

      if (!inVal || !outVal) {
        if (error2 && error2Text) {
          error2Text.textContent = 'Please select both Check-In and Check-Out dates.';
          error2.classList.remove('hidden');
        }
        return false;
      }

      if (outVal <= inVal) {
        if (error2 && error2Text) {
          error2Text.textContent = 'Check-Out date must be strictly after Check-In date.';
          error2.classList.remove('hidden');
        }
        return false;
      }

      if (error2) error2.classList.add('hidden');
      return true;
    }

    if (btnStep2Back) btnStep2Back.addEventListener('click', () => goToStep(1));
    if (btnStep2ChangeExp) btnStep2ChangeExp.addEventListener('click', () => goToStep(1));

    if (btnStep2Next) {
      btnStep2Next.addEventListener('click', () => {
        if (validateStep2()) {
          goToStep(3);
        }
      });
    }

    // Step 3 Navigation & Summary
    if (btnStep3Back) btnStep3Back.addEventListener('click', () => goToStep(2));
    if (btnEditSummary) btnEditSummary.addEventListener('click', () => goToStep(1));

    // Tab Header Clicks
    if (tab1) tab1.addEventListener('click', () => goToStep(1));
    if (tab2) tab2.addEventListener('click', () => goToStep(2));
    if (tab3) tab3.addEventListener('click', () => {
      if (validateStep2()) goToStep(3);
    });

    function updateStep3Summary() {
      const inVal = inputCheckin ? inputCheckin.value : '';
      const outVal = inputCheckout ? inputCheckout.value : '';
      let nights = 0;
      if (inVal && outVal) {
        const d1 = new Date(inVal);
        const d2 = new Date(outVal);
        nights = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)));
      }

      if (step3RecapThumb) step3RecapThumb.src = selectedItem.img;

      if (summaryDates) {
        const guestsStr = `${adultsCount} Adult${adultsCount > 1 ? 's' : ''}${childrenCount > 0 ? `, ${childrenCount} Child${childrenCount > 1 ? 'ren' : ''}` : ''}`;
        summaryDates.textContent = `${inVal || 'TBD'} → ${outVal || 'TBD'} (${nights} night${nights > 1 ? 's' : ''}) · ${guestsStr}`;
      }

      if (summarySelection) {
        summarySelection.textContent = `${selectedItem.title} · ${selectedItem.price} (${selectedItem.type === 'package' ? 'All-Inclusive' : 'Room Only'})`;
      }
    }

    // Form Submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameInput = document.getElementById('step-guest-name');
        const emailInput = document.getElementById('step-guest-email');
        const phoneInput = document.getElementById('step-guest-phone');

        const name = (nameInput?.value || '').trim();
        const email = (emailInput?.value || '').trim();
        const phone = (phoneInput?.value || '').trim();

        if (!name || !email || !phone) {
          if (error3) error3.classList.remove('hidden');
          return;
        }

        if (error3) error3.classList.add('hidden');

        const inVal = inputCheckin ? inputCheckin.value : 'Flexible';
        const outVal = inputCheckout ? inputCheckout.value : 'Flexible';

        if (modalSummary) {
          modalSummary.textContent = `Thank you ${name}! We have received your reservation request for "${selectedItem.title}" (${inVal} to ${outVal}, ${adultsCount} Adults). Our reservation desk will confirm availability and send your itinerary within 12 hours.`;
        }

        if (whatsappBtn) {
          const waMsg = encodeURIComponent(
            `Hello Khao Sok Riverside Cottages! I just sent a reservation request: Name: ${name}, Dates: ${inVal} to ${outVal}, Guests: ${adultsCount} Adults, Experience: ${selectedItem.title}. Could you please confirm availability? Thank you!`
          );
          whatsappBtn.href = `https://wa.me/6677395159?text=${waMsg}`;
        }

        openModal();
      });
    }

    function openModal() {
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      const inner = modal.querySelector('div');
      if (inner) inner.classList.remove('scale-95');
      if (btnCloseModal) btnCloseModal.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      const inner = modal.querySelector('div');
      if (inner) inner.classList.add('scale-95');
    }

    if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('pointer-events-none')) return;
      if (e.key === 'Escape') closeModal();
    });

  })();
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fadeIn {
    animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
