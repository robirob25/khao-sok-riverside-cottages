const cottageRooms = [
  {
    id: 'riverside',
    name: 'Riverside Cottage',
    price: '฿1,400',
    priceNote: 'per night · 1-2 guests',
    bed: '1 King Bed',
    popular: true,
    img: '/wp-content/uploads/2025/07/deluxe-cottage-1.jpg',
    desc: 'Our most sought-after room category. Perched directly above the clear waters of the Sok River, with panoramic views of ancient limestone karst cliffs.',
    features: ['Direct River & Karst Views', 'Private Riverfront Balcony & Hammock', 'Air Conditioning', 'En-suite Hot Shower', 'Free Wi-Fi'],
    beds24Url: 'https://beds24.com/booking2.php?propid=8735&numadult=2&referer=iframe',
  },
  {
    id: 'garden-view',
    name: 'Garden View Cottage',
    price: '฿1,100',
    priceNote: 'per night · 1-2 guests',
    bed: '1 King Bed or 2 Twin Beds',
    popular: false,
    img: '/wp-content/uploads/2025/07/cottage-1.jpg',
    desc: 'Spacious freestanding wooden cottage nestled in tropical botanical gardens. Features a private covered balcony with hammock and hot water shower.',
    features: ['Private Balcony & Hammock', 'En-suite Bathroom & Hot Shower', 'Air Conditioning or Gentle Fan', 'Garden Setting', 'Free Wi-Fi'],
    beds24Url: 'https://beds24.com/booking2.php?propid=8735&numadult=2&referer=iframe',
  },
  {
    id: 'family',
    name: 'Family Wooden Cottage',
    price: '฿2,000',
    priceNote: 'per night · Up to 4 guests',
    bed: '2 Queen Beds or 1 King + 2 Bunks',
    popular: false,
    img: '/wp-content/uploads/2025/07/family-cottage-1.jpg',
    desc: 'Extra-spacious wooden chalets designed for families with children or friends travelling together. Large en-suite bathroom and expansive balcony.',
    features: ['Sleeps up to 4 Guests', 'Spacious Family Balcony', 'Air Conditioning & Hot Shower', 'Secluded Jungle Setting', 'Child Friendly'],
    beds24Url: 'https://beds24.com/booking2.php?propid=8735&numadult=2&referer=iframe',
  },
];
---

<div id="booking-stepper-root" class="max-w-6xl mx-auto space-y-8" data-default-type={defaultType}>

  <!-- ============================================================
       TOP VALUE PROPOSITION CAPSULE & HONOR SYSTEM GUARANTEE
  ============================================================ -->
  <div class="bg-gradient-to-br from-[#12281b] to-[#1e442c] rounded-3xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-56 h-56 bg-[#ba9038]/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ba9038]/20 border border-[#ba9038]/40 text-[#f7e6b5] text-[11px] font-sans uppercase tracking-[0.2em] font-bold">
          <span>KSR</span>
          <span>/</span>
          <span>HONOR SYSTEM RESERVATIONS</span>
        </div>
        <h2 class="font-monumental text-xl sm:text-2xl md:text-3xl text-white tracking-tight leading-tight">
          Reserve with <span class="font-display italic font-light text-[#d8b257]">Confidence</span>
        </h2>
        <p class="text-xs sm:text-sm text-[#abd0bb] leading-relaxed">
          Zero deposit required. No credit card upfront. Pay at resort check-in with free cancellation anytime.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-4 shrink-0 bg-white/10 p-3.5 sm:p-4 rounded-2xl border border-white/15 backdrop-blur-md">
        <div class="text-center sm:text-left">
          <div class="text-lg sm:text-xl font-monumental font-bold text-[#d8b257]">4.5 / 5</div>
          <div class="text-[10px] font-sans uppercase tracking-wider text-[#abd0bb]">731+ Google Reviews</div>
        </div>
        <div class="text-center sm:text-left border-l border-white/10 pl-3 sm:pl-4">
          <div class="text-lg sm:text-xl font-monumental font-bold text-[#d8b257]">8.9 / 10</div>
          <div class="text-[10px] font-sans uppercase tracking-wider text-[#abd0bb]">Booking.com Fabulous</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       STEPPER PROGRESS BAR (3 Clear Stages)
       1. Experience & Selection -> 2. Dates & Guests -> 3. Guest Details & Confirmation
  ============================================================ -->
  <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-6 border border-[#12281b]/10 shadow-sm space-y-4">
    <div class="grid grid-cols-3 gap-2 sm:gap-4">
      
      <!-- Step Tab 1: Experience -->
      <button
        type="button"
        id="stepper-tab-1"
        class="stepper-nav-btn group flex flex-col sm:flex-row items-center sm:items-start gap-2 sm:gap-3 text-center sm:text-left p-2 rounded-xl transition-all cursor-pointer"
        data-step="1"
      >
        <span class="step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#12281b] text-white shadow-sm ring-2 ring-[#ba9038]/50">
          1
        </span>
        <div class="min-w-0">
          <span class="block text-[10px] font-sans uppercase tracking-wider text-[#7a5813] font-bold">Step 01</span>
          <span class="step-label block text-xs sm:text-sm font-semibold text-[#12281b] truncate">Experience</span>
        </div>
      </button>

      <!-- Step Tab 2: Dates & Guests -->
      <button
        type="button"
        id="stepper-tab-2"
        class="stepper-nav-btn group flex flex-col sm:flex-row items-center sm:items-start gap-2 sm:gap-3 text-center sm:text-left p-2 rounded-xl transition-all cursor-pointer opacity-60 hover:opacity-100"
        data-step="2"
      >
        <span class="step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#f4efeb] text-[#12281b] border border-[#12281b]/15">
          2
        </span>
        <div class="min-w-0">
          <span class="block text-[10px] font-sans uppercase tracking-wider text-[#183424] font-medium">Step 02</span>
          <span class="step-label block text-xs sm:text-sm font-semibold text-[#12281b] truncate">Dates & Guests</span>
        </div>
      </button>

      <!-- Step Tab 3: Details & Confirmation -->
      <button
        type="button"
        id="stepper-tab-3"
        class="stepper-nav-btn group flex flex-col sm:flex-row items-center sm:items-start gap-2 sm:gap-3 text-center sm:text-left p-2 rounded-xl transition-all cursor-pointer opacity-60 hover:opacity-100"
        data-step="3"
      >
        <span class="step-num w-8 h-8 rounded-full flex items-center justify-center font-sans font-bold text-xs shrink-0 transition-all bg-[#f4efeb] text-[#12281b] border border-[#12281b]/15">
          3
        </span>
        <div class="min-w-0">
          <span class="block text-[10px] font-sans uppercase tracking-wider text-[#183424] font-medium">Step 03</span>
          <span class="step-label block text-xs sm:text-sm font-semibold text-[#12281b] truncate">Details</span>
        </div>
      </button>

    </div>

    <!-- Active progress track line -->
    <div class="w-full bg-[#f4efeb] h-1.5 rounded-full overflow-hidden">
      <div id="stepper-progress-fill" class="h-full bg-gradient-to-r from-[#ba9038] to-[#d8b257] transition-all duration-300 w-1/3"></div>
    </div>
  </div>

  <!-- ============================================================
       STEPPER PANELS CONTAINER
  ============================================================ -->
  <div class="bg-white rounded-3xl border border-[#12281b]/10 p-5 sm:p-8 md:p-10 shadow-sm relative overflow-hidden">

    <!-- ========================================================
         STEP 1 : TYPE D'EXPÉRIENCE & SÉLECTION BENTO VISUELLE
    ======================================================== -->
    <div id="step-panel-1" class="step-panel space-y-8 animate-fadeIn">
      
      <!-- Intro & Category Switcher -->
      <div class="space-y-4 border-b border-[#12281b]/10 pb-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <div>
            <span class="text-[11px] font-sans uppercase tracking-widest text-[#ba9038] font-bold">Step 1 of 3 · Choose Experience</span>
            <h3 class="font-display text-2xl sm:text-3xl text-[#12281b] font-semibold tracking-tight mt-1">
              Select Your Tour Package or Cottage
            </h3>
            <p class="text-xs sm:text-sm text-[#183424] mt-1 leading-relaxed">
              Click on your preferred itinerary or wooden cottage below to select it.
            </p>
          </div>
        </div>

        <!-- Tactile Pill Switcher (Package vs Room) -->
        <div class="grid grid-cols-2 gap-3 max-w-xl p-1.5 bg-[#f4efeb] rounded-2xl border border-[#12281b]/10">
          <button
            type="button"
            id="pill-switch-package"
            class="exp-switch-pill py-3 px-4 rounded-xl text-xs sm:text-sm font-sans font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer bg-[#12281b] text-white shadow-sm"
            data-target="package"
          >
            <span>Tour Packages</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#ba9038] text-[#12281b] font-bold hidden sm:inline-block">Best Value</span>
          </button>

          <button
            type="button"
            id="pill-switch-room"
            class="exp-switch-pill py-3 px-4 rounded-xl text-xs sm:text-sm font-sans font-semibold uppercase tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer text-[#183424] hover:text-[#12281b]"
            data-target="room"
          >
            <span>Cottage Only</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#12281b]/10 text-[#12281b] font-bold hidden sm:inline-block">Room Only</span>
          </button>
        </div>
      </div>

      <!-- ==========================================
           BENTO GRID 1 : TOUR PACKAGES (VISUEL)
      ========================================== -->
      <div id="bento-container-packages" class="bento-grid-group space-y-6">
        <div class="flex items-center justify-between text-xs text-[#183424]">
          <span class="font-semibold uppercase tracking-wider text-[#7a5813]">5 All-Inclusive Packages (Resort + Lake + Safaris)</span>
          <span class="text-[11px] text-[#2e6b45] font-bold">✓ All meals & activities included</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
          {tourPackages.map((pkg) => (
            <div
              class={`bento-card-item group relative rounded-2xl sm:rounded-3xl bg-white border cursor-pointer transition-all duration-300 overflow-hidden flex flex-col justify-between shadow-xs hover:shadow-md ${
                pkg.popular
                  ? 'border-[#ba9038] ring-2 ring-[#ba9038]/40 selected-active bg-[#faf8f5]'
                  : 'border-[#12281b]/10 hover:border-[#ba9038]'
              }`}
              data-item-id={pkg.id}
              data-item-title={pkg.title}
              data-item-price={pkg.price}
              data-item-type="package"
              data-item-nights={pkg.nights}
              data-item-img={pkg.img}
            >
              <!-- Card Photo with Gradient -->
              <div class="relative h-48 sm:h-52 overflow-hidden bg-slate-900">
                <img
                  src={pkg.img}
                  alt={pkg.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div>

                <!-- Top Badges -->
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                  <span class="px-2.5 py-1 rounded-full bg-[#12281b]/90 backdrop-blur-md text-[#d8b257] text-[10px] font-sans uppercase tracking-wider font-bold border border-[#ba9038]/40">
                    {pkg.badge}
                  </span>
                  
                  <!-- Checkmark badge (visible when selected) -->
                  <span class="select-check-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs transition-all shadow-md bg-[#ba9038] text-[#12281b]">
                    ✓
                  </span>
                </div>

                <!-- Bottom Photo Info -->
                <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between text-white">
                  <div>
                    <span class="text-[11px] font-sans uppercase tracking-wider text-[#abd0bb] block">{pkg.duration}</span>
                    <div class="text-xl font-monumental font-bold text-[#faf8f5]">{pkg.price}</div>
                  </div>
                  <span class="text-[10px] font-sans text-[#e5f0ea]/80">{pkg.priceNote}</span>
                </div>
              </div>

              <!-- Card Details & Highlights -->
              <div class="p-5 space-y-3.5 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <h4 class="font-display text-base sm:text-lg font-bold text-[#163824] group-hover:text-[#ba9038] transition-colors leading-snug">
                    {pkg.title}
                  </h4>
                  <p class="text-xs text-[#183424] font-medium italic">
                    {pkg.stay}
                  </p>

                  <ul class="space-y-1.5 pt-2 border-t border-[#12281b]/5 text-xs text-[#223e2c]">
                    {pkg.highlights.slice(0, 3).map((item) => (
                      <li class="flex items-start gap-2">
                        <span class="text-[#2e6b45] font-bold mt-0.5">✓</span>
                        <span class="leading-relaxed line-clamp-2">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Select Action Button -->
                <div class="pt-3 border-t border-[#12281b]/10">
                  <div class="btn-card-select w-full py-2.5 px-4 rounded-xl text-center font-sans text-xs uppercase tracking-wider font-bold transition-all bg-[#12281b] text-white">
                    Selected ✓
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ==========================================
           BENTO GRID 2 : COTTAGE ROOMS (VISUEL)
      ========================================== -->
      <div id="bento-container-rooms" class="bento-grid-group hidden space-y-6">
        <div class="flex items-center justify-between text-xs text-[#183424]">
          <span class="font-semibold uppercase tracking-wider text-[#7a5813]">3 Handcrafted Wooden Cottages on the Sok River</span>
          <span class="text-[11px] text-[#2e6b45] font-bold">✓ Flexible stay · Tours booked on-site</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
          {cottageRooms.map((room) => (
            <div
              class="bento-card-item group relative rounded-2xl sm:rounded-3xl bg-white border border-[#12281b]/10 hover:border-[#ba9038] cursor-pointer transition-all duration-300 overflow-hidden flex flex-col justify-between shadow-xs hover:shadow-md"
              data-item-id={room.id}
              data-item-title={room.name}
              data-item-price={room.price}
              data-item-type="room"
              data-item-nights="1"
              data-item-img={room.img}
            >
              <!-- Card Photo with Gradient -->
              <div class="relative h-48 sm:h-52 overflow-hidden bg-slate-900">
                <img
                  src={room.img}
                  alt={room.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div>

                <!-- Top Checkmark -->
                <div class="absolute top-3 right-3">
                  <span class="select-check-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs transition-all shadow-md bg-white/80 text-transparent">
                    ✓
                  </span>
                </div>

                <!-- Bottom Photo Info -->
                <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between text-white">
                  <div>
                    <span class="text-[11px] font-sans uppercase tracking-wider text-[#abd0bb] block">{room.bed}</span>
                    <div class="text-xl font-monumental font-bold text-[#faf8f5]">{room.price}</div>
                  </div>
                  <span class="text-[10px] font-sans text-[#e5f0ea]/80">{room.priceNote}</span>
                </div>
              </div>

              <!-- Card Details -->
              <div class="p-5 space-y-3.5 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <h4 class="font-display text-base sm:text-lg font-bold text-[#163824] group-hover:text-[#ba9038] transition-colors leading-snug">
                    {room.name}
                  </h4>
                  <p class="text-xs text-[#183424] leading-relaxed line-clamp-2">
                    {room.desc}
                  </p>

                  <ul class="space-y-1.5 pt-2 border-t border-[#12281b]/5 text-xs text-[#223e2c]">
                    {room.features.slice(0, 3).map((feat) => (
                      <li class="flex items-center gap-2">
                        <span class="text-[#2e6b45] font-bold">✓</span>
                        <span class="leading-relaxed">{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Select Action Button -->
                <div class="pt-3 border-t border-[#12281b]/10">
                  <div class="btn-card-select w-full py-2.5 px-4 rounded-xl text-center font-sans text-xs uppercase tracking-wider font-bold transition-all bg-[#faf8f5] border border-[#12281b]/15 text-[#12281b] hover:bg-[#12281b] hover:text-white">
                    Select This Cottage
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Live Selection Sticky Recap & Next Step CTA -->
      <div class="p-4 sm:p-5 rounded-2xl bg-[#faf8f5] border border-[#ba9038]/40 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3.5 w-full sm:w-auto">
          <img
            id="step1-selected-thumb"
            src="/wp-content/uploads/2025/01/Grand-Jungle-Cover.jpg"
            alt="Selected Experience"
            class="w-12 h-12 rounded-xl object-cover border border-[#12281b]/10 shrink-0"
          />
          <div>
            <span class="text-[10px] font-sans uppercase tracking-wider text-[#7a5813] font-bold block">Selected Experience</span>
            <span id="step1-selected-title" class="font-display text-base sm:text-lg font-bold text-[#12281b] block leading-tight">
              4D / 3N Grand Jungle & Lake Overnight
            </span>
            <span id="step1-selected-rate" class="text-xs text-[#2e6b45] font-semibold">
              ฿7,100 / person · All-Inclusive
            </span>
          </div>
        </div>

        <button
          type="button"
          id="btn-step-1-next"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#c99f3e] hover:to-[#ebd082] text-[#12281b] font-bold text-xs font-sans uppercase tracking-wider transition-all shadow-sm hover:shadow-md cursor-pointer flex items-center justify-center gap-2 min-h-[44px] shrink-0"
        >
          <span>Continue to Dates & Guests</span>
          <span>→</span>
        </button>
