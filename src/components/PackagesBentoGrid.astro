---
// PackagesBentoGrid.astro — 2026 Elite Bento Grid for Khao Sok Tour Packages
// Interactive Diaporamas with Clickable Thumbnails, Navigation Arrows, Counter & Fullscreen Lightbox Zoom

interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;

const premierPackages = [
  {
    id: 'grand-jungle',
    slug: '/4-day-khao-sok-jungle-tour-lake-overnight/',
    title: 'Grand Jungle Tour with Lake Overnight',
    sub: 'Jungle Tour with Lake Overnight',
    duration: '4 Day, 3 Night Package',
    badge: 'Signature Expedition · 4D / 3N',
    price: '7,100',
    currency: '฿',
    unit: 'per person',
    photos: [
      { src: '/wp-content/uploads/2025/01/Grand-Jungle-Cover.jpg', label: 'Grand Jungle Expedition' },
      { src: '/wp-content/uploads/2017/03/GrandAdventure_Package_Tours_Lake_MG_7674.jpg', label: 'Cheow Lan Lake Boat Safari' },
      { src: '/wp-content/uploads/2017/02/GrandAdventure_Package_Tours_Lake_MG_7772_crop.jpg', label: 'Floating Raft House Overnight' },
      { src: '/wp-content/uploads/2017/03/GrandAdventure_Package_Tours_Hiking_MG_6216.jpg', label: 'Guided Rainforest Hike' },
      { src: '/wp-content/uploads/2015/09/Khao-Sok-Canoe-Trip.jpg', label: 'Sok River Canoeing' },
    ],
    stayType: '2 Nights Resort + 1 Night Floating Lake Raft House',
    lakeStay: true,
    highlights: [
      '2 nights at Riverside Cottages (Comfortable wooden bungalows)',
      '1 night at Cheow Larn Lake (Floating raft house on emerald waters)',
      'Includes guided lake tour with wildlife safari by longtail boat',
      'Choose from canoeing or tubing, night safari or massage, half-day hike or hot springs',
    ],
    note: 'Includes authentic overnight stay in floating lake bungalows',
  },
  {
    id: 'riverside-rafthouse',
    slug: '/khao-sok-lake-package-river-raft/',
    title: 'Riverside & Rafthouse with Lake Overnight',
    sub: '3 Day, 2 Night Tour Khao Sok',
    duration: '3 Day, 2 Night Package',
    badge: 'Lake Overnight · 3D / 2N',
    price: '5,400',
    currency: '฿',
    unit: 'per person',
    photos: [
      { src: '/wp-content/uploads/2025/01/Riverside-Rafthouse-Cover.jpg', label: 'Riverside & Rafthouse' },
      { src: '/wp-content/uploads/2017/02/GrandAdventure_Package_Tours_Lake_MG_7772_crop.jpg', label: 'Lake Floating Bungalows' },
      { src: '/wp-content/uploads/2017/02/GrandAdventure_Package_RiverExterior_MG_8124.jpg', label: 'Resort Wooden Cottage' },
      { src: '/wp-content/uploads/2015/10/CanoeTrip4-1.jpg', label: 'Sok River Exploration' },
      { src: '/wp-content/uploads/2015/09/Thai-Massage1.jpg', label: 'Traditional Thai Massage' },
    ],
    stayType: '1 Night Resort + 1 Night Floating Lake Raft House',
    lakeStay: true,
    highlights: [
      '1 night at Riverside Cottages (Riverside setting)',
      '1 night at Cheow Larn Lake (Floating raft house)',
      'Includes guided lake tour with wildlife safari by longtail boat',
      'Choose from scenic canoeing or relaxing traditional massage',
    ],
    note: 'Includes authentic overnight stay in floating lake bungalows',
  },
];

const explorerPackages = [
  {
    id: 'rainforest-adventure',
    slug: '/khao-sok-lake-tour-rainforest/',
    title: 'Rainforest Adventure with Lake Day Trip',
    sub: '3 Day, 2 Night Package',
    duration: '3 Day, 2 Night Package',
    badge: 'Lake Day Explorer · 3D / 2N',
    price: '5,200',
    currency: '฿',
    unit: 'per person',
    photos: [
      { src: '/wp-content/uploads/2025/09/rainforest-adventure-package-cover.jpg', label: 'Rainforest Adventure' },
      { src: '/wp-content/uploads/2016/07/khao-sok-national-park-2.jpg', label: 'Cheow Lan Lake Day Excursion' },
      { src: '/wp-content/uploads/2023/03/jungle-hiking-1500-1000.jpg', label: 'Guided Jungle Trek' },
      { src: '/wp-content/uploads/2024/03/jungle-day-night-1.jpg', label: 'Nocturnal Safari' },
      { src: '/wp-content/uploads/2015/10/CanoeTrip3-1.jpg', label: 'River Canoeing' },
    ],
    stayType: '2 Nights Resort + Guided Lake Day Excursion',
    lakeStay: false,
    highlights: [
      '2 nights at Riverside Cottages',
      'Full guided Cheow Larn Lake day tour by longtail boat',
      'Choose from canoeing, night safari, massage, hike or hot springs',
    ],
    note: 'Day trip on the lake — does not include an overnight stay on the lake',
  },
  {
    id: 'khao-sok-delight',
    slug: '/khao-sok-tour-package-delight/',
    title: 'Khao Sok Delight with Elephant Bath',
    sub: '3 Day, 2 Night Khao Sok Trip',
    duration: '3 Day, 2 Night Package',
    badge: 'Wildlife & Culture · 3D / 2N',
    price: '4,500',
    currency: '฿',
    unit: 'per person',
    photos: [
      { src: '/wp-content/uploads/2025/01/delight-cover.jpg', label: 'Khao Sok Delight' },
      { src: '/wp-content/uploads/2024/03/Mahout-washing-his-elephant.jpg', label: 'Ethical Elephant Bathing' },
      { src: '/wp-content/uploads/2024/03/jungle-food-1e.jpg', label: 'Authentic Thai Jungle Cuisine' },
      { src: '/wp-content/uploads/2015/09/Khao-Sok-Canoe-Trip.jpg', label: 'Canoeing along Limestone Cliffs' },
      { src: '/wp-content/uploads/2015/09/Thai-Massage1.jpg', label: 'Relaxing Spa Treatment' },
    ],
    stayType: '2 Nights Resort · Rainforest Sanctuary Base',
    lakeStay: false,
    highlights: [
      '2 nights at Riverside Cottages',
      'Elephant bathing in the river or authentic jungle lunch',
      'Choose from half-day hike or massage, canoeing or river tubing',
    ],
    note: 'This package does not include an overnight stay on the lake',
  },
  {
    id: 'spirit-of-khao-sok',
    slug: '/khao-sok-package-tour-spirit/',
    title: 'Spirit of Khao Sok with Half-Day Hike',
    sub: '2 Day, 1 Night Package',
    duration: '2 Day, 1 Night Package',
    badge: 'Quick Escape · 2D / 1N',
    price: '2,300',
    currency: '฿',
    unit: 'per person',
    photos: [
      { src: '/wp-content/uploads/2025/01/spirit-cover.jpg', label: 'Spirit of Khao Sok' },
      { src: '/wp-content/uploads/2015/09/Khao-Sok-Canoe-Trip.jpg', label: 'River Canoeing Safari' },
      { src: '/wp-content/uploads/2024/03/khao-sok-jungle-hike-e.jpg', label: 'Half-Day Rainforest Hike' },
      { src: '/wp-content/uploads/2015/09/Thai-Massage1.jpg', label: 'Traditional Thai Massage' },
      { src: '/wp-content/uploads/2024/03/jungle-drinks.jpg', label: 'Herbal Jungle Refreshments' },
    ],
    stayType: '1 Night Resort · Riverside Cottage Stay',
    lakeStay: false,
    highlights: [
      '1 night at Riverside Cottages',
      'Scenic Sok river canoeing or traditional massage',
      'Choose from half-day rainforest hike or relaxing hot springs',
    ],
    note: 'This package does not include an overnight stay on the lake',
  },
];
---

<div class="space-y-10 my-10">
  {showTitle && (
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#ba9038]/10 border border-[#ba9038]/20 text-[#8a6b25] text-xs font-mono uppercase tracking-[0.2em] font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-[#ba9038]"></span>
        <span>Curated Tour Packages · Guaranteed Lowest Direct Rates</span>
      </div>
      <h2 class="font-monumental text-3xl sm:text-4xl lg:text-5xl text-[#12281b] tracking-tight">
        Choose Your Khao Sok Expedition
      </h2>
      <p class="text-[#2e5339] text-base sm:text-lg font-light leading-relaxed">
        All packages include fresh daily breakfast, licensed park activities, and our warm family hospitality with zero advance deposit required.
      </p>
    </div>
  )}

  <!-- Homogenized Bento Grid Layout -->
  <div class="space-y-6 sm:space-y-8">
    
    <!-- Row 1: The 2 Premier Lake Overnight Packages (Balanced 50/50 Grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 items-stretch">
      {premierPackages.map((pkg) => (
        <div class="group relative flex flex-col justify-between rounded-3xl bg-white border border-[#12281b]/10 hover:border-[#ba9038]/60 shadow-xl hover:shadow-2xl transition-all duration-500 overflow-hidden backdrop-blur-md" data-package-gallery id={`pkg-gallery-${pkg.id}`}>
          
          <!-- Top Photo Frame: Interactive Diaporama -->
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#12281b] shrink-0 select-none group/img">
            
            <!-- Main Clickable Image -->
            <div class="w-full h-full cursor-zoom-in relative" data-main-click title="Click to view full screen">
              <img
                data-main-img
                src={pkg.photos[0].src}
                alt={`${pkg.title} — ${pkg.photos[0].label}`}
                class="w-full h-full object-cover object-center transition-opacity duration-300 filter brightness-[1.01] contrast-[1.02]"
                loading="lazy"
                decoding="async"
                width="800"
                height="500"
              />
              <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div>

              <!-- Zoom Hint Pill on Hover -->
              <div class="absolute bottom-4 left-4 hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/50 text-white text-[10px] font-mono tracking-wide backdrop-blur-md border border-white/15 opacity-0 group-hover/img:opacity-100 transition-opacity pointer-events-none z-10">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                <span>Click to zoom</span>
              </div>
            </div>

            <!-- Prev Arrow Button -->
            <button
              type="button"
              data-prev-btn
              aria-label="Previous photo"
              class="absolute left-2.5 top-1/2 -translate-y-1/2 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 hover:bg-black/80 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>

            <!-- Next Arrow Button -->
            <button
              type="button"
              data-next-btn
              aria-label="Next photo"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 hover:bg-black/80 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>

            <!-- Top Badges Overlay -->
            <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between gap-2 z-10 pointer-events-none">
              <span class="px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase tracking-[0.16em] font-bold shadow-md backdrop-blur-md border bg-gradient-to-r from-[#ba9038] to-[#d8b257] text-[#12281b] border-[#ba9038]">
                {pkg.badge}
              </span>
              <span
                data-counter
                class="px-2.5 py-1 rounded-full bg-black/60 text-white font-mono text-[10px] font-semibold backdrop-blur-md border border-white/20 shadow-sm"
              >
                1 / {pkg.photos.length}
              </span>
            </div>

            <!-- Bottom Photo Overlay: Duration & Price Tag -->
            <div class="absolute bottom-4 left-5 right-5 z-10 flex items-end justify-between gap-3 pointer-events-none">
              <div>
                <span class="px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-[11px] font-mono text-[#ebd082] uppercase tracking-wider font-semibold border border-white/10">
                  {pkg.duration}
                </span>
              </div>
              <div class="bg-black/75 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-white/15 text-right shrink-0 shadow-lg">
                <span class="text-[10px] text-white/70 uppercase font-mono block">From</span>
                <p class="text-xl font-bold font-mono text-[#ebd082] leading-none">
                  {pkg.currency}{pkg.price}
                  <span class="text-[10px] font-normal text-white/80 block mt-0.5">{pkg.unit}</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Clickable Thumbnails Row -->
          <div class="px-3 sm:px-4 py-2.5 bg-[#faf8f5] border-b border-[#12281b]/10 grid grid-cols-5 gap-1.5 sm:gap-2">
            {pkg.photos.map((photo, tIdx) => (
              <button
                type="button"
                data-thumb-btn
                data-index={tIdx}
                data-src={photo.src}
                data-alt={`${pkg.title} — ${photo.label}`}
                aria-label={`View ${photo.label}`}
                aria-selected={tIdx === 0 ? "true" : "false"}
                class={`relative rounded-lg overflow-hidden aspect-[4/3] transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ba9038] group ${
                  tIdx === 0
                    ? "ring-2 ring-[#ba9038] ring-offset-1 opacity-100 scale-[1.03] shadow-sm"
                    : "opacity-60 hover:opacity-100 border border-[#12281b]/15"
                }`}
              >
                <img
                  src={photo.src}
                  alt={`${pkg.title} — ${photo.label}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                  width="150"
                  height="100"
                />
              </button>
            ))}
          </div>

          <!-- Card Body Content -->
          <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <!-- Title & Stay Breakdown -->
              <div>
                <h3 class="font-monumental text-2xl text-[#12281b] group-hover:text-[#ba9038] transition-colors leading-tight mb-2">
                  {pkg.title}
                </h3>
                <div class="flex items-center gap-2 text-xs font-mono text-[#255038] bg-[#f4efeb] px-3.5 py-2 rounded-xl border border-[#12281b]/5 font-medium">
                  <svg class="w-4 h-4 text-[#ba9038] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  <span>{pkg.stayType}</span>
                </div>
              </div>

              <!-- Inclusions Checklist -->
              <ul class="space-y-2.5 text-xs sm:text-sm text-[#223e2c]">
                {pkg.highlights.map((item) => (
                  <li class="flex items-start gap-2.5 leading-relaxed">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#ba9038]/80 shrink-0 mt-2"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <!-- Note -->
              <div class="text-[11px] font-mono text-[#255038] bg-emerald-50/80 p-2.5 rounded-lg border border-emerald-200/60 flex items-center gap-2">
                <span class="text-[10px] font-bold text-[#2e6b45] uppercase tracking-wider bg-white/90 px-2 py-0.5 rounded border border-emerald-200/50">EXPEDITION</span>
                <span>{pkg.note}</span>
              </div>
            </div>

            <!-- Action Buttons Footer -->
            <div class="pt-5 border-t border-[#12281b]/10 flex flex-col sm:flex-row items-center gap-3">
              <a
                href="/booking-khao-sok-accommodation/?tab=package"
                class="w-full sm:flex-1 py-3.5 px-4 rounded-xl bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#a67e2a] hover:to-[#ba9038] text-[#12281b] font-mono text-xs uppercase tracking-widest font-bold text-center transition-all duration-300 shadow-md hover:shadow-lg flex items-center justify-center gap-2 group/btn"
              >
                <span>Book This Package</span>
                <span class="transition-transform group-hover/btn:translate-x-1">→</span>
              </a>

              <a
                href={pkg.slug}
                class="w-full sm:w-auto py-3.5 px-5 rounded-xl border border-[#12281b]/15 hover:border-[#12281b]/40 hover:bg-[#f4efeb] text-[#12281b] font-mono text-xs uppercase tracking-wider font-semibold text-center transition-all duration-300"
              >
                Full Itinerary
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Row 2: The 3 Discovery & Adventure Packages (Balanced 3-Column Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {explorerPackages.map((pkg) => (
        <div class="group relative flex flex-col justify-between rounded-3xl bg-white border border-[#12281b]/10 hover:border-[#ba9038]/60 shadow-xl hover:shadow-2xl transition-all duration-500 overflow-hidden backdrop-blur-md" data-package-gallery id={`pkg-gallery-${pkg.id}`}>
          
          <!-- Top Photo Frame: Interactive Diaporama -->
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#12281b] shrink-0 select-none group/img">
            
            <!-- Main Clickable Image -->
            <div class="w-full h-full cursor-zoom-in relative" data-main-click title="Click to view full screen">
              <img
                data-main-img
                src={pkg.photos[0].src}
                alt={`${pkg.title} — ${pkg.photos[0].label}`}
                class="w-full h-full object-cover object-center transition-opacity duration-300 filter brightness-[1.01] contrast-[1.02]"
                loading="lazy"
                decoding="async"
                width="600"
                height="400"
              />
              <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div>

              <!-- Zoom Hint Pill on Hover -->
              <div class="absolute bottom-4 left-4 hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/50 text-white text-[10px] font-mono tracking-wide backdrop-blur-md border border-white/15 opacity-0 group-hover/img:opacity-100 transition-opacity pointer-events-none z-10">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                <span>Zoom</span>
              </div>
            </div>

            <!-- Prev Arrow Button -->
            <button
              type="button"
              data-prev-btn
              aria-label="Previous photo"
              class="absolute left-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/45 hover:bg-black/80 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>

            <!-- Next Arrow Button -->
            <button
              type="button"
              data-next-btn
              aria-label="Next photo"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/45 hover:bg-black/80 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>

            <!-- Top Badges Overlay -->
            <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between gap-2 z-10 pointer-events-none">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-[0.16em] font-bold shadow-md backdrop-blur-md border bg-white/95 text-[#12281b] border-white/20">
                {pkg.badge}
              </span>
              <span
                data-counter
                class="px-2.5 py-1 rounded-full bg-black/60 text-white font-mono text-[10px] font-semibold backdrop-blur-md border border-white/20 shadow-sm"
              >
                1 / {pkg.photos.length}
              </span>
            </div>

            <!-- Bottom Photo Overlay: Duration & Price Tag -->
            <div class="absolute bottom-4 left-5 right-5 z-10 flex items-end justify-between gap-3 pointer-events-none">
              <div>
                <span class="px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-[11px] font-mono text-[#ebd082] uppercase tracking-wider font-semibold border border-white/10">
                  {pkg.duration}
                </span>
              </div>
              <div class="bg-black/75 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/15 text-right shrink-0 shadow-lg">
                <span class="text-[10px] text-white/70 uppercase font-mono block">From</span>
                <p class="text-lg font-bold font-mono text-[#ebd082] leading-none">
                  {pkg.currency}{pkg.price}
                  <span class="text-[10px] font-normal text-white/80 block mt-0.5">{pkg.unit}</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Clickable Thumbnails Row -->
          <div class="px-3 sm:px-4 py-2 bg-[#faf8f5] border-b border-[#12281b]/10 grid grid-cols-5 gap-1.5 sm:gap-2">
            {pkg.photos.map((photo, tIdx) => (
              <button
                type="button"
                data-thumb-btn
                data-index={tIdx}
                data-src={photo.src}
                data-alt={`${pkg.title} — ${photo.label}`}
                aria-label={`View ${photo.label}`}
                aria-selected={tIdx === 0 ? "true" : "false"}
                class={`relative rounded-lg overflow-hidden aspect-[4/3] transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ba9038] group ${
                  tIdx === 0
                    ? "ring-2 ring-[#ba9038] ring-offset-1 opacity-100 scale-[1.03] shadow-sm"
                    : "opacity-60 hover:opacity-100 border border-[#12281b]/15"
                }`}
              >
                <img
                  src={photo.src}
                  alt={`${pkg.title} — ${photo.label}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                  width="120"
                  height="80"
                />
              </button>
            ))}
          </div>

          <!-- Card Body Content -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <!-- Title & Stay Breakdown -->
              <div>
                <h3 class="font-monumental text-xl text-[#12281b] group-hover:text-[#ba9038] transition-colors leading-tight mb-2 min-h-[3rem] flex items-center">
                  {pkg.title}
                </h3>
                <div class="flex items-center gap-2 text-xs font-mono text-[#255038] bg-[#f4efeb] px-3.5 py-2 rounded-xl border border-[#12281b]/5 font-medium">
