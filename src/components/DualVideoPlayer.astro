---
// DualVideoPlayer.astro — 2026 Elite Interactive Media Showcase
// Solves duplicate stacked videos by providing a unified, luxury tabbed media viewer:
// Tab 1: Full Expedition Film (16:9 Widescreen) [Active by Default]
// Tab 2: Quick Highlights Reel (9:16 Vertical Short)
// Only ONE video is rendered/visible at any given time.

interface Props {
  landscapeSrc: string;
  shortSrc?: string;
  landscapeTitle?: string;
  shortTitle?: string;
  caption?: string;
}

const {
  landscapeSrc,
  shortSrc,
  landscapeTitle = "Full Expedition Film",
  shortTitle = "30s Highlights Reel",
  caption
} = Astro.props;

// Generate unique ID per instance
const uniqueId = `video-player-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="my-10 rounded-3xl bg-[#faf8f5] border border-[#12281b]/15 shadow-xl overflow-hidden" id={uniqueId}>
  {shortSrc && (
    <div class="px-5 py-3.5 bg-white border-b border-[#12281b]/10 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#7a5813]"></span>
        <span class="text-xs font-sans uppercase tracking-widest text-[#163824] font-bold">
          {caption || "Video Showcase"}
        </span>
      </div>

      <div class="inline-flex items-center p-1 rounded-xl bg-[#f4efeb] border border-[#12281b]/10 gap-1" role="tablist" aria-label="Video view options">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-tab="landscape"
          class="video-tab-btn active px-3.5 py-1.5 rounded-lg text-xs font-sans uppercase tracking-wider font-semibold transition-all duration-200 cursor-pointer bg-[#12281b] text-white shadow-sm flex items-center gap-1.5"
        >
          <span>🎬</span>
          <span>{landscapeTitle}</span>
        </button>

        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-tab="short"
          class="video-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-sans uppercase tracking-wider font-semibold transition-all duration-200 cursor-pointer text-[#2e5339] hover:text-[#12281b] hover:bg-white/80 flex items-center gap-1.5"
        >
          <span>📱</span>
          <span>{shortTitle}</span>
        </button>
      </div>
    </div>
  )}

  <div class="relative bg-black">
    <div data-view="landscape" class="w-full aspect-video">
      <iframe
        class="w-full h-full"
        src={landscapeSrc}
        title={landscapeTitle}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    {shortSrc && (
      <div data-view="short" class="is-hidden w-full py-8 px-4 bg-gradient-to-b from-[#0b1910] via-[#12281b] to-[#0b1910] flex items-center justify-center">
        <div class="w-full max-w-[340px] aspect-[9/16] rounded-2xl overflow-hidden shadow-2xl border border-white/20 bg-black">
          <iframe
            class="w-full h-full"
            src={shortSrc}
            title={shortTitle}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    )}
  </div>
</div>

<style>
  [data-view].is-hidden {
    display: none !important;
  }
</style>

<script>
  function setupDualVideoPlayers() {
    const players = document.querySelectorAll('[id^="video-player-"]');
    players.forEach((player) => {
      const tabs = player.querySelectorAll('.video-tab-btn');
      const landscapeView = player.querySelector('[data-view="landscape"]');
      const shortView = player.querySelector('[data-view="short"]');

      if (!landscapeView || !shortView || tabs.length < 2) return;

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-tab');

          tabs.forEach((t) => {
            t.classList.remove('active', 'bg-[#12281b]', 'text-white', 'shadow-sm');
            t.classList.add('text-[#2e5339]');
            t.setAttribute('aria-selected', 'false');
          });

          tab.classList.add('active', 'bg-[#12281b]', 'text-white', 'shadow-sm');
          tab.classList.remove('text-[#2e5339]');
          tab.setAttribute('aria-selected', 'true');

          if (target === 'landscape') {
            landscapeView.classList.remove('is-hidden');
            shortView.classList.add('is-hidden');
          } else {
            shortView.classList.remove('is-hidden');
            landscapeView.classList.add('is-hidden');
          }
        });
      });
    });
  }

  // Initialize on load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDualVideoPlayers);
  } else {
    setupDualVideoPlayers();
  }
  document.addEventListener('astro:page-load', setupDualVideoPlayers);
</script>
