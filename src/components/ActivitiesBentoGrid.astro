---
// ActivitiesBentoGrid.astro — 2026 Elite Bento Grid for Khao Sok Activities
// Interactive Diaporamas with Clickable Thumbnails, Navigation Arrows, Counter & Fullscreen Lightbox Zoom

interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;

const categories = [
  {
    id: 'lake-tours',
    title: 'Lake Tours',
    badge: 'Signature Lake Trips',
    subtitle: 'Emerald waters, floating raft houses & limestone karsts',
    photos: [
      { src: '/wp-content/uploads/2016/07/khao-sok-national-park-2.jpg', label: 'Cheow Lan Lake Limestone Karsts' },
      { src: '/wp-content/uploads/2017/03/GrandAdventure_Package_Tours_Lake_MG_7674.jpg', label: 'Scenic Longtail Boat Safari' },
      { src: '/wp-content/uploads/2017/02/GrandAdventure_Package_Tours_Lake_MG_7772_crop.jpg', label: 'Floating Bamboo Bungalows' },
      { src: '/wp-content/uploads/2025/01/Riverside-Rafthouse-Cover.jpg', label: 'Morning Mist on Emerald Waters' },
    ],
    mainHref: '/khao-sok-lake-cheow-lan-tours/',
    actionLabel: 'Explore Lake Tours',
    items: [
      {
        name: 'Full Day Cheow Lan Lake Tour',
        price: 'Full Day Excursion',
        detail: 'Scenic longtail boat safari, Guilin rock karsts & floating restaurant lunch',
        href: '/khao-sok-lake-cheow-lan-tours/',
      },
      {
        name: 'Overnight at the Lake',
        price: 'Floating Raft House',
        detail: 'Bungalow on emerald water, night safari & dawn mist cruise',
        href: '/khao-sok-floating-bungalows/',
      },
      {
        name: 'Private Overnight Lake Trips',
        price: 'Custom Itinerary',
        detail: 'Exclusive private longtail boat & bespoke lake expedition schedule',
        href: '/khao-sok-lake-cheow-lan-tours/',
      },
    ],
  },
  {
    id: 'thai-culture',
    title: 'Thai Culture & Spa',
    badge: 'Healing Arts & Heritage',
    subtitle: 'Ancient healing traditions, culinary arts & geothermal springs',
    photos: [
      { src: '/wp-content/uploads/2015/09/Thai-Massage1.jpg', label: 'Traditional Thai Massage by the River' },
      { src: '/wp-content/uploads/2022/05/jungle-cooking-exeperience-2.jpg', label: 'Bamboo Cooking Experience' },
      { src: '/wp-content/uploads/2024/03/jungle-food-1e.jpg', label: 'Fresh Authentic Thai Meal' },
      { src: '/wp-content/uploads/2024/03/jungle-drinks.jpg', label: 'Jungle Herbal Drinks' },
    ],
    mainHref: '/khao-sok-thailand-culture/',
    actionLabel: 'Explore Culture & Spa',
    items: [
      {
        name: 'Thai Jungle Cooking',
        price: '1,500 THB',
        detail: 'Organic farm visit, fresh bamboo cooking & authentic curry preparation',
        href: '/khao-sok-thailand-culture/',
      },
      {
        name: 'Traditional Thai Massage',
        price: '600 THB',
        detail: 'Soothing therapeutic massage beside the gently flowing Sok River',
        href: '/khao-sok-thailand-culture/',
      },
      {
        name: 'Romanee Hot Springs',
        price: '650 THB',
        detail: 'Natural geothermal mineral baths surrounded by lush tropical jungle',
        href: '/khao-sok-hot-springs/',
      },
    ],
  },
  {
    id: 'hiking',
    title: 'Hiking & Trekking',
    badge: 'Rainforest Trails',
    subtitle: 'Guided treks through 160-million-year-old primary jungle',
    photos: [
      { src: '/wp-content/uploads/2023/03/jungle-hiking-1500-1000.jpg', label: 'Primary Rainforest Trail Hike' },
      { src: '/wp-content/uploads/2024/03/khao-sok-jungle-hike-e.jpg', label: 'Deep Jungle Trekking' },
      { src: '/wp-content/uploads/2024/03/jungle-day-night-1.jpg', label: 'Nocturnal Safari Expedition' },
      { src: '/wp-content/uploads/2017/02/GrandAdventure_Package_Wildlife_MG_7162.jpg', label: 'Rainforest Wildlife Watching' },
    ],
    mainHref: '/khao-sok-trekking-hiking/',
    actionLabel: 'Explore Hiking & Trekking',
    items: [
      { name: 'Half Day Rainforest Hike', price: '700 THB', href: '/khao-sok-trekking-hiking/' },
      { name: 'Full Day Jungle Trek', price: '1,400 THB', href: '/khao-sok-trekking-hiking/' },
      { name: 'Night Safari Expedition', price: '700 THB', href: '/khao-sok-night-safari/' },
      { name: 'Jungle Day, Jungle Night', price: '1,600 THB', href: '/khao-sok-trekking-hiking/' },
      { name: 'Rafflesia – Giant Flower', price: 'Seasonal Trek', href: '/khao-sok-trekking-hiking/' },
      { name: 'Bang Man Cave Hike', price: '1,800 THB', href: '/khao-sok-cave-raft-hike-tour/' },
    ],
  },
  {
    id: 'local-adventures',
    title: 'Local Adventures',
    badge: 'River & Wildlife',
    subtitle: 'Sok river rapids, ethical elephant care & jungle camping',
    photos: [
      { src: '/wp-content/uploads/2015/09/Khao-Sok-Canoe-Trip.jpg', label: 'Scenic Sok River Canoe Trip' },
      { src: '/wp-content/uploads/2024/03/Mahout-washing-his-elephant.jpg', label: 'Ethical Elephant River Care' },
      { src: '/wp-content/uploads/2026/03/bamboo-rafting-khao-sok.jpg', label: 'Traditional Bamboo Rafting' },
      { src: '/wp-content/uploads/2023/05/jungle-camping.jpg', label: 'Overnight Jungle Camping' },
    ],
    mainHref: '/khao-sok-canoe-trips/',
    actionLabel: 'Explore Local Adventures',
    items: [
      { name: 'Scenic Canoe Trip', price: '750 THB', href: '/khao-sok-canoe-trips/' },
      { name: 'River Tubing Adventure', price: '500 THB', href: '/khao-sok-river-tubing/' },
      { name: 'Ethical Elephant Experience', price: '1,500 THB', href: '/khao-sok-elephant-experience/' },
      { name: 'Cave / Bamboo Raft / Hike', price: '1,700 THB', href: '/khao-sok-cave-raft-hike-tour/' },
      { name: 'Rainforest Bird Watching', price: '1,700 THB', href: '/khao-sok-thailand-adventures/' },
      { name: 'Overnight Jungle Camping', price: '3,000 THB', href: '/khao-sok-thailand-adventures/' },
    ],
  },
];
---

<div class="space-y-12 my-8">
  {showTitle && (
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#7a5813]/10 border border-[#7a5813]/25 text-[#7a5813] text-xs font-sans uppercase tracking-[0.2em] font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813]"></span>
        <span>Four Adventure Chapters · Reserve Upon Arrival</span>
      </div>
      <h2 class="font-monumental text-3xl sm:text-4xl lg:text-5xl text-[#12281b] tracking-tight">
        Choose Your Adventure
      </h2>
      <p class="text-[#2e5339] text-base sm:text-lg font-light leading-relaxed">
        From Cheow Lan lake day tours to overnight floating raft houses, river canoeing and jungle night safaris — our local naturalist guides take care of everything.
      </p>
    </div>
  )}

  <!-- 2026 Elite Bento Grid: Balanced 2-Column Responsive Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
    {categories.map((cat) => (
      <div class="group relative flex flex-col justify-between rounded-3xl bg-white border border-[#12281b]/10 hover:border-[#7a5813]/40 shadow-xl hover:shadow-2xl transition-all duration-500 overflow-hidden backdrop-blur-md" data-activity-gallery id={`act-gallery-${cat.id}`}>
        
        <!-- Photographic Banner: Interactive Diaporama -->
        <div class="relative w-full h-64 sm:h-72 overflow-hidden bg-[#12281b] shrink-0 select-none group/img">
          
          <!-- Main Clickable Image -->
          <div class="w-full h-full cursor-zoom-in relative" data-main-click title="Click to view full screen">
            <img
              data-main-img
              src={cat.photos[0].src}
              alt={`${cat.title} — ${cat.photos[0].label}`}
              class="w-full h-full object-cover object-center transition-opacity duration-300 filter brightness-[0.98] contrast-[1.02]"
              loading="lazy"
              decoding="async"
              width="800"
              height="500"
            />
            <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/90 via-black/35 to-transparent pointer-events-none"></div>

            <!-- Zoom Hint Pill on Hover -->
            <div class="absolute bottom-4 left-4 hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/50 text-white text-[11px] font-sans tracking-wide backdrop-blur-md border border-white/15 opacity-0 group-hover/img:opacity-100 transition-opacity pointer-events-none z-10">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
              <span>Zoom</span>
            </div>
          </div>

          <!-- Prev Arrow Button -->
          <button
            type="button"
            data-prev-btn
            aria-label="Previous photo"
            class="absolute left-2.5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/85 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Next Arrow Button -->
          <button
            type="button"
            data-next-btn
            aria-label="Next photo"
            class="absolute right-2.5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-black/85 text-white flex items-center justify-center backdrop-blur-md border border-white/20 transition-all opacity-85 hover:opacity-100 hover:scale-105 shadow-md z-10 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Top Badge Overlay -->
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2 z-10 pointer-events-none">
            <span class="px-3.5 py-1.5 rounded-full text-[11px] font-sans uppercase tracking-[0.16em] font-semibold shadow-md backdrop-blur-md border bg-white/95 text-[#12281b] border-white/20">
              {cat.badge}
            </span>
            <span
              data-counter
              class="px-2.5 py-1 rounded-full bg-black/60 text-white font-sans text-[11px] font-medium backdrop-blur-md border border-white/20 shadow-sm"
            >
              1 / {cat.photos.length}
            </span>
          </div>

          <!-- Bottom Photo Title & Subtitle Overlay -->
          <div class="absolute bottom-4 left-5 right-5 z-10 pointer-events-none">
            <h3 class="font-monumental text-2xl sm:text-3xl text-white group-hover:text-[#f7e6b5] transition-colors drop-shadow-md leading-tight">
              {cat.title}
            </h3>
            <p class="text-white/85 text-xs font-sans tracking-wider mt-1 drop-shadow">
              {cat.subtitle}
            </p>
          </div>
        </div>

        <!-- Clickable Thumbnails Row -->
        <div class="px-4 py-2.5 bg-[#faf8f5] border-b border-[#12281b]/10 grid grid-cols-4 gap-2">
          {cat.photos.map((photo, tIdx) => (
            <button
              type="button"
              data-thumb-btn
              data-index={tIdx}
              data-src={photo.src}
              data-alt={`${cat.title} — ${photo.label}`}
              aria-label={`View ${photo.label}`}
              aria-selected={tIdx === 0 ? "true" : "false"}
              class={`relative rounded-lg overflow-hidden aspect-[16/10] transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7a5813] group ${
                tIdx === 0
                  ? "ring-2 ring-[#7a5813] ring-offset-1 opacity-100 scale-[1.03] shadow-sm"
                  : "opacity-60 hover:opacity-100 border border-[#12281b]/15"
              }`}
            >
              <img
                src={photo.src}
                alt={`${cat.title} — ${photo.label}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
                width="150"
                height="95"
              />
            </button>
          ))}
        </div>

        <!-- Body Content: Authentic Activities List with Prices & Comfortable Spacing -->
        <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between gap-6">
          <ul class="space-y-3">
            {cat.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group/item block p-3.5 rounded-2xl border border-transparent hover:border-[#7a5813]/25 hover:bg-[#f4efeb] transition-all duration-200"
                >
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#7a5813] shrink-0"></span>
                      <span class="font-semibold text-sm sm:text-base text-[#163824] group-hover/item:text-[#7a5813] transition-colors truncate">
                        {item.name}
                      </span>
                    </div>
                    <span class="text-xs font-sans font-semibold text-[#7a5813] bg-[#7a5813]/10 px-3 py-1 rounded-lg shrink-0 whitespace-nowrap shadow-xs">
                      {item.price}
                    </span>
                  </div>
                  {item.detail && (
                    <p class="text-xs text-[#2e5339]/80 pl-6 mt-1.5 font-light leading-relaxed">
                      {item.detail}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>

          <!-- Action Footer Button -->
          <div class="pt-5 border-t border-[#12281b]/10 mt-auto">
            <a
              href={cat.mainHref}
              class="w-full py-3.5 px-5 rounded-xl bg-[#faf8f5] hover:bg-[#12281b] border border-[#12281b]/15 hover:border-[#12281b] text-[#12281b] hover:text-white font-sans text-xs uppercase tracking-widest font-semibold text-center transition-all duration-300 flex items-center justify-center gap-2 group/btn shadow-sm min-h-[44px]"
            >
              <span>{cat.actionLabel}</span>
              <span class="transition-transform group-hover/btn:translate-x-1.5">→</span>
            </a>
          </div>
        </div>

      </div>
    ))}
  </div>

  <!-- Authentic Reception Notice Callout Banner (Matching Original Site) -->
  <div class="bg-gradient-to-br from-[#1c3d24] via-[#163824] to-[#0f2518] rounded-3xl p-6 sm:p-10 text-white shadow-2xl border border-[#ba9038]/30 flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="space-y-3 text-center md:text-left max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-[#ebd082] text-xs font-sans uppercase tracking-widest font-semibold">
        <span>CONCIERGE & RECEPTION DESK</span>
      </div>
      <h3 class="font-monumental text-xl sm:text-2xl text-white leading-snug">
        You can book all your Khao Sok tours with reception when you arrive.
      </h3>
      <p class="text-emerald-100/90 text-sm font-light leading-relaxed">
        For best results, especially during high season for floating lake bungalows and private guides, we recommend reserving a tour package in advance.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3.5 shrink-0">
      <a
        href="/khao-sok-tour-packages/"
        class="py-3.5 px-6 rounded-xl bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#a67e2a] hover:to-[#ba9038] text-[#12281b] font-sans text-xs uppercase tracking-widest font-bold text-center transition-all duration-300 shadow-lg hover:shadow-xl flex items-center gap-2 min-h-[44px]"
      >
        <span>Browse Packages</span>
        <span>→</span>
      </a>
      <a
        href="/booking-khao-sok-accommodation/"
        class="py-3.5 px-6 rounded-xl border border-white/20 hover:border-white/50 hover:bg-white/10 text-white font-sans text-xs uppercase tracking-widest font-semibold text-center transition-all duration-300 min-h-[44px] flex items-center justify-center"
      >
        Book Rooms Only
      </a>
    </div>
  </div>
</div>

<!-- Fullscreen Activity Lightbox Modal -->
<div
  id="activity-lightbox"
  class="fixed inset-0 z-[999] hidden bg-black/95 backdrop-blur-md flex items-center justify-center p-4 sm:p-8 select-none"
  role="dialog"
  aria-modal="true"
  aria-label="Activity image fullscreen preview"
>
  <button
    id="act-lightbox-close"
    type="button"
    aria-label="Close fullscreen gallery"
    class="absolute top-5 right-5 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer z-30 backdrop-blur-sm border border-white/20"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="absolute top-5 left-5 flex items-center gap-3 z-30">
    <span id="act-lightbox-counter" class="font-sans text-xs text-white/90 bg-black/50 px-3 py-1.5 rounded-full border border-white/15 backdrop-blur-sm font-medium">
      1 / 4
    </span>
    <span id="act-lightbox-caption" class="hidden sm:inline-block font-display text-sm text-white/80 drop-shadow">
      Activity View
    </span>
  </div>

  <button
    id="act-lightbox-prev"
    type="button"
    aria-label="Previous photo"
    class="absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer z-30 backdrop-blur-sm border border-white/20 hover:scale-105"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button
    id="act-lightbox-next"
    type="button"
    aria-label="Next photo"
    class="absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer z-30 backdrop-blur-sm border border-white/20 hover:scale-105"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div class="relative max-w-6xl max-h-[88vh] flex items-center justify-center overflow-hidden">
    <img
      id="act-lightbox-img"
      src=""
      alt="Full screen activity photo"
      class="max-w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl transition-opacity duration-200"
    />
  </div>
</div>

<script is:inline>
  (function () {
    function setupActivityGalleries() {
      const galleries = document.querySelectorAll('[data-activity-gallery]');
      const lightbox = document.getElementById('activity-lightbox');
      const lightboxImg = document.getElementById('act-lightbox-img');
      const lightboxCounter = document.getElementById('act-lightbox-counter');
      const lightboxCaption = document.getElementById('act-lightbox-caption');
      const lightboxClose = document.getElementById('act-lightbox-close');
      const lightboxPrev = document.getElementById('act-lightbox-prev');
      const lightboxNext = document.getElementById('act-lightbox-next');

      let activeImages = [];
      let activeIndex = 0;

      function updateLightbox() {
        if (!lightbox || !lightboxImg || !activeImages.length) return;
        const current = activeImages[activeIndex];
        lightboxImg.style.opacity = '0.4';
        lightboxImg.src = current.src;
        lightboxImg.alt = current.alt || 'Activity view';
        lightboxImg.onload = () => { lightboxImg.style.opacity = '1'; };
        setTimeout(() => { lightboxImg.style.opacity = '1'; }, 100);

        if (lightboxCounter) {
          lightboxCounter.textContent = (activeIndex + 1) + ' / ' + activeImages.length;
        }
        if (lightboxCaption) {
          lightboxCaption.textContent = current.alt || '';
        }
      }

      function openLightbox(images, index) {
        if (!lightbox) return;
        activeImages = images;
        activeIndex = index;
        updateLightbox();
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }

      if (lightboxClose) lightboxClose.onclick = closeLightbox;
      if (lightbox) {
        lightbox.onclick = (e) => {
          if (e.target === lightbox || e.target.parentElement === lightbox) {
            closeLightbox();
          }
        };
      }
      if (lightboxPrev) {
        lightboxPrev.onclick = (e) => {
          e.stopPropagation();
          activeIndex = (activeIndex - 1 + activeImages.length) % activeImages.length;
          updateLightbox();
        };
      }
      if (lightboxNext) {
        lightboxNext.onclick = (e) => {
          e.stopPropagation();
          activeIndex = (activeIndex + 1) % activeImages.length;
          updateLightbox();
        };
      }

      document.addEventListener('keydown', (e) => {
        if (!lightbox || lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') {
          activeIndex = (activeIndex - 1 + activeImages.length) % activeImages.length;
          updateLightbox();
        }
        if (e.key === 'ArrowRight') {
          activeIndex = (activeIndex + 1) % activeImages.length;
          updateLightbox();
        }
      });

      galleries.forEach((gallery) => {
        if (gallery.dataset.actReady === 'true') return;
        gallery.dataset.actReady = 'true';

        const mainImg = gallery.querySelector('[data-main-img]');
        const counter = gallery.querySelector('[data-counter]');
        const prevBtn = gallery.querySelector('[data-prev-btn]');
        const nextBtn = gallery.querySelector('[data-next-btn]');
        const mainClick = gallery.querySelector('[data-main-click]');
        const thumbs = Array.from(gallery.querySelectorAll('[data-thumb-btn]'));

        const images = thumbs.map((btn) => ({
          src: btn.getAttribute('data-src') || '',
          alt: btn.getAttribute('data-alt') || '',
        }));

        let currentIndex = 0;

        function setPhoto(idx) {
          if (idx < 0) idx = images.length - 1;
          if (idx >= images.length) idx = 0;
          currentIndex = idx;

          const activeData = images[currentIndex];
          if (!activeData) return;

          if (mainImg) {
            mainImg.style.opacity = '0.4';
            mainImg.src = activeData.src;
            mainImg.alt = activeData.alt;
            mainImg.onload = () => { mainImg.style.opacity = '1'; };
            setTimeout(() => { mainImg.style.opacity = '1'; }, 100);
          }

          if (counter) {
            counter.textContent = (currentIndex + 1) + ' / ' + images.length;
          }

          thumbs.forEach((btn, i) => {
            if (i === currentIndex) {
              btn.classList.remove('opacity-60', 'border', 'border-[#12281b]/15');
              btn.classList.add('ring-2', 'ring-[#ba9038]', 'ring-offset-1', 'opacity-100', 'scale-[1.03]', 'shadow-sm');
              btn.setAttribute('aria-selected', 'true');
            } else {
              btn.classList.add('opacity-60', 'border', 'border-[#12281b]/15');
              btn.classList.remove('ring-2', 'ring-[#ba9038]', 'ring-offset-1', 'opacity-100', 'scale-[1.03]', 'shadow-sm');
              btn.setAttribute('aria-selected', 'false');
            }
          });
        }

        thumbs.forEach((btn, i) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            setPhoto(i);
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            setPhoto(currentIndex - 1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            setPhoto(currentIndex + 1);
          });
        }

        if (mainClick) {
          mainClick.addEventListener('click', () => {
            openLightbox(images, currentIndex);
          });
        }

        let touchStartX = 0;
        let touchEndX = 0;
        gallery.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        gallery.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          if (touchStartX - touchEndX > 45) {
            setPhoto(currentIndex + 1);
          } else if (touchEndX - touchStartX > 45) {
            setPhoto(currentIndex - 1);
          }
        }, { passive: true });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupActivityGalleries);
    } else {
      setupActivityGalleries();
    }
    document.addEventListener('astro:page-load', setupActivityGalleries);
  })();
</script>
