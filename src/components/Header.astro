---
// Header.astro — Borgo Egnazia Minimal Top Bar & Curated Overlay Menu
// 100% Responsive Mobile & Tablet
interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const withBase = (path: string) => {
  if (!path || !path.startsWith('/') || (base && path.startsWith(base))) return path;
  return `${base}${path}`;
};
---

<header
  id="main-nav"
  data-is-home={isHome ? "true" : "false"}
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-3 px-4 sm:py-3.5 sm:px-6 lg:px-12 ${
    isHome
      ? "bg-transparent border-b border-transparent"
      : "bg-gradient-to-b from-black/60 via-black/20 to-transparent border-b border-transparent"
  }`}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">

    <!-- Burger (Home page / transparent navbar) -->
    <div class="flex items-center gap-2 sm:gap-4">
      <button
        id="home-burger"
        class={`group flex flex-col justify-center gap-1.5 w-9 h-9 p-1 cursor-pointer focus:outline-none transition-opacity ${
          isHome ? "opacity-100" : "hidden"
        }`}
        aria-label="Open Navigation"
      >
        <span class="block w-6 h-[1.5px] bg-white transition-all group-hover:w-7 group-hover:bg-gold-400"></span>
        <span class="block w-6 h-[1.5px] bg-white transition-all group-hover:w-7 group-hover:bg-gold-400"></span>
        <span class="block w-6 h-[1.5px] bg-white transition-all group-hover:w-7 group-hover:bg-gold-400"></span>
      </button>

      <!-- Brand -->
      <a
        id="nav-brand"
        href="/"
        class={`flex items-center gap-2 sm:gap-3.5 group transition-all duration-500 ${
          isHome ? "opacity-0 -translate-x-4 pointer-events-none" : "opacity-100 translate-x-0"
        }`}
      >
        <div class="stamped-brass-badge w-8 h-8 sm:w-10 sm:h-10 rounded-full p-[2px] flex items-center justify-center shrink-0">
          <img
            src="/wp-content/uploads/2015/10/ksr-icon-114-114.jpg"
            alt="Khao Sok Riverside Cottages"
            width="36"
            height="36"
            class="w-full h-full rounded-full object-cover filter contrast-[1.08] brightness-[0.98]"
            loading="eager"
          />
        </div>
        <div>
          <p class="nav-brand-title font-monumental text-xs sm:text-sm tracking-[0.12em] sm:tracking-[0.14em] uppercase transition-colors leading-tight">
            Khao Sok <span class="nav-brand-accent font-display font-light italic tracking-normal normal-case">Riverside</span>
          </p>
        </div>
      </a>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-4">
      
      <!-- Language Switcher -->
      <div class="lang-switch flex items-center p-0.5 rounded-full select-none transition-all font-sans text-[10px] sm:text-xs tracking-widest uppercase">
        <button
          type="button"
          data-lang="th"
          class="lang-btn px-2 sm:px-2.5 py-0.5 rounded-full transition-all cursor-pointer focus:outline-none"
          title="ภาษาไทย"
        >
          TH
        </button>
        <span class="lang-divider opacity-30 text-[9px] px-0.5">|</span>
        <button
          type="button"
          data-lang="en"
          class="lang-btn px-2 sm:px-2.5 py-0.5 rounded-full transition-all cursor-pointer focus:outline-none"
          title="English"
        >
          EN
        </button>
      </div>

      <!-- Reservation Button -->
      <a
        id="nav-book-btn"
        href="/booking-khao-sok-accommodation/"
        class={`items-center gap-1.5 px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full bg-gradient-to-r from-[#ba9038] to-[#d8b257] hover:from-[#c99f3e] hover:to-[#ebd082] text-[#12281b] border border-[#ba9038] text-[10px] sm:text-xs font-bold uppercase tracking-[0.14em] sm:tracking-[0.18em] transition-all duration-300 shadow-md hover:shadow-lg ${
          isHome ? "hidden md:inline-flex opacity-0 pointer-events-none" : "flex opacity-100"
        }`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#12281b]"></span>
        <span class="hidden sm:inline">Reservation</span>
        <span class="sm:hidden">Book</span>
      </a>

      <!-- Menu Trigger -->
      <button
        id="menu-trigger"
        class={`group relative items-center gap-1.5 sm:gap-2.5 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full transition-all duration-300 shadow-sm backdrop-blur-md cursor-pointer ${
          isHome ? "hidden" : "flex"
        }`}
        aria-label="Open Curated Navigation"
      >
        <span class="menu-trigger-text font-monumental text-[10px] sm:text-[11px] uppercase tracking-[0.16em] sm:tracking-[0.18em] font-medium">Menu</span>
        <div class="flex flex-col gap-1 w-4 items-end justify-center">
          <span class="menu-bar-top block w-4 h-0.5 rounded-full transition-all group-hover:w-4"></span>
          <span class="menu-bar-mid block w-3 h-0.5 rounded-full transition-all group-hover:w-4"></span>
          <span class="menu-bar-bot block w-2 h-0.5 rounded-full transition-all group-hover:w-4"></span>
        </div>
      </button>
    </div>
  </div>
</header>

<!-- Pinned Vertical "BOOK" Button on Right Screen Edge (Borgo Egnazia Style) -->
<a
  href="/booking-khao-sok-accommodation/"
  class="fixed top-1/2 -translate-y-1/2 right-0 z-40 flex items-center justify-center bg-[#12281b]/90 hover:bg-[#ba9038] text-white hover:text-[#12281b] backdrop-blur-md border-l border-t border-b border-white/20 hover:border-[#ba9038] rounded-l-xl px-2 sm:px-2.5 py-4 sm:py-6 transition-all duration-300 shadow-2xl group cursor-pointer"
  aria-label="Book Direct"
>
  <span class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.25em] sm:tracking-[0.3em] font-bold [writing-mode:vertical-rl] rotate-180 group-hover:tracking-[0.34em] transition-all">
    BOOK
  </span>
</a>


<!-- ============================================================
     OVERLAY MENU — Full-screen, scrollable on mobile
============================================================ -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-[60] opacity-0 pointer-events-none transition-all duration-500 flex flex-col overflow-y-auto bg-[#faf8f5]/98 backdrop-blur-3xl text-[#122319]"
>
  <!-- Background gradients -->
  <div class="absolute top-0 right-0 w-72 sm:w-[550px] h-72 sm:h-[550px] bg-[radial-gradient(circle,rgba(186,144,56,0.07),transparent_70%)] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-72 sm:w-[550px] h-72 sm:h-[550px] bg-[radial-gradient(circle,rgba(37,80,56,0.05),transparent_70%)] pointer-events-none"></div>

  <!-- Botanical accents — hidden on small mobile to keep menu clean -->
  <div class="pointer-events-none absolute right-4 lg:right-12 top-10 w-40 sm:w-60 lg:w-72 z-0 opacity-15 sm:opacity-20 select-none animate-tropical-sway hidden sm:block">
    <img src="/images/stylized-banana-leaf-1.webp" alt="Botanical Foliage" class="w-full h-auto" loading="lazy" />
  </div>

  <!-- Inner container -->
  <div class="relative z-10 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-12 py-4 sm:py-6 flex flex-col min-h-full">

    <!-- Overlay Header -->
    <div class="flex items-center justify-between pb-4 sm:pb-6 border-b border-[#122319]/10">
      <div class="flex items-center gap-2 sm:gap-3">
        <span class="font-handwriting text-[#255038] text-xl sm:text-3xl font-semibold leading-none">The Wild Spirit</span>
        <span class="text-[#122319]/25 hidden sm:inline">•</span>
        <span class="text-[10px] sm:text-xs uppercase tracking-[0.2em] sm:tracking-[0.25em] text-[#ba9038] font-mono font-bold hidden sm:inline">Editorial Index</span>
      </div>
      <div class="flex items-center gap-2 sm:gap-4">
        <!-- Overlay Language -->
        <div class="lang-switch flex items-center gap-1 sm:gap-1.5 text-[#122319] font-sans text-[10px] sm:text-xs tracking-widest uppercase select-none px-2 sm:px-3 py-1 sm:py-1.5 rounded-full bg-white/70 border border-[#122319]/10">
          <button type="button" data-lang="th" class="lang-btn hover:text-[#ba9038] transition-colors cursor-pointer text-[#122319]/60 px-1 py-0.5 rounded focus:outline-none" title="ภาษาไทย">TH</button>
          <span class="opacity-40 text-[10px]">|</span>
          <button type="button" data-lang="en" class="lang-btn hover:text-[#ba9038] transition-colors cursor-pointer font-bold text-[#122319] px-1 py-0.5 rounded focus:outline-none" title="English">EN</button>
        </div>

        <button
          id="menu-close"
          class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full border border-[#122319]/20 hover:border-[#ba9038] bg-white/70 hover:bg-white text-[#122319] hover:text-[#ba9038] transition-all flex items-center gap-1.5 sm:gap-2 text-[10px] sm:text-xs uppercase tracking-widest font-mono font-medium shadow-sm group"
        >
          <span>Close</span>
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform group-hover:rotate-90 duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Content: Nav + Preview -->
    <div class="py-4 sm:py-8 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start flex-1">
      <!-- Navigation chapters -->
      <nav class="lg:col-span-7 space-y-1 sm:space-y-2">
        {[
          {
            num: '01', title: 'Packages', note: 'Guaranteed lowest direct rates',
            href: '/khao-sok-tour-packages/',
            img: '/wp-content/uploads/2025/01/Grand-Jungle-Cover.jpg',
            sublinks: [
              ['Book a Package (Best Value)', '/booking-khao-sok-accommodation/?tab=package'],
              ['All Tour Packages', '/khao-sok-tour-packages/'],
              ['Grand Jungle Tour (4D/3N)', '/4-day-khao-sok-jungle-tour-lake-overnight/'],
              ['Riverside & Rafthouse (3D/2N)', '/3-day-khao-sok-lake-tour/'],
              ['Rainforest Adventure (3D/2N)', '/khao-sok-tour-package-rainforest/'],
              ['Khao Sok Delight (3D/2N)', '/khao-sok-tour-package-delight/'],
              ['Spirit of Khao Sok (2D/1N)', '/khao-sok-package-tour-spirit/'],
            ],
          },
          {
            num: '02', title: 'Cottages', note: 'Traditional riverside architecture',
            href: '/khao-sok-accommodation/',
            img: '/wp-content/uploads/2019/10/Khao-Sok-Riverside-Cottages-Room.jpg',
            sublinks: [
              ['Book a Room', '/booking-khao-sok-accommodation/?tab=room'],
              ['Riverside Cottages', '/khao-sok-accommodation/'],
              ['Floating Bungalows', '/khao-sok-floating-bungalows/'],
              ['Family Rooms', '/khao-sok-family-rooms/'],
              ['Room Rates', '/khao-sok-room-rates/'],
            ],
          },
          {
            num: '03', title: 'Activities', note: 'Deep rainforest & lake adventures',
            href: '/khao-sok-tours/',
            img: '/wp-content/uploads/2023/03/jungle-hiking-1500-1000.jpg',
            sublinks: [
              ['All Activities', '/khao-sok-tours/'],
              ['Cheow Lan Lake Tours', '/khao-sok-lake-cheow-lan-tours/'],
              ['Jungle Trekking', '/khao-sok-trekking-hiking/'],
              ['Night Safari', '/khao-sok-night-safari/'],
              ['River Tubing & Canoeing', '/khao-sok-river-tubing/'],
              ['Hot Springs', '/khao-sok-hot-springs/'],
            ],
          },
          {
            num: '04', title: 'Dining', note: 'Rafflesia Cafe beside the river',
            href: '/khao-sok-restaurant/',
            img: '/wp-content/uploads/2026/05/rafflesia-cafe-khao-sok-restaurant-1.jpg',
            sublinks: [
              ['Rafflesia Cafe', '/khao-sok-restaurant/'],
              ['Thai & Western Menu', '/khao-sok-restaurant/'],
              ['Resort Facilities', '/khao-sok-riverside-resort-facilities/'],
            ],
          },
          {
            num: '05', title: 'The Resort', note: 'Family-owned eco-sanctuary',
            href: '/khao-sok-resort/',
            img: '/wp-content/uploads/2019/10/khao-sok-riverside-cottages-beach.jpg',
            sublinks: [
              ['Our Story', '/khao-sok-resort/'],
              ['Getting Here', '/khao-sok-map-directions/'],
              ['Facilities & Grounds', '/khao-sok-riverside-resort-facilities/'],
              ['Nature Trail', '/riverside-cottages-nature-trail/'],
              ['Sustainability', '/sustainability/'],
              ['Resort FAQs', '/khao-sok-faqs/'],
            ],
          },
          {
            num: '06', title: 'The Park', note: '160 million years of biodiversity',
            href: '/khao-sok-national-park/',
            img: '/wp-content/uploads/2016/07/khao-sok-national-park-2.jpg',
            sublinks: [
              ['National Park Guide', '/khao-sok-national-park/'],
              ['Cheow Lan Lake Guide', '/cheow-lan-lake-information-guide/'],
              ['Wildlife Guide', '/khao-sok-jungle-thailand-rainforest/'],
              ['Thai Culture', '/khao-sok-thailand-culture/'],
              ['Weather & Seasons', '/khao-sok-weather/'],
            ],
          },
          {
            num: '07', title: 'Contact', note: 'Directions, FAQs & Concierge',
            href: '/contact-khao-sok-riverside-cottages/',
            img: '/wp-content/uploads/2018/12/khao-sok-national-park-tours.jpg',
            sublinks: [
              ['Contact Us', '/contact-khao-sok-riverside-cottages/'],
              ['Plan Your Stay', '/plan-your-stay/'],
              ['Map & Directions', '/khao-sok-map-directions/'],
              ['FAQs (46 Questions)', '/khao-sok-faqs/'],
              ['Field Blog', '/khao-sok-blog/'],
            ],
          },
        ].map((item) => (
          <div
            class="menu-item-group px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl sm:rounded-2xl hover:bg-white hover:shadow-xl hover:shadow-[#122319]/5 transition-all duration-300 border border-transparent hover:border-[#122319]/10 group"
            data-preview-img={withBase(item.img)}
            data-preview-title={item.title}
            data-preview-note={item.note}
          >
            <div class="flex items-baseline justify-between mb-0.5 sm:mb-1">
              <a href={item.href} class="font-monumental text-lg sm:text-xl md:text-2xl text-[#122319] group-hover:text-[#ba9038] transition-colors flex items-baseline gap-2 sm:gap-3 tracking-tight">
                <span class="text-[10px] sm:text-xs font-mono text-[#ba9038] font-bold">{item.num}</span>
                <span>{item.title}</span>
              </a>
              <span class="font-handwriting text-[#255038] text-base sm:text-lg font-medium hidden md:inline">{item.note}</span>
            </div>
            <div class="flex flex-wrap gap-x-3 sm:gap-x-4 gap-y-0.5 sm:gap-y-1 text-[10px] sm:text-xs text-[#1b3e2a] font-medium pl-5 sm:pl-7 md:pl-8">
              {item.sublinks.map(([sublabel, subhref]) => (
                <a href={subhref} class="hover:text-[#ba9038] hover:font-semibold transition-colors py-0.5">
                  {sublabel}
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>

      <!-- Photographic preview (hidden on mobile/tablet) -->
      <div class="hidden lg:block lg:col-span-5">
        <div class="bg-white rounded-3xl p-6 shadow-2xl shadow-[#122319]/10 border border-[#122319]/10 relative overflow-hidden">
          <div class="relative h-[420px] rounded-2xl overflow-hidden border border-[#122319]/15 shadow-inner bg-stone-900 group">
            <img
              id="menu-preview-img"
              src={withBase("/wp-content/uploads/2019/10/khao-sok-riverside-cottages-beach.jpg")}
              alt="Khao Sok Experience Preview"
              class="w-full h-full object-cover object-center transition-all duration-700 transform scale-100 group-hover:scale-105"
              width="600" height="450"
            />
            <!-- Clean, focused bottom scrim only behind text — 70%+ of photo is 100% unobstructed, zero grey zone -->
            <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/85 via-black/40 to-transparent pointer-events-none"></div>
            <div class="absolute bottom-6 left-6 right-6 z-10">
              <span id="menu-preview-badge" class="font-handwriting text-[#f7e6b5] text-2xl block mb-1 drop-shadow-[0_2px_6px_rgba(0,0,0,0.85)]">Authentic Rainforest Immersion</span>
              <h4 id="menu-preview-title" class="font-monumental text-2xl text-white mb-3 drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]">Khao Sok Riverside</h4>
              <a href="/booking-khao-sok-accommodation/" class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-[#f7e6b5] hover:text-white font-semibold font-mono drop-shadow">
                <span>Instant Reserve</span>
                <span>→</span>
              </a>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-[#122319]/10 flex items-center justify-between text-xs text-[#1b3e2a] font-mono font-semibold">
            <span>COORDINATES: 08°54'N 98°31'E</span>
            <span class="text-[#7a5813] font-bold">SURAT THANI · THAILAND</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Overlay Footer -->
    <div class="pt-4 sm:pt-6 border-t border-[#122319]/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 text-xs text-[#122319] font-medium">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 sm:gap-6">
        <a href="tel:+6677395159" class="hover:text-[#ba9038] transition-colors font-medium">📞 +66 77 395 159</a>
        <a href="mailto:info@khao-sok-riverside-cottages.com" class="hover:text-[#ba9038] transition-colors font-medium">✉️ info@khao-sok-riverside-cottages.com</a>
      </div>
      <div class="font-handwriting text-[#255038] text-lg sm:text-xl font-medium">
        "Where nature remains untouched."
      </div>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('menu-trigger');
  const homeBurger = document.getElementById('home-burger');
  const overlay = document.getElementById('menu-overlay');
  const close = document.getElementById('menu-close');
  const mainNav = document.getElementById('main-nav');
  const navBrand = document.getElementById('nav-brand');
  const navBookBtn = document.getElementById('nav-book-btn');
  const isHome = mainNav?.getAttribute('data-is-home') === 'true';
  const previewImg = document.getElementById('menu-preview-img') as HTMLImageElement;
  const previewTitle = document.getElementById('menu-preview-title');
  const previewBadge = document.getElementById('menu-preview-badge');

  function openMenu() {
    if (!overlay) return;
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!overlay) return;
    overlay.classList.add('opacity-0', 'pointer-events-none');
    overlay.classList.remove('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = '';
  }

  if (trigger) trigger.addEventListener('click', openMenu);
  if (homeBurger) homeBurger.addEventListener('click', openMenu);
  if (close) close.addEventListener('click', closeMenu);

  // Navbar scroll behavior
  if (mainNav) {
    const handleScroll = () => {
      const scrolled = window.scrollY > 40;
      if (scrolled) {
        mainNav.classList.remove('bg-transparent', 'border-transparent', 'bg-jungle-950/60', 'border-white/10', 'bg-gradient-to-b', 'from-black/60', 'via-black/20', 'to-transparent');
        mainNav.classList.add('nav-scrolled', 'nav-scrolled-light');
        if (navBrand && isHome) {
          navBrand.classList.remove('opacity-0', '-translate-x-4', 'pointer-events-none');
          navBrand.classList.add('opacity-100', 'translate-x-0');
        }
        if (navBookBtn && isHome) {
          navBookBtn.classList.remove('opacity-0', 'pointer-events-none', 'hidden');
          navBookBtn.classList.add('opacity-100', 'inline-flex');
        }
      } else {
        mainNav.classList.remove('nav-scrolled', 'nav-scrolled-light');
        if (isHome) {
          mainNav.classList.add('bg-transparent', 'border-transparent');
          if (navBrand) {
            navBrand.classList.add('opacity-0', '-translate-x-4', 'pointer-events-none');
            navBrand.classList.remove('opacity-100', 'translate-x-0');
          }
          if (navBookBtn) {
            navBookBtn.classList.add('opacity-0', 'pointer-events-none', 'hidden');
            navBookBtn.classList.remove('opacity-100', 'inline-flex');
          }
        } else {
          mainNav.classList.add('bg-gradient-to-b', 'from-black/60', 'via-black/20', 'to-transparent', 'border-transparent');
        }
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  const rawBase = import.meta.env.BASE_URL;
  const clientBase = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

  const items = document.querySelectorAll('.menu-item-group');
  items.forEach((item) => {
    item.addEventListener('mouseenter', () => {
      let img = item.getAttribute('data-preview-img');
      const title = item.getAttribute('data-preview-title');
      const note = item.getAttribute('data-preview-note');
      if (img && clientBase && img.startsWith('/') && !img.startsWith(clientBase)) {
        img = clientBase + img;
      }
      if (previewImg && img) previewImg.src = img;
      if (previewTitle && title) previewTitle.textContent = title;
      if (previewBadge && note) previewBadge.textContent = note;
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>

<style>
  /* ========================================================
     STATE 1: UNSCROLLED (Transparent over dark hero photo)
     Applies to both Home and Inner Pages when at top of page
  ======================================================== */
  :global(#main-nav:not(.nav-scrolled):not(.nav-scrolled-light)) .nav-brand-title {
    color: #ffffff !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85) !important;
  }
  :global(#main-nav:not(.nav-scrolled):not(.nav-scrolled-light)) .nav-brand-accent {
    color: #e5c158 !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85) !important;
  }
  :global(#main-nav:not(.nav-scrolled):not(.nav-scrolled-light)) #nav-brand:hover .nav-brand-title {
    color: #f7e6b5 !important;
  }

  /* Unscrolled Lang Switcher: Dark glass pill with solid luxury gold active chip */
  :global(#main-nav:not(.nav-scrolled):not(.nav-scrolled-light)) .lang-switch {
    background-color: rgba(0, 0, 0, 0.45) !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    color: #ffffff !important;
